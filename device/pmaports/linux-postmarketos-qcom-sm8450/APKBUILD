# Reference: <https://postmarketos.org/vendorkernel>
# Mainline SM8450 kernel (sm8450-mainline/linux) + this overlay's patches and config.
# The kernel/patches/*.patch and x700.config files are copied next to this APKBUILD by
# device/pmaports/install-to-pmaports.sh so the package builds from one directory.
maintainer="kubierend <degroe44@gmail.com>"
_flavor="postmarketos-qcom-sm8450"
pkgname=linux-$_flavor
pkgver=6.13_rc3
pkgrel=1
pkgdesc="Mainline kernel fork for Qualcomm SM8450 (Waipio) devices"
arch="aarch64"
_carch="arm64"
url="https://github.com/sm8450-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
"
makedepends="
	bison
	devicepkg-dev
	findutils
	flex
	installkernel
	linux-headers
	openssl-dev
	perl
	python3
"

# Pinned upstream commit. Re-validate on hardware before bumping.
_commit="bf1d29fced6e156dd6090a9b6600a8c44259c114"

source="
	$pkgname-$_commit.tar.gz::https://github.com/sm8450-mainline/linux/archive/$_commit.tar.gz
	x700.config
	$(cd "$startdir" && ls 0*.patch 2>/dev/null | tr '\n' ' ')
"
builddir="$srcdir/linux-$_commit"

prepare() {
	default_prepare  # applies every *.patch in $source

	# defconfig + sm8450.config (upstream), then the functional x700 fragment
	make ARCH="$_carch" defconfig sm8450.config
	KCONFIG_CONFIG=.config ./scripts/kconfig/merge_config.sh -m .config "$srcdir"/x700.config
	make ARCH="$_carch" olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-$_flavor" \
		Image.gz modules dtbs
}

package() {
	mkdir -p "$pkgdir"/boot

	install -Dm644 "$builddir/arch/$_carch/boot/Image.gz" "$pkgdir/boot/vmlinuz"

	make modules_install dtbs_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

sha512sums="SKIP"
