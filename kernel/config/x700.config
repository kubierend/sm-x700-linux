# Functional kernel options for the Galaxy Tab S8 (SM-X700, gts8wifi).
# Merge on top of the upstream defconfig + sm8450.config:
#   make ARCH=arm64 defconfig sm8450.config && scripts/kconfig/merge_config.sh -m .config x700.config
#
# Built in (=y), not modules, where probe order matters:
#  - remoteproc/QRTR/PD-mapper chain: the in-kernel pd-mapper has to answer
#    the ADSP's service locator before q6apm/q6prm probe; modular ordering
#    under udev is not guaranteed to satisfy that (audio + sensor DSP).
#  - I2C_GPIO/ALGOBIT: the S Pen digitizer sits on SE14, which is hard-wired
#    to broken GPI DMA, so it is driven as a bit-banged i2c-gpio bus.
CONFIG_DRM_PANEL_NOVATEK_NT36523=y
CONFIG_I2C_ALGOBIT=y
CONFIG_I2C_GPIO=y
# NT36523 touchscreen (a module, loaded after the panel is up, as tested).
CONFIG_TOUCHSCREEN_NOVATEK_NVT_TS=m
CONFIG_BATTERY_MAX17042=y
CONFIG_MAX77705_CHARGER_MONITOR=y
CONFIG_SM5440_CHARGER_MONITOR=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QCOM_PIL_INFO=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_SYSMON=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_SND_SOC_CS35L45=y
CONFIG_SND_SOC_CS35L45_I2C=y
# Sensor rail switch (regulator-output node "sensor-vdd").
CONFIG_REGULATOR_USERSPACE_CONSUMER=y
# USB-C SuperSpeed/DP redriver (the SBU mux is already in defconfig).
CONFIG_TYPEC_MUX_PS5169=y
# pmOS zram swap asks for zstd; defconfig only has the LZO backend.
CONFIG_ZRAM_BACKEND_ZSTD=y
