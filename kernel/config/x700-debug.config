# OPTIONAL bring-up/debug options. Not needed on a working device; enable when
# diagnosing hangs. Merge after x700.config.
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=5
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_DRM_PANIC=y
CONFIG_DRM_PANIC_SCREEN="kmsg"
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
