+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MAX77705_FLOAT_CONTROL_H
+#define MAX77705_FLOAT_CONTROL_H
+
+#include "gts8-thermal-policy.h"
+
+/* Samsung's CHG_CNFG_04 encoding is (mV - 4000) / 50 through 4200 mV.
+ * WARM's 4150 mV is therefore 0x03. Preserve a lower boot setting.
+ */
+#define MAX77705_WARM_FLOAT_CODE 0x03
+#define MAX77705_WARM_RECHARGE_UV 4000000
+
+/* Returns whether charging may run. A missing or implausible gauge sample
+ * fails closed in WARM. The caller writes and verifies the target first.
+ */
+static inline int max77705_float_target(int boot_code, int zone, int vbat_uv,
+					int *target_code)
+{
+	*target_code = 0;
+	if (boot_code < 0 || boot_code > 0x13)
+		return 0;
+	*target_code = boot_code;
+	if (zone < GTS8_ZONE_WARM)
+		return 1;
+	if (*target_code > MAX77705_WARM_FLOAT_CODE)
+		*target_code = MAX77705_WARM_FLOAT_CODE;
+	if (zone != GTS8_ZONE_WARM)
+		return 1; /* Thermal policy already forbids charging above WARM. */
+	return vbat_uv >= 3000000 && vbat_uv <= MAX77705_WARM_RECHARGE_UV;
+}
+
+#endif
--- /dev/null
+++ b/drivers/power/supply/max77705-pd-protocol.h
@@ -0,0 +1,247 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Samsung MAX77705 PD mailbox data, shared by native and runtime tests.
+ * Transport serialization, response freshness, PS_RDY and actual VBUS must
+ * be checked by the caller. Source capabilities alone do not set board limits.
+ */
+#ifndef MAX77705_PD_PROTOCOL_H
+#define MAX77705_PD_PROTOCOL_H
+
+#define MAX77705_PD_CURRENT_SRCCAP 0x30
+#define MAX77705_PD_FIXED_REQUEST  0x32
+#define MAX77705_PD_PPS_REQUEST    0x3a
+#define MAX77705_PD_SET_PPS        0x3c
+
+struct max77705_pd_caps {
+	unsigned int count;
+	unsigned int selected;
+	unsigned int pdo[7];
+};
+
+static inline int max77705_pd_decode_caps(const unsigned char *data,
+		unsigned int length, struct max77705_pd_caps *caps)
+{
+	unsigned int count, selected, i, offset;
+	if (length < 2 || data[0] != MAX77705_PD_CURRENT_SRCCAP)
+		return 0;
+	count = data[1] & 7;
+	selected = (data[1] >> 3) & 7;
+	if (!count || !selected || selected > count || length < 2 + count * 4)
+		return 0;
+	for (i = 0; i < 7; i++) {
+		offset = 2 + i * 4;
+		caps->pdo[i] = i < count ?
+			(unsigned int)data[offset] | (unsigned int)data[offset + 1] << 8 |
+			(unsigned int)data[offset + 2] << 16 | (unsigned int)data[offset + 3] << 24 : 0;
+	}
+	caps->count = count;
+	caps->selected = selected;
+	return 1;
+}
+
+static inline int max77705_pd_fixed_5v(const struct max77705_pd_caps *caps,
+		unsigned int position)
+{
+	unsigned int pdo;
+	if (!position || position > caps->count)
+		return 0;
+	pdo = caps->pdo[position - 1];
+	return !(pdo >> 30) && ((pdo >> 10) & 0x3ff) * 50 == 5000 ?
+		(pdo & 0x3ff) * 10 : 0;
+}
+
+static inline int max77705_pd_encode_pps(const struct max77705_pd_caps *caps,
+		unsigned int position, unsigned int mv, unsigned int ma,
+		unsigned int board_mv, unsigned int board_ma, unsigned int board_mw,
+		unsigned char payload[4])
+{
+	unsigned int pdo, min_mv, max_mv, max_ma;
+	if (!position || position > caps->count || mv % 20 || ma % 50 || !ma)
+		return 0;
+	pdo = caps->pdo[position - 1];
+	/* SPR PPS APDO only; reject AVS and reserved augmented supply types. */
+	if (pdo >> 30 != 3 || ((pdo >> 28) & 3))
+		return 0;
+	min_mv = ((pdo >> 8) & 0xff) * 100;
+	max_mv = ((pdo >> 17) & 0xff) * 100;
+	max_ma = (pdo & 0x7f) * 50;
+	if (!min_mv || min_mv > max_mv || mv < min_mv || mv > max_mv ||
+	    ma > max_ma || mv > board_mv || ma > board_ma ||
+	    (unsigned long long)mv * ma > (unsigned long long)board_mw * 1000)
+		return 0;
+	payload[0] = position;
+	payload[1] = (mv / 20) & 0xff;
+	payload[2] = (mv / 20) >> 8;
+	payload[3] = ma / 50;
+	return 1;
+}
+/* Type-C/PD event registers, from Samsung's max77705.h. UIC_INT/CC_INT/PD_INT
+ * are read-clear and this driver is their only AP-side consumer, so it reads
+ * each of them exactly once per cycle and routes the result to both the
+ * mailbox completion check and the fault classifier below.
+ */
+#define MAX77705_REG_UIC_INT		0x02
+#define MAX77705_REG_CC_INT		0x03
+#define MAX77705_REG_PD_INT		0x04
+#define MAX77705_REG_USBC_STATUS1	0x06
+#define MAX77705_REG_USBC_STATUS2	0x07
+#define MAX77705_REG_BC_STATUS		0x08
+#define MAX77705_REG_CC_STATUS0		0x0a
+#define MAX77705_REG_CC_STATUS1		0x0b
+#define MAX77705_REG_PD_STATUS0		0x0c
+#define MAX77705_REG_PD_STATUS1		0x0d
+#define MAX77705_REG_OPCODE		0x21
+#define MAX77705_REG_OPCODE_END		0x41
+#define MAX77705_REG_OPCODE_RES		0x51
+
+#define MAX77705_UIC_APCMDRES		0x80
+#define MAX77705_UIC_SYSMSG		0x40
+#define MAX77705_PD_INT_PDMSG		0x80
+#define MAX77705_PD_STATUS1_PSRDY	0x10
+
+/* Classified outcomes. RENEGOTIATE means the cached source capabilities are no
+ * longer trustworthy; ERROR means any elevated request must be abandoned and
+ * the input returned to the conservative baseline.
+ */
+#define MAX77705_EVT_RENEGOTIATE	0x01
+#define MAX77705_EVT_ERROR		0x02
+#define MAX77705_EVT_HARD_RESET		0x04
+#define MAX77705_EVT_WATER		0x08
+#define MAX77705_EVT_CMD_FAIL		0x10
+#define MAX77705_EVT_PS_RDY		0x20
+#define MAX77705_EVT_REJECTED		0x40
+
+static inline unsigned int max77705_classify_sysmsg(unsigned char sysmsg)
+{
+	switch (sysmsg) {
+	case 0x00:			/* SYSERROR_NONE */
+	case 0x20:			/* SYSMsg_AFC_Done */
+	case 0x67:			/* SYSMSG_PD_SHORT_NONE */
+	case 0xb0: case 0xb1: case 0xb2:
+	case 0xb3: case 0xb4: case 0xb5:	/* RID transitions */
+		return 0;
+	case 0x03: case 0x04: case 0x05:	/* BOOT_WDT/SWRSTREQ/POR */
+		/* The USB-C firmware restarted: every cached contract is stale. */
+		return MAX77705_EVT_ERROR | MAX77705_EVT_RENEGOTIATE;
+	case 0x30: case 0x31: case 0x32: case 0x33:	/* SYSPOS, APCMD_* */
+		return MAX77705_EVT_CMD_FAIL;
+	case 0x80:			/* SYSERROR_POWER_NEGO */
+		return MAX77705_EVT_ERROR | MAX77705_EVT_RENEGOTIATE;
+	case 0x90: case 0x91:		/* CCRP high/low while water detected */
+		return MAX77705_EVT_ERROR | MAX77705_EVT_WATER;
+	default:
+		/* HV method errors0x10-0x15, CC/SBU shorts0x61-0x66/0x6a,
+		 * 5 V drops0x68/0x69 and factory RID0.
+		 */
+		return MAX77705_EVT_ERROR;
+	}
+}
+
+static inline unsigned int max77705_classify_pdmsg(unsigned char pdmsg)
+{
+	switch (pdmsg) {
+	case 0x01:			/* Sink_PD_PSRdy_received */
+		return MAX77705_EVT_PS_RDY;
+	case 0x0b:			/* SRC_CAP_RECEIVED */
+	case 0x22:			/* Current_Cable_Connected */
+		return MAX77705_EVT_RENEGOTIATE;
+	case 0x02:			/* Sink_PD_Error_Recovery */
+	case 0x20:			/* Sink_PD_Disabled */
+		return MAX77705_EVT_ERROR | MAX77705_EVT_RENEGOTIATE;
+	case 0x16: case 0x19:		/* hard reset received/sent */
+		return MAX77705_EVT_HARD_RESET | MAX77705_EVT_ERROR |
+			MAX77705_EVT_RENEGOTIATE;
+	case 0x03:			/* SenderResponseTimer timeout */
+		return MAX77705_EVT_CMD_FAIL;
+	case 0x12:			/* Reject received */
+		return MAX77705_EVT_REJECTED;
+	case 0x13:			/* Not_Supported received */
+		/* The source not implementing some message (the USB-C
+		 * firmware's own queries) leaves the contract untouched; it is
+		 * no refusal of our request. Logged by the caller.
+		 */
+		return 0;
+	case 0x0a:			/* message in illegal state */
+	case 0x18:			/* Get_Vbus_turn_off */
+		return MAX77705_EVT_ERROR;
+	default:
+		return 0;
+	}
+}
+
+/* cc_int is REG_CC_INT; cc_status is REG_CC_STATUS1 (0x0b), which carries
+ * CCSBUSHORT, VCONNOCP/SC, AttachSrcErr and the wet/dry ConnStat bit.
+ */
+static inline unsigned int max77705_classify_cc(unsigned char cc_int,
+						unsigned char cc_status)
+{
+	unsigned int events = 0;
+
+	if (cc_status & 0x02)		/* ConnStat == WATER */
+		events |= MAX77705_EVT_WATER | MAX77705_EVT_ERROR;
+	if (cc_status & 0xc0)		/* CC/SBU short to 5 V or GND */
+		events |= MAX77705_EVT_ERROR;
+	if (cc_status & 0x30)		/* VCONN over-current or short */
+		events |= MAX77705_EVT_ERROR;
+	if (cc_status & 0x04)		/* AttachSrcErr */
+		events |= MAX77705_EVT_ERROR;
+	if (cc_int & 0xb0)		/* VCONNOCPI, AttachSrcErrI, VCONNSCI */
+		events |= MAX77705_EVT_ERROR;
+	if (cc_int & 0x09)		/* CCStatI, CCPinStatI: attachment moved */
+		events |= MAX77705_EVT_RENEGOTIATE;
+	return events;
+}
+
+/* The APDO to request is not the currently selected object -- on X700 the
+ * source starts on fixed PDO1 and the PPS APDO sits at position6. Search the
+ * advertised objects for the first one that can serve this request within both
+ * the source's and the board's limits, and return its 1-based position.
+ */
+static inline unsigned int max77705_pd_find_pps(const struct max77705_pd_caps *caps,
+		unsigned int mv, unsigned int ma, unsigned int board_mv,
+		unsigned int board_ma, unsigned int board_mw, unsigned char payload[4])
+{
+	unsigned int i;
+
+	for (i = 1; i <= caps->count; i++)
+		if (max77705_pd_encode_pps(caps, i, mv, ma, board_mv, board_ma,
+					   board_mw, payload))
+			return i;
+	return 0;
+}
+
+/* A fixed-PDO request carries one position byte; SET_PPS carries an enable
+ * flag plus the same 20 mV/50 mA encoding as APDO_REQUEST.
+ */
+static inline int max77705_pd_encode_fixed(const struct max77705_pd_caps *caps,
+		unsigned int position, unsigned char payload[1])
+{
+	if (!max77705_pd_fixed_5v(caps, position))
+		return 0;
+	payload[0] = position;
+	return 1;
+}
+
+/* Returns the payload length, or 0 if the arguments cannot be encoded.
+ * Disabling PPS is a single byte, matching Samsung's write_length of 1.
+ * Samsung always enables at its 5 V/1 A default and carries the real target
+ * only in the APDO request that follows, so callers should do the same.
+ */
+#define MAX77705_PPS_DEFAULT_MV 5000
+#define MAX77705_PPS_DEFAULT_MA 1000
+
+static inline int max77705_pd_encode_set_pps(int enable, unsigned int mv,
+		unsigned int ma, unsigned char payload[4])
+{
+	if (!enable) {
+		payload[0] = 0;
+		return 1;
+	}
+	if (mv % 20 || ma % 50 || !ma)
+		return 0;
+	payload[0] = 1;
+	payload[1] = (mv / 20) & 0xff;
+	payload[2] = (mv / 20) >> 8;
+	payload[3] = (ma / 50) & 0x7f;
+	return 4;
+}
+#endif
--- /dev/null
+++ b/drivers/power/supply/sm5440-charger-monitor.c
@@ -0,0 +1,2135 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * X700 SM5440 direct-charger backend, based on Samsung/Silicon Mitus GPL source.
+ *
+ * Owns the chip's protection surface: fresh ADC with the fitted
+ * direct-charger NTC, polled ownership of the read-clear INT1..4 fault
+ * registers, Samsung's software IBUS OCP check (stock disables the hardware
+ * OCP and sets need_to_sw_ocp=1, so this is not optional), the charge
+ * watchdog, and a safe state that returns the chip to charge-off on any
+ * cut-off fault.
+ *
+ * It is also the direct-charge client of max77705_usb (see
+ * sm5440-direct-charge.h). Sessions start autonomously when a PPS source is
+ * attached (sm5440_dc_auto_poll()) or from the root-only direct_charge
+ * attribute; writing 0 to allow_pump stops both. Entry order:
+ * yield switching charging (lease) -> request a bounded PPS point -> verify
+ * VBUS on this chip's ADC -> program and enable the pump. Exit order: pump
+ * off -> watchdog off -> input at 500 mA -> fixed 5 V confirmed -> release.
+ * Reverse/OTG modes are never overridden.
+ */
+#include <linux/delay.h>
+#include <linux/devm-helpers.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/power_supply.h>
+#include <linux/workqueue.h>
+#include "gts8-charging-ntc.h"
+#include "sm5440-direct-charge.h"
+#include "sm5440-protection.h"
+
+#define SM5440_STATUS1 0x08
+#define SM5440_STATUS2 0x09
+#define SM5440_STATUS3 0x0a
+#define SM5440_CNTL1 0x0c
+#define SM5440_CNTL2 0x0d
+#define SM5440_CNTL3 0x0e
+#define SM5440_CNTL4 0x0f
+#define SM5440_CNTL5 0x10
+#define SM5440_CNTL6 0x11
+#define SM5440_CNTL7 0x12
+#define SM5440_VBUSCNTL 0x13
+#define SM5440_VBATCNTL 0x14
+#define SM5440_VOUTCNTL 0x15
+#define SM5440_IBUSCNTL 0x16
+#define SM5440_PRTNCNTL 0x19
+#define SM5440_THEMCNTL1 0x1a
+#define SM5440_ADCCNTL1 0x1c
+#define SM5440_ADCCNTL2 0x1d
+#define SM5440_DEVICEID 0x2b
+#define SM5440_POLL_MS 2000
+
+#ifndef SM5440_DRIVER_NAME
+#define SM5440_DRIVER_NAME "sm5440-monitor"
+#endif
+#define SM5440_OCP_POLL_MS 1000
+
+enum sm5440_dc_state {
+	SM5440_DC_OFF,
+	SM5440_DC_YIELD,	/* lease requested; then the PPS request */
+	SM5440_DC_REQUEST,	/* waiting for the settled contract */
+	SM5440_DC_VERIFY,	/* VBUS on our ADC, pump still off */
+	SM5440_DC_HOLD,		/* probe only: elevated VBUS, pump off */
+	SM5440_DC_ENABLE,	/* pump enabled, waiting for it to draw */
+	SM5440_DC_RUN,		/* PRE_CC / CC / CV */
+	SM5440_DC_TEARDOWN,
+};
+
+struct sm5440_dc {
+	int state;
+	int phase;
+	int td_step;
+	int reason;
+	int last_reason;
+	bool probe;
+	bool elevated;
+	bool fixed_sent;
+	bool pumping;
+	bool leased;
+	bool latched;
+	bool stopped;
+	bool abandoned;
+	int wdt_test;		/* 0 idle, 1 running, 2 passed, -1 failed */
+	struct sm5440_dc_limits limits;
+	struct sm5440_dc_goal goal;
+	struct sm5440_dc_ta ta;
+	struct sm5440_dc_ta sent;
+	struct sm5440_dc_ramp ramp;
+	struct sm5440_dc_sample s;
+	struct sm5440_dc_thermal thermal;
+	int requested_ci_ma;
+	int pending_ci_ma;
+	struct sm5440_dc_ta pending_ta;
+	unsigned long pending_deadline;
+	unsigned int hold_ms;
+	unsigned long started;
+	unsigned long deadline;
+	unsigned long step_deadline;
+	unsigned long next_adjust;
+	unsigned long wdt_test_until;
+	unsigned long pumpoff_deadline;
+	struct sm5440_dc_sample prev;
+	unsigned int uvlo;
+	int vbus_min_mv;
+	int vbus_max_mv;
+	int ibus_max_ma;
+	int ntc_max;
+	int die_max;
+	int gauge_mv;
+	int gauge_ua;
+	unsigned int sessions;
+	unsigned int failures;
+	unsigned long auto_next_try;
+	int auto_last_ret;
+	struct power_supply *usb;
+	struct power_supply *gauge;
+	struct device_link *link;
+};
+
+struct sm5440_monitor {
+	struct i2c_client *client;
+	struct power_supply *supply;
+	struct delayed_work poll;
+	struct mutex lock;
+	int vbus_mv;
+	int vbat_mv;
+	int ibus_ma;
+	int ntc_mc;
+	int die_mc;
+	bool valid;
+	unsigned int latched;
+	unsigned int observed;
+	unsigned int live;
+	int ocp_strikes;
+	unsigned int op_mode;
+	bool wdt_armed;
+	bool charging;
+	bool drained;
+	unsigned char wdt_timer;
+	unsigned int events_now;
+	unsigned long adc_fresh_at;
+	struct sm5440_dc dc;
+};
+
+static int sm5440_update_bits(struct i2c_client *client, u8 reg, u8 mask, u8 value)
+{
+	int old, ret;
+
+	old = i2c_smbus_read_byte_data(client, reg);
+	if (old < 0)
+		return old;
+	value = (old & ~mask) | (value & mask);
+	if (old == value)
+		return 0;
+	ret = i2c_smbus_write_byte_data(client, reg, value);
+	if (ret < 0)
+		return ret;
+	ret = i2c_smbus_read_byte_data(client, reg);
+	return ret < 0 ? ret : ret == value ? 0 : -EIO;
+}
+
+/* CNTL1 bit0 is SW RESET. sm5440_cntl1_wdt() keeps it clear; assert that here
+ * too so no future edit can reset the chip through the watchdog path.
+ */
+static int sm5440_wdt_set(struct sm5440_monitor *monitor, bool enable,
+			  unsigned char timer)
+{
+	int old, ret;
+	u8 value;
+
+	old = i2c_smbus_read_byte_data(monitor->client, SM5440_CNTL1);
+	if (old < 0)
+		return old;
+	value = sm5440_cntl1_wdt(old, enable, timer);
+	if (WARN_ON(value & 1))
+		return -EINVAL;
+	ret = sm5440_update_bits(monitor->client, SM5440_CNTL1, 0xf1, value & 0xf0);
+	if (ret)
+		return ret;
+	monitor->wdt_armed = enable;
+	monitor->wdt_timer = timer;
+	return 0;
+}
+
+/* The SM5440 has no separate watchdog kick register and Samsung's driver never
+ * writes one: its state machine simply keeps touching the chip inside the
+ * timeout. Re-writing the enable bit is the explicit form of that same I2C
+ * activity. Whether activity alone or this write is what reloads the timer is
+ * verified on-device by the expiry test, not assumed.
+ */
+static int sm5440_wdt_kick(struct sm5440_monitor *monitor)
+{
+	int old;
+
+	if (!monitor->wdt_armed)
+		return 0;
+	old = i2c_smbus_read_byte_data(monitor->client, SM5440_CNTL1);
+	if (old < 0)
+		return old;
+	return i2c_smbus_write_byte_data(monitor->client, SM5440_CNTL1,
+			sm5440_cntl1_wdt(old, true, monitor->wdt_timer));
+}
+
+/* Force the charge pump off and disarm the watchdog. Only CHG_ON is ever
+ * overridden: a reverse-bypass/reverse-boost session belongs to OTG, and
+ * cutting it here would drop power to an attached device.
+ */
+static int sm5440_safe_state(struct sm5440_monitor *monitor, const char *reason)
+{
+	int cntl5, ret;
+
+	cntl5 = i2c_smbus_read_byte_data(monitor->client, SM5440_CNTL5);
+	if (cntl5 < 0)
+		return cntl5;
+	if (sm5440_op_mode(cntl5) != SM5440_OP_MODE_CHG_ON) {
+		if (monitor->wdt_armed)
+			sm5440_wdt_set(monitor, false, monitor->wdt_timer);
+		return 0;
+	}
+	dev_err(&monitor->client->dev, "forcing charge pump off: %s\n", reason);
+	ret = sm5440_update_bits(monitor->client, SM5440_CNTL5, 0x0c,
+				 SM5440_OP_MODE_CHG_OFF << 2);
+	if (ret)
+		dev_err(&monitor->client->dev, "charge-off write failed: %d\n", ret);
+	else
+		monitor->op_mode = SM5440_OP_MODE_CHG_OFF;
+	if (monitor->wdt_armed)
+		sm5440_wdt_set(monitor, false, monitor->wdt_timer);
+	return ret;
+}
+
+static int sm5440_adc_pair(struct i2c_client *client, u8 reg)
+{
+	u8 data[2];
+	int ret = i2c_smbus_read_i2c_block_data(client, reg, sizeof(data), data);
+
+	if (ret != sizeof(data))
+		return ret < 0 ? ret : -EIO;
+	return (data[0] << 5) | (data[1] >> 3);
+}
+
+static int sm5440_adc_sample(struct sm5440_monitor *monitor)
+{
+	struct i2c_client *client = monitor->client;
+	int mode, saved, vbus, vbat, ibus, ntc, die, temp, ret, restore;
+
+	mode = i2c_smbus_read_byte_data(client, SM5440_CNTL5);
+	if (mode < 0)
+		return mode;
+	if (mode & 0x0c)
+		return -EPERM;
+	saved = i2c_smbus_read_byte_data(client, SM5440_ADCCNTL1);
+	if (saved < 0)
+		return saved;
+	ret = i2c_smbus_write_byte_data(client, SM5440_ADCCNTL1, saved & ~1);
+	if (ret)
+		goto restore_adc;
+	msleep(20);
+	ret = i2c_smbus_write_byte_data(client, SM5440_ADCCNTL1, (saved & ~3) | 1);
+	if (ret)
+		goto restore_adc;
+	/* Stock one-shot retrigger period200 ms. Live off-mode conversions were
+	 * validated at180 ms. Read pairs together so a byte pair cannot tear.
+	 */
+	msleep(180);
+	vbus = sm5440_adc_pair(client, 0x1e);
+	vbat = sm5440_adc_pair(client, 0x27);
+	ibus = sm5440_adc_pair(client, 0x22);
+	ntc = sm5440_adc_pair(client, 0x24);
+	die = i2c_smbus_read_byte_data(client, 0x26);
+	mode = i2c_smbus_read_byte_data(client, SM5440_CNTL5);
+	if (vbus < 0 || vbat < 0 || ibus < 0 || ntc < 0 || die < 0 || mode < 0) {
+		ret = -EIO;
+		goto restore_adc;
+	}
+	if (mode & 0x0c) {
+		ret = -EPERM;
+		goto restore_adc;
+	}
+	if (!gts8_ntc_temperature_uv(gts8_direct_ntc, ARRAY_SIZE(gts8_direct_ntc),
+				     ntc / 4 * 1000, &temp) ||
+	    2048 + vbat / 2 < 3000 || 2048 + vbat / 2 > 4500) {
+		ret = -ERANGE;
+		goto restore_adc;
+	}
+	monitor->vbus_mv = 4096 + vbus;
+	monitor->vbat_mv = 2048 + vbat / 2;
+	monitor->ibus_ma = ibus * 625 / 1000;
+	monitor->ntc_mc = temp * 100;
+	monitor->die_mc = (225 + die * 5) * 100;
+	ret = 0;
+restore_adc:
+	restore = i2c_smbus_write_byte_data(client, SM5440_ADCCNTL1, saved);
+	if (!restore) {
+		restore = i2c_smbus_read_byte_data(client, SM5440_ADCCNTL1);
+		restore = restore < 0 ? restore : restore == saved ? 0 : -EIO;
+	}
+	return ret ? ret : restore;
+}
+
+/* INT1..4 are read-clear and, on X700, have no other consumer (the stock
+ * sm5440 node declares no irq-gpio). Read them together with the live
+ * STATUS1..4 mirror so a latched pulse and the current condition are decoded
+ * from the same instant.
+ */
+static int sm5440_fault_sample(struct sm5440_monitor *monitor)
+{
+	u8 events[4], status[4];
+	unsigned int latched, live, cut;
+	int ret, cntl5;
+
+	ret = i2c_smbus_read_i2c_block_data(monitor->client, 0x00, sizeof(events), events);
+	if (ret != sizeof(events))
+		return ret < 0 ? ret : -EIO;
+	ret = i2c_smbus_read_i2c_block_data(monitor->client, SM5440_STATUS1,
+					    sizeof(status), status);
+	if (ret != sizeof(status))
+		return ret < 0 ? ret : -EIO;
+	cntl5 = i2c_smbus_read_byte_data(monitor->client, SM5440_CNTL5);
+	if (cntl5 < 0)
+		return cntl5;
+	monitor->op_mode = sm5440_op_mode(cntl5);
+	latched = sm5440_filter_reverse(sm5440_decode_flags(events), monitor->op_mode);
+	live = sm5440_filter_reverse(sm5440_decode_flags(status), monitor->op_mode);
+
+	/* Samsung's software OCP: IBUSLIM alone is ordinary input-current
+	 * regulation, so only count a strike when the thermal shutdown alarm is
+	 * live with it, and require three consecutive samples.
+	 */
+	if (sm5440_sw_ocp_strike(status[1], status[2])) {
+		if (++monitor->ocp_strikes >= SM5440_SW_OCP_STRIKES) {
+			monitor->ocp_strikes = SM5440_SW_OCP_STRIKES;
+			latched |= SM5440_FAULT_IBUSOCP;
+			dev_err_ratelimited(&monitor->client->dev,
+					    "software IBUS OCP: STATUS2=0x%02x STATUS3=0x%02x\n",
+					    status[1], status[2]);
+		}
+	} else {
+		monitor->ocp_strikes = 0;
+	}
+
+	/* A detach clears the latch so a fresh attachment starts clean; while
+	 * VBUS is present a cut-off fault stays latched.
+	 */
+	if (live & SM5440_EVENT_VBUSUVLO || !(live & SM5440_EVENT_VBUSPOK))
+		monitor->latched = 0;
+	monitor->live = live;
+	/* INT1..4 accumulate from before this driver existed, so the first read
+	 * is a drain: report what the bootloader left behind, judge nothing.
+	 */
+	if (!monitor->drained) {
+		monitor->drained = true;
+		dev_info(&monitor->client->dev,
+			 "initial INT[%02x %02x %02x %02x] ST[%02x %02x %02x %02x] drained, flags 0x%08x\n",
+			 events[0], events[1], events[2], events[3],
+			 status[0], status[1], status[2], status[3], latched);
+		return 0;
+	}
+	/* observed is the full diagnostic history; latched holds only what is
+	 * actionable in the current mode, because that is what health reports.
+	 */
+	monitor->observed |= latched;
+	monitor->events_now = latched;
+	if (latched & SM5440_EVENT_ADCUPDATED)
+		monitor->adc_fresh_at = jiffies;
+	cut = sm5440_cutoff_faults(latched | live, monitor->charging, monitor->op_mode);
+	monitor->latched |= cut | (latched & SM5440_ALARM_ANY);
+	if (cut) {
+		dev_err(&monitor->client->dev,
+			"fault INT[%02x %02x %02x %02x] ST[%02x %02x %02x %02x] cut-off 0x%08x\n",
+			events[0], events[1], events[2], events[3],
+			status[0], status[1], status[2], status[3], cut);
+		sm5440_safe_state(monitor, "cut-off fault detected");
+	}
+	return 0;
+}
+
+static int sm5440_health(struct sm5440_monitor *monitor)
+{
+	unsigned int flags = monitor->latched |
+		sm5440_cutoff_faults(monitor->live, monitor->charging, monitor->op_mode);
+
+	if (flags & (SM5440_FAULT_VBATOVP | SM5440_FAULT_VOUTOVP | SM5440_FAULT_VBUSOVP))
+		return POWER_SUPPLY_HEALTH_OVERVOLTAGE;
+	if (flags & SM5440_FAULT_THEMSHDN ||
+	    (monitor->valid && monitor->die_mc >= 120000))
+		return POWER_SUPPLY_HEALTH_OVERHEAT;
+	if (flags & SM5440_FAULT_CUTOFF)
+		return POWER_SUPPLY_HEALTH_UNSPEC_FAILURE;
+	if (flags & SM5440_ALARM_THEMSHDN)
+		return POWER_SUPPLY_HEALTH_WARM;
+	return monitor->valid ? POWER_SUPPLY_HEALTH_GOOD : POWER_SUPPLY_HEALTH_UNKNOWN;
+}
+
+static enum power_supply_property sm5440_monitor_properties[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_HEALTH,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_TEMP,
+};
+
+static int sm5440_monitor_property(struct power_supply *supply,
+		enum power_supply_property prop, union power_supply_propval *val)
+{
+	struct sm5440_monitor *monitor = power_supply_get_drvdata(supply);
+	int ret = 0;
+
+	mutex_lock(&monitor->lock);
+	switch (prop) {
+	case POWER_SUPPLY_PROP_STATUS:
+		val->intval = monitor->op_mode == SM5440_OP_MODE_CHG_ON ?
+			POWER_SUPPLY_STATUS_CHARGING :
+			monitor->op_mode == SM5440_OP_MODE_CHG_OFF ?
+			POWER_SUPPLY_STATUS_NOT_CHARGING : POWER_SUPPLY_STATUS_UNKNOWN;
+		break;
+	case POWER_SUPPLY_PROP_ONLINE:
+		val->intval = !!(monitor->live & SM5440_EVENT_VBUSPOK) &&
+			!(monitor->live & (SM5440_FAULT_VBUSOVP | SM5440_EVENT_VBUSUVLO));
+		break;
+	case POWER_SUPPLY_PROP_HEALTH:
+		val->intval = sm5440_health(monitor);
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+	case POWER_SUPPLY_PROP_TEMP:
+		if (!monitor->valid) { ret = -ENODATA; break; }
+		val->intval = prop == POWER_SUPPLY_PROP_TEMP ? monitor->ntc_mc / 100 :
+			monitor->vbus_mv * 1000;
+		break;
+	default:
+		ret = -EINVAL;
+	}
+	mutex_unlock(&monitor->lock);
+	return ret;
+}
+
+static ssize_t adc_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct sm5440_monitor *monitor = dev_get_drvdata(dev);
+	int ret;
+
+	mutex_lock(&monitor->lock);
+	ret = monitor->valid ? sysfs_emit(buf,
+		"vbus=%d mV vbat=%d mV ibus=%d mA direct_ntc=%d mC die=%d mC (charge pump %s)\n",
+		monitor->vbus_mv, monitor->vbat_mv, monitor->ibus_ma,
+		monitor->ntc_mc, monitor->die_mc,
+		monitor->op_mode == SM5440_OP_MODE_CHG_ON ? "ON" : "OFF") : -ENODATA;
+	mutex_unlock(&monitor->lock);
+	return ret;
+}
+static DEVICE_ATTR_RO(adc);
+
+static ssize_t faults_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct sm5440_monitor *monitor = dev_get_drvdata(dev);
+	ssize_t ret;
+
+	mutex_lock(&monitor->lock);
+	ret = sysfs_emit(buf,
+		"latched=0x%08x live=0x%08x observed=0x%08x cutoff=%d ocp_strikes=%d op_mode=%u charging=%d watchdog=%s\n",
+		monitor->latched, monitor->live, monitor->observed,
+		!!(monitor->latched & SM5440_FAULT_CUTOFF),
+		monitor->ocp_strikes, monitor->op_mode, monitor->charging,
+		monitor->wdt_armed ? "armed" : "off");
+	mutex_unlock(&monitor->lock);
+	return ret;
+}
+static DEVICE_ATTR_RO(faults);
+
+/* Read-only dump of the control block (CNTL1..ADCCNTL2), for checking the
+ * register state before and after a pump-off probe. Reads only non-clearing
+ * registers.
+ */
+static ssize_t registers_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct sm5440_monitor *monitor = dev_get_drvdata(dev);
+	ssize_t length = 0;
+	int reg, value;
+
+	mutex_lock(&monitor->lock);
+	for (reg = SM5440_STATUS1; reg <= SM5440_ADCCNTL2; reg++) {
+		value = i2c_smbus_read_byte_data(monitor->client, reg);
+		length += sysfs_emit_at(buf, length, "%02x=%s%02x%s", reg,
+					value < 0 ? "E" : "", value < 0 ? 0 : value,
+					reg == SM5440_ADCCNTL2 ? "\n" : " ");
+	}
+	mutex_unlock(&monitor->lock);
+	return length;
+}
+static DEVICE_ATTR_RO(registers);
+
+#ifdef SM5440_MONITOR_SELFTEST
+/* Runtime-test build only. Arms the watchdog with the charge pump OFF, stops
+ * kicking it and reports whether WDTMROFF latches. Never compiled into the
+ * native driver.
+ */
+static ssize_t watchdog_selftest_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct sm5440_monitor *monitor = dev_get_drvdata(dev);
+	unsigned int timer;
+	u8 events[4];
+	int ret, cntl5, kicked = -1;
+
+	if (kstrtouint(buf, 0, &timer) || timer > SM5440_WDT_TIMER_4S)
+		return -EINVAL;
+	mutex_lock(&monitor->lock);
+	if (monitor->dc.state != SM5440_DC_OFF) {
+		ret = -EBUSY;
+		goto unlocked_out;
+	}
+	cancel_delayed_work(&monitor->poll);
+	cntl5 = i2c_smbus_read_byte_data(monitor->client, SM5440_CNTL5);
+	if (cntl5 < 0 || sm5440_op_mode(cntl5) != SM5440_OP_MODE_CHG_OFF) {
+		ret = cntl5 < 0 ? cntl5 : -EPERM;
+		goto out;
+	}
+	i2c_smbus_read_i2c_block_data(monitor->client, 0x00, sizeof(events), events);
+	ret = sm5440_wdt_set(monitor, true, timer);
+	if (ret)
+		goto out;
+	/* Kick through one full timeout, then stop and wait for expiry. */
+	for (ret = 0; ret < 4; ret++) {
+		msleep(sm5440_wdt_timer_ms(timer) / 4);
+		if (sm5440_wdt_kick(monitor))
+			break;
+	}
+	if (i2c_smbus_read_i2c_block_data(monitor->client, 0x00, sizeof(events), events) == 4)
+		kicked = !!(events[3] & SM5440_B4_WDTMROFF);
+	msleep(sm5440_wdt_timer_ms(timer) * 2);
+	ret = i2c_smbus_read_i2c_block_data(monitor->client, 0x00, sizeof(events), events);
+	cntl5 = i2c_smbus_read_byte_data(monitor->client, SM5440_CNTL5);
+	dev_info(dev, "watchdog selftest: timer=%ums expired_while_kicked=%d expired_after_stop=%d CNTL5=0x%02x\n",
+		 sm5440_wdt_timer_ms(timer), kicked,
+		 ret == 4 ? !!(events[3] & SM5440_B4_WDTMROFF) : -1, cntl5);
+	ret = sm5440_wdt_set(monitor, false, SM5440_WDT_TIMER_30S);
+out:
+	monitor->latched = 0;
+	monitor->ocp_strikes = 0;
+	schedule_delayed_work(&monitor->poll, 0);
+unlocked_out:
+	mutex_unlock(&monitor->lock);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_WO(watchdog_selftest);
+#endif
+
+/* ------------------------------------------------------------------------
+ * Direct-charge client.
+ *
+ * Everything below runs with monitor->lock held. It talks to the MAX77705
+ * only through max77705_usb's properties and never touches its I2C; the
+ * MAX77705 driver never calls back into this one, so there is no lock
+ * ordering between the two.
+ */
+
+/* Permits the charge pump at all. Every entry gate in sm5440_dc_entry_check()
+ * (latched faults, thermal policy, VBAT window, NTC/die) still applies;
+ * writing 0 stops new autonomous attempts and ends a running session
+ * (sm5440_dc_advance()'s STOP_USER path). See sm5440_dc_auto_poll().
+ */
+static bool allow_pump = true;
+module_param(allow_pump, bool, 0644);
+MODULE_PARM_DESC(allow_pump, "permit the SM5440 charge pump to run, manually or autonomously (default on; write 0 to disable)");
+
+/* Second key for power: the pump input current a session may use. The
+ * ceiling is compile-time; raising it is a code change, not a knob.
+ *
+ * 4500 mA is stock's own limit: the Android DT sets
+ * max_charging_charge_power = 45000 mW, and 4500 mA pump share plus the
+ * 500 mA buck allowance is a 5 A PD request. Paired with
+ * MAX77705_DC_PPS_MAX_MA in max77705-charger-monitor.c; raising one without
+ * the other gets every step refused ("pd request refused").
+ *
+ * There is no e-marker/cable check (Samsung's downstream charging path has
+ * none either). Per USB-PD the source does not advertise a 5 A APDO unless
+ * the attached cable carries 5 A, so the request is bounded by what the
+ * source offers. Measured on hardware: 2000 and 3000 mA sessions plateau at
+ * 39-42 C NTC / 42-47 C die (hard stops 50/90 C), and the CV taper plus the
+ * graduated thermal reduction bring the current down on their own above
+ * ~50% SOC. Not every charger/cable pair reaches the full 45 W.
+ */
+#define SM5440_DC_PUMP_MAX_MA	4500
+static unsigned int max_pump_ma = 4500;
+module_param(max_pump_ma, uint, 0644);
+MODULE_PARM_DESC(max_pump_ma, "highest pump input current 'start' may request, 1000..4500 mA (default 4500)");
+
+/* Hard session deadline. Autonomous sessions re-validate every entry
+ * condition at this boundary and then start again, so a short value only
+ * adds a drop to fixed 5 V and a PD renegotiation every few minutes.
+ */
+static unsigned int session_max_s = 900;
+module_param(session_max_s, uint, 0644);
+MODULE_PARM_DESC(session_max_s, "hard direct-charge session deadline in seconds, 10..900 (default 900)");
+
+/* Test-only: proves the graduated reduction/recovery path (thermal.level,
+ * the 250 mA/band steps, the 15 s + hysteresis release, the 50 mA/5 s ramp)
+ * actually fires on real hardware, without needing to run the pump hot
+ * enough to reach 43 C for real. Only ADDS to the live dc->s sample used by
+ * the thermal step and by the hard NTC/die guard, so it can only make both
+ * MORE conservative than reality, never mask real heat. Clamped to a sane
+ * range so a typo can't do anything worse than trip the existing hard stop
+ * early, which already tears down safely. Real entry gating (before a
+ * session starts) and the temperature sysfs files are a separate sample and
+ * are never touched by this.
+ */
+static int dc_thermal_test_bump_ds;
+module_param(dc_thermal_test_bump_ds, int, 0644);
+MODULE_PARM_DESC(dc_thermal_test_bump_ds, "test-only: 0.1C added to the live NTC/die sample before the thermal policy runs (default 0, no effect)");
+
+/* Watchdog while pumping: well inside the MAX77705's 5 s lease, so a stalled
+ * client loses its pump before the lease expiry returns the source to 5 V.
+ * Kicked at least every 500 ms.
+ */
+#define SM5440_DC_WDT_TIMER		SM5440_WDT_TIMER_2S
+#define SM5440_DC_CHGIN_MA		500
+#define SM5440_DC_STEP_MS		3000
+#define SM5440_DC_REQUEST_MS		5000
+#define SM5440_DC_VERIFY_MS		3000
+#define SM5440_DC_FIXED_MS		8000
+#define SM5440_DC_ENABLE_MS		1000
+#define SM5440_DC_ADC_STALE_MS		3000
+/* Pump-off not confirmed in this time: the 2 s watchdog (armed, no longer
+ * kicked) has had two periods to cut it, so stop renewing the lease and let
+ * the MAX77705 expiry return the source.
+ */
+#define SM5440_DC_PUMPOFF_LEASE_MS	5000
+#define SM5440_DC_UVLO_MAX		4
+#define SM5440_DC_SYNC_LOOPS		200
+#define SM5440_DC_SKIP			(-1)
+/* The IBUS ADC reads about 76 mA with the pump off, so "the
+ * pump is drawing" needs a clear margin above that.
+ */
+#define SM5440_DC_ENABLE_MIN_MA		300
+/* Conditions that must be clear before a session: REVBLK is steady state on
+ * idle X700 hardware and watchdog/start-up bits are history, not faults.
+ */
+#define SM5440_DC_ENTRY_FAULTS (SM5440_FAULT_VBATOVP | SM5440_FAULT_VOUTOVP | \
+	SM5440_FAULT_VBUSOVP | SM5440_FAULT_THEMSHDN | SM5440_FAULT_CFLY_SHORT | \
+	SM5440_FAULT_IBUSOCP)
+
+/* The session envelope. ta_max_ma and p_max are set per session from the
+ * requested pump current (1000 mA is stock's ta_min_current, where the ramp
+ * works in voltage only). 10 V board cap, mid-SOC battery, conservative
+ * temperatures. See docs/CHARGING.md before changing any value.
+ */
+static const struct sm5440_dc_limits sm5440_dc_pilot = {
+	.ta_min_mv = 8200,
+	/* 10 V like stock (X706N sm5440_charger.c get_apdo_max_power(),
+	 * ta->v_max = 10000; VBUS OVP stays 11 V). At 9 V the 2:1 pump has only
+	 * ~0.45 V over a 4.05 V battery and stalls near 2.5 A / 22 W; reaching
+	 * the 4.5 A goal needs ~2*vbat + 4.5 A * r_ttl = ~9.5 V. Paired with
+	 * MAX77705_DC_PPS_MAX_MV/_MW (10000 mV / 50000 mW) in the monitor.
+	 */
+	.ta_max_mv = 10000,
+	.ta_min_ma = 1000,
+	.ta_max_ma = 1000,
+	.p_max = 9000LL * 1000,
+	.vbus_ovp_mv = 11000,
+	.r_ttl_uohm = 290000,
+	.vbat_floor_mv = 3300,
+	.vbat_entry_min_mv = 3600,
+	.vbat_entry_max_mv = 4100,
+	.vbat_gauge_tol_mv = 200,
+	.ntc_entry_max = 420,
+	.ntc_trip = 500,
+	.die_entry_max = 600,
+	.die_trip = 900,
+	.vbus_overshoot_mv = 250,
+	.ibus_trip_margin_ma = 200,
+	.topoff_ma = 500,
+	.topoff_count = 3,
+	.step_budget = 120,
+	.stall_count = 10,
+};
+
+static const char * const sm5440_dc_state_names[] = {
+	"off", "yield", "request", "verify", "hold", "enable", "run", "teardown",
+};
+static const char * const sm5440_dc_phase_names[] = {
+	"pre_cc", "cc", "cv", "done", "fail",
+};
+static const char * const sm5440_dc_td_names[] = {
+	"pump_off", "wdt_off", "input_base", "fixed_request", "fixed_verify",
+	"release", "done", "abandon",
+};
+
+static int sm5440_write_verify(struct sm5440_monitor *monitor, u8 reg, u8 value)
+{
+	int ret = i2c_smbus_write_byte_data(monitor->client, reg, value);
+
+	if (ret < 0)
+		return ret;
+	ret = i2c_smbus_read_byte_data(monitor->client, reg);
+	if (ret < 0)
+		return ret;
+	if (ret != value) {
+		dev_err(&monitor->client->dev, "reg 0x%02x reads 0x%02x after writing 0x%02x\n",
+			reg, ret, value);
+		return -EIO;
+	}
+	return 0;
+}
+
+/* sm5440_start_charging's SW reset plus sm5440_init_reg_param, each write
+ * verified. Only from CHG_OFF: a reverse/OTG session is never reset.
+ */
+static int sm5440_dc_init_chip(struct sm5440_monitor *monitor)
+{
+	static const struct { u8 reg, mask, value; } init[] = {
+		{ SM5440_CNTL2, 0xff, 0xf2 },	 /* HW IBUSOCP/IBATOCP/THEM off; software OCP owns it */
+		{ SM5440_CNTL4, 0xff, 0xff },	 /* 8 ms debounce */
+		{ SM5440_CNTL6, 0xff, 0x09 },	 /* forced PWM, ENHIZ off */
+		{ SM5440_VBUSCNTL, 0x07, 0x07 }, /* VBUS OVP 11 V */
+		{ SM5440_VOUTCNTL, 0xff, 0x3f },
+		{ SM5440_PRTNCNTL, 0xff, 0xfe },
+		{ SM5440_ADCCNTL1, 0x08, 0x08 }, /* 32-sample average */
+		{ SM5440_ADCCNTL2, 0xff, 0xdf },
+		{ SM5440_THEMCNTL1, 0xff, 0x0c }, /* 120 C thermal regulation */
+		{ SM5440_CNTL3, 0xff, 0xb8 },	 /* charge timer off, VBATREG on */
+	};
+	struct i2c_client *client = monitor->client;
+	int ret, i;
+
+	ret = i2c_smbus_read_byte_data(client, SM5440_CNTL5);
+	if (ret < 0)
+		return ret;
+	if (sm5440_op_mode(ret) != SM5440_OP_MODE_CHG_OFF)
+		return -EPERM;
+	ret = i2c_smbus_write_byte_data(client, SM5440_CNTL1, 0x01);
+	if (ret < 0)
+		return ret;
+	for (i = 0; i < 255; i++) {
+		usleep_range(1000, 2000);
+		ret = i2c_smbus_read_byte_data(client, SM5440_CNTL1);
+		if (ret >= 0 && !(ret & 0x01))
+			break;
+	}
+	if (i == 255)
+		return ret < 0 ? ret : -EBUSY;
+	monitor->wdt_armed = !!(ret & 0x80);
+	monitor->wdt_timer = (ret >> 4) & 7;
+	ret = sm5440_wdt_set(monitor, false, SM5440_DC_WDT_TIMER);
+	if (ret)
+		return ret;
+	ret = sm5440_update_bits(client, SM5440_CNTL7, 0x1f,
+				 sm5440_dc_cntl7(sm5440_dc_freq_khz(monitor->dc.goal.ci_ma)));
+	for (i = 0; !ret && i < ARRAY_SIZE(init); i++)
+		ret = init[i].mask == 0xff ?
+			sm5440_write_verify(monitor, init[i].reg, init[i].value) :
+			sm5440_update_bits(client, init[i].reg, init[i].mask, init[i].value);
+	if (ret)
+		return ret;
+	/* Stock's ENHIZ rule for charge-off with VBUS present. */
+	return sm5440_update_bits(client, SM5440_CNTL6, 0x80, 0x80);
+}
+
+/* sm5440_dc_set_charging_config: programmed before the enable, never after. */
+static int sm5440_dc_program(struct sm5440_monitor *monitor)
+{
+	const struct sm5440_dc_goal *goal = &monitor->dc.goal;
+	int ret;
+
+	ret = sm5440_write_verify(monitor, SM5440_IBUSCNTL, sm5440_dc_ibuscntl(goal->ci_ma));
+	if (!ret)
+		ret = sm5440_update_bits(monitor->client, SM5440_VBATCNTL, 0x3f,
+					 sm5440_dc_vbatcntl(goal->cv_mv));
+	if (!ret)
+		ret = sm5440_update_bits(monitor->client, SM5440_CNTL7, 0x1f,
+					 sm5440_dc_cntl7(sm5440_dc_freq_khz(goal->ci_ma)));
+	return ret;
+}
+
+/* Stock's UPDAT_BAT path also changes IBUSCNTL and CNTL7 with the pump on.
+ * Keep the floor at 1300 mA: the old 1000 mA startup setting allows 1600 mA.
+ */
+static int sm5440_dc_program_current(struct sm5440_monitor *monitor, int ci_ma)
+{
+	int ret = sm5440_write_verify(monitor, SM5440_IBUSCNTL, (ci_ma + 300) / 50);
+
+	if (!ret)
+		ret = sm5440_update_bits(monitor->client, SM5440_CNTL7, 0x1f,
+					 sm5440_dc_cntl7(sm5440_dc_freq_khz(ci_ma)));
+	return ret;
+}
+
+/* ADCCNTL1 bit0 enable, bit1 continuous. */
+static int sm5440_dc_adc_continuous(struct sm5440_monitor *monitor, bool enable)
+{
+	int ret = sm5440_update_bits(monitor->client, SM5440_ADCCNTL1, 0x01, 0);
+
+	if (ret || !enable)
+		return ret ? ret : sm5440_update_bits(monitor->client, SM5440_ADCCNTL1, 0x02, 0);
+	msleep(50);
+	ret = sm5440_update_bits(monitor->client, SM5440_ADCCNTL1, 0x02, 0x02);
+	return ret ? ret : sm5440_update_bits(monitor->client, SM5440_ADCCNTL1, 0x01, 0x01);
+}
+
+/* Watchdog first, so a client that dies between these writes still loses
+ * the pump; then ENHIZ clear and CHG_ON as in sm5440_set_charging_enable.
+ */
+static int sm5440_dc_pump_on(struct sm5440_monitor *monitor)
+{
+	int ret = sm5440_wdt_set(monitor, true, SM5440_DC_WDT_TIMER);
+
+	if (ret)
+		return ret;
+	monitor->dc.pumping = true;
+	monitor->charging = true;
+	ret = sm5440_update_bits(monitor->client, SM5440_CNTL6, 0x80, 0);
+	if (!ret)
+		ret = sm5440_update_bits(monitor->client, SM5440_CNTL5, 0x0c,
+					 SM5440_OP_MODE_CHG_ON << 2);
+	if (!ret)
+		ret = sm5440_dc_adc_continuous(monitor, true);
+	monitor->adc_fresh_at = jiffies;
+	return ret;
+}
+
+/* Returns 0 only when CNTL5 has been read back out of CHG_ON. */
+static int sm5440_dc_pump_off(struct sm5440_monitor *monitor, bool vbus)
+{
+	int cntl5 = i2c_smbus_read_byte_data(monitor->client, SM5440_CNTL5);
+
+	if (cntl5 < 0)
+		return cntl5;
+	/* Reverse modes belong to OTG and are never touched here. */
+	if (sm5440_op_mode(cntl5) >= SM5440_OP_MODE_REV_BYPASS)
+		return 0;
+	if (sm5440_op_mode(cntl5) == SM5440_OP_MODE_CHG_ON) {
+		i2c_smbus_write_byte_data(monitor->client, SM5440_CNTL5,
+					  (cntl5 & ~0x0c) | (SM5440_OP_MODE_CHG_OFF << 2));
+		cntl5 = i2c_smbus_read_byte_data(monitor->client, SM5440_CNTL5);
+		if (cntl5 < 0)
+			return cntl5;
+		if (sm5440_op_mode(cntl5) == SM5440_OP_MODE_CHG_ON)
+			return -EIO;
+	}
+	monitor->op_mode = sm5440_op_mode(cntl5);
+	sm5440_update_bits(monitor->client, SM5440_CNTL6, 0x80, vbus ? 0x80 : 0);
+	sm5440_dc_adc_continuous(monitor, false);
+	return 0;
+}
+
+/* Continuous-mode sample while the pump runs; no mode toggling. */
+static int sm5440_dc_adc_live(struct sm5440_monitor *monitor, struct sm5440_dc_sample *s)
+{
+	struct i2c_client *client = monitor->client;
+	int vbus, vout, ibus, ntc, die, vbat, status2, temp;
+
+	vbus = sm5440_adc_pair(client, 0x1e);
+	vout = sm5440_adc_pair(client, 0x20);
+	ibus = sm5440_adc_pair(client, 0x22);
+	ntc = sm5440_adc_pair(client, 0x24);
+	die = i2c_smbus_read_byte_data(client, 0x26);
+	vbat = sm5440_adc_pair(client, 0x27);
+	status2 = i2c_smbus_read_byte_data(client, SM5440_STATUS2);
+	if (vbus < 0 || vout < 0 || ibus < 0 || ntc < 0 || die < 0 || vbat < 0 || status2 < 0)
+		return -EIO;
+	if (!gts8_ntc_temperature_uv(gts8_direct_ntc, ARRAY_SIZE(gts8_direct_ntc),
+				     ntc / 4 * 1000, &temp))
+		return -ERANGE;
+	s->vbus_mv = 4096 + vbus;
+	s->vout_mv = 2048 + vout / 2;
+	s->vbat_mv = 2048 + vbat / 2;
+	s->ibus_ma = ibus * 625 / 1000;
+	s->ntc = temp;
+	s->die = 225 + die * 5;
+	s->loop = sm5440_dc_loop(status2);
+	if (s->vbat_mv < 3000 || s->vbat_mv > 4500 || s->vout_mv < 3000 || s->vout_mv > 4600)
+		return -ERANGE;
+	monitor->vbus_mv = s->vbus_mv;
+	monitor->vbat_mv = s->vbat_mv;
+	monitor->ibus_ma = s->ibus_ma;
+	monitor->ntc_mc = temp * 100;
+	monitor->die_mc = s->die * 100;
+	monitor->valid = true;
+	return 0;
+}
+
+static int sm5440_usb_get(struct sm5440_monitor *monitor, enum power_supply_property prop,
+			  int *value)
+{
+	union power_supply_propval val;
+	int ret;
+
+	if (!monitor->dc.usb)
+		return -ENODEV;
+	ret = power_supply_get_property(monitor->dc.usb, prop, &val);
+	if (!ret)
+		*value = val.intval;
+	return ret;
+}
+
+static int sm5440_usb_set(struct sm5440_monitor *monitor, enum power_supply_property prop,
+			  int value)
+{
+	union power_supply_propval val = { .intval = value };
+
+	if (!monitor->dc.usb)
+		return -ENODEV;
+	return power_supply_set_property(monitor->dc.usb, prop, &val);
+}
+
+static void sm5440_dc_gauge(struct sm5440_monitor *monitor)
+{
+	union power_supply_propval val;
+	struct sm5440_dc *dc = &monitor->dc;
+
+	dc->gauge_mv = 0;
+	if (!dc->gauge)
+		return;
+	if (!power_supply_get_property(dc->gauge, POWER_SUPPLY_PROP_VOLTAGE_NOW, &val))
+		dc->gauge_mv = val.intval / 1000;
+	if (!power_supply_get_property(dc->gauge, POWER_SUPPLY_PROP_CURRENT_NOW, &val))
+		dc->gauge_ua = val.intval;
+}
+
+/* Probe order does not matter: the MAX77705 supply is found when a session
+ * starts. The managed device link makes the driver core unbind, suspend and
+ * shut this driver down before the MAX77705 one, so the pump is always off
+ * before that driver returns the source to 5 V on its own way out.
+ */
+static int sm5440_dc_acquire(struct sm5440_monitor *monitor)
+{
+	struct sm5440_dc *dc = &monitor->dc;
+
+	struct power_supply *usb;
+
+	if (!dc->usb) {
+		usb = power_supply_get_by_name("max77705_usb");
+		if (!usb)
+			return -ENODEV;
+		/* No session without the ordering guarantee. The link goes
+		 * away with this driver's binding, and so does the reference.
+		 */
+		dc->link = device_link_add(&monitor->client->dev, usb->dev.parent,
+					   DL_FLAG_AUTOREMOVE_CONSUMER);
+		if (!dc->link) {
+			power_supply_put(usb);
+			return -EINVAL;
+		}
+		dc->usb = usb;
+	}
+	if (!dc->gauge) {
+		dc->gauge = power_supply_get_by_name("max170xx_battery");
+		if (!dc->gauge)
+			return -ENODEV;
+	}
+	return 0;
+}
+
+/* On X700 a fixed 5 V input sagging to 4.78 V under a 3 A charge reads
+ * VBUSUVLO live and VBUSPOK clear (measured with the pump idle), so
+ * those bits are pump-operating thresholds, not attach detection. Presence
+ * comes from this chip's last VBUS conversion; UVLO only matters while
+ * pumping (sm5440_dc_running_checks).
+ */
+static bool sm5440_vbus_present(const struct sm5440_monitor *monitor)
+{
+	if (monitor->valid)
+		return monitor->vbus_mv >= 4400;
+	return !!(monitor->live & SM5440_EVENT_VBUSPOK);
+}
+
+static void sm5440_dc_log(struct sm5440_monitor *monitor, const char *what)
+{
+	struct sm5440_dc *dc = &monitor->dc;
+
+	dev_info(&monitor->client->dev,
+		 "dc %s: state=%s phase=%s ta=%d mV/%d mA vbus=%d ibus=%d vout=%d vbat=%d ntc=%d die=%d loop=%u gauge=%d mV %d uA\n",
+		 what, sm5440_dc_state_names[dc->state], sm5440_dc_phase_names[dc->phase],
+		 dc->ta.mv, dc->ta.ma, dc->s.vbus_mv, dc->s.ibus_ma, dc->s.vout_mv,
+		 dc->s.vbat_mv, dc->s.ntc, dc->s.die, dc->s.loop, dc->gauge_mv, dc->gauge_ua);
+}
+
+/* Start the ordered teardown. The first reason wins. */
+static void sm5440_dc_stop(struct sm5440_monitor *monitor, int reason)
+{
+	struct sm5440_dc *dc = &monitor->dc;
+
+	if (dc->state == SM5440_DC_OFF || dc->state == SM5440_DC_TEARDOWN)
+		return;
+	dc->reason = reason;
+	dc->state = SM5440_DC_TEARDOWN;
+	dc->td_step = SM5440_DC_TD_PUMP_OFF;
+	dc->step_deadline = jiffies + msecs_to_jiffies(SM5440_DC_STEP_MS);
+	dc->pumpoff_deadline = jiffies + msecs_to_jiffies(SM5440_DC_PUMPOFF_LEASE_MS);
+	if (sm5440_dc_is_error(reason) &&
+	    !(reason == SM5440_DC_ERR_WDT && dc->wdt_test == 2)) {
+		dc->latched = true;
+		dc->failures++;
+		dev_err(&monitor->client->dev, "direct charge stopping: %s\n",
+			sm5440_dc_reason_name(reason));
+	} else {
+		dev_info(&monitor->client->dev, "direct charge stopping: %s\n",
+			 sm5440_dc_reason_name(reason));
+	}
+	sm5440_dc_log(monitor, "stop");
+}
+
+/* One or more teardown steps; see sm5440_dc_td_next() for the ordering. */
+static void sm5440_dc_teardown_poll(struct sm5440_monitor *monitor)
+{
+	struct sm5440_dc *dc = &monitor->dc;
+	struct sm5440_dc_td_obs o;
+	int step, next, value, online = 1, loops;
+	bool vbus = sm5440_vbus_present(monitor);
+
+	for (loops = 0; loops < 8; loops++) {
+		step = dc->td_step;
+		o = (struct sm5440_dc_td_obs){
+			.input_ma = -1,
+			.vbus_mv = -1,
+			.elevated = dc->elevated,
+			.timed_out = time_after_eq(jiffies, dc->step_deadline),
+		};
+		/* Re-asserted on every pass, whatever the step. */
+		o.pump_off = !sm5440_dc_pump_off(monitor, vbus);
+		if (o.pump_off && dc->pumping) {
+			dc->pumping = false;
+			monitor->charging = false;
+		}
+		if (!o.pump_off && dc->leased &&
+		    time_after_eq(jiffies, dc->pumpoff_deadline)) {
+			dc->leased = false;
+			dev_err(&monitor->client->dev,
+				"pump-off not confirmed after %u ms; letting the lease expire\n",
+				SM5440_DC_PUMPOFF_LEASE_MS);
+		}
+		/* Gone means the MAX77705 reports no input and a fresh off-mode
+		 * conversion agrees (or cannot run without VBUS). The last
+		 * pumping sample is stale here: a cable pull at 7.9 V left it
+		 * reading 7878 mV and the teardown abandoned (2026-09-16).
+		 */
+		if (o.pump_off && !sm5440_usb_get(monitor, POWER_SUPPLY_PROP_ONLINE, &online) &&
+		    !online)
+			o.source_gone = sm5440_adc_sample(monitor) ||
+				monitor->vbus_mv < 4400;
+		switch (sm5440_dc_td_may_act(step, &o) ? step : -1) {
+		case SM5440_DC_TD_WDT_OFF:
+			if (monitor->wdt_armed)
+				sm5440_wdt_set(monitor, false, monitor->wdt_timer);
+			value = i2c_smbus_read_byte_data(monitor->client, SM5440_CNTL1);
+			o.wdt_off = value >= 0 && !(value & 0x80);
+			break;
+		case SM5440_DC_TD_INPUT_BASE:
+			if (!sm5440_usb_get(monitor, POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT, &value))
+				o.input_ma = value / 1000;
+			break;
+		case SM5440_DC_TD_FIXED_REQUEST:
+			if (!dc->fixed_sent &&
+			    !sm5440_usb_set(monitor, POWER_SUPPLY_PROP_VOLTAGE_NOW, 5000000))
+				dc->fixed_sent = true;
+			break;
+		case SM5440_DC_TD_FIXED_VERIFY:
+			o.contract_fixed = !sm5440_usb_get(monitor, POWER_SUPPLY_PROP_VOLTAGE_NOW,
+							   &value) && value == 5000000;
+			if (o.contract_fixed && !sm5440_adc_sample(monitor))
+				o.vbus_mv = monitor->vbus_mv;
+			break;
+		}
+		o.fixed_sent = dc->fixed_sent;
+		/* Hold the lease until it is released; the pump-off step does
+		 * not wait for it.
+		 */
+		if (dc->leased && step < SM5440_DC_TD_RELEASE &&
+		    sm5440_usb_set(monitor, POWER_SUPPLY_PROP_CHARGE_TYPE,
+				   POWER_SUPPLY_CHARGE_TYPE_NONE))
+			dc->leased = false;
+		next = sm5440_dc_td_next(step, &o);
+		if (next == step)
+			return;
+		dev_dbg(&monitor->client->dev, "dc teardown %s -> %s\n",
+			sm5440_dc_td_names[step], sm5440_dc_td_names[next]);
+		dc->td_step = next;
+		dc->step_deadline = jiffies + msecs_to_jiffies(next == SM5440_DC_TD_FIXED_VERIFY ?
+					SM5440_DC_FIXED_MS : SM5440_DC_STEP_MS);
+		switch (next) {
+		case SM5440_DC_TD_RELEASE:
+			sm5440_usb_set(monitor, POWER_SUPPLY_PROP_CHARGE_TYPE,
+				       POWER_SUPPLY_CHARGE_TYPE_STANDARD);
+			dc->leased = false;
+			break;
+		case SM5440_DC_TD_DONE:
+			dc->state = SM5440_DC_OFF;
+			pm_relax(&monitor->client->dev);
+			dc->last_reason = dc->reason;
+			dev_info(&monitor->client->dev,
+				 "direct charge ended (%s): vbus %d..%d mV, ibus max %d mA, ntc max %d, die max %d (0.1 C)\n",
+				 sm5440_dc_reason_name(dc->reason), dc->vbus_min_mv,
+				 dc->vbus_max_mv, dc->ibus_max_ma, dc->ntc_max, dc->die_max);
+			return;
+		case SM5440_DC_TD_ABANDON:
+			/* Pump confirmed off. Stop renewing: the MAX77705 lease
+			 * expiry returns the source and resumes charging.
+			 */
+			dc->leased = false;
+			dc->abandoned = true;
+			dc->latched = true;
+			dc->state = SM5440_DC_OFF;
+			pm_relax(&monitor->client->dev);
+			dc->last_reason = dc->reason;
+			dev_err(&monitor->client->dev,
+				"direct charge teardown abandoned after %s (%s); relying on lease expiry\n",
+				sm5440_dc_td_names[step], sm5440_dc_reason_name(dc->reason));
+			return;
+		}
+	}
+}
+
+/* Lease renewal plus read-back; any failure ends the session. */
+static int sm5440_dc_hold_lease(struct sm5440_monitor *monitor)
+{
+	int type;
+
+	if (!monitor->dc.leased)
+		return SM5440_DC_ERR_LEASE;
+	if (sm5440_usb_set(monitor, POWER_SUPPLY_PROP_CHARGE_TYPE, POWER_SUPPLY_CHARGE_TYPE_NONE) ||
+	    sm5440_usb_get(monitor, POWER_SUPPLY_PROP_CHARGE_TYPE, &type) ||
+	    type != POWER_SUPPLY_CHARGE_TYPE_NONE) {
+		monitor->dc.leased = false;
+		return SM5440_DC_ERR_LEASE;
+	}
+	return 0;
+}
+
+static int sm5440_dc_policy(struct sm5440_monitor *monitor)
+{
+	int online, health;
+
+	if (sm5440_usb_get(monitor, POWER_SUPPLY_PROP_ONLINE, &online) ||
+	    sm5440_usb_get(monitor, POWER_SUPPLY_PROP_HEALTH, &health))
+		return SM5440_DC_ERR_SOURCE;
+	if (!online)
+		return SM5440_DC_STOP_DISCONNECT;
+	return health == POWER_SUPPLY_HEALTH_GOOD ? 0 : SM5440_DC_ERR_THERMAL_POLICY;
+}
+
+/* Lease, source, thermal policy and the settled contract, in one check. */
+static int sm5440_dc_check_contract(struct sm5440_monitor *monitor, int want_mv)
+{
+	int ret, mv;
+
+	ret = sm5440_dc_hold_lease(monitor);
+	if (!ret)
+		ret = sm5440_dc_policy(monitor);
+	if (ret)
+		return ret;
+	if (sm5440_usb_get(monitor, POWER_SUPPLY_PROP_VOLTAGE_NOW, &mv))
+		return SM5440_DC_ERR_PD_CONTRACT;
+	return mv == want_mv * 1000 ? 0 : SM5440_DC_ERR_PD_CONTRACT;
+}
+
+static int sm5440_dc_request(struct sm5440_monitor *monitor, const struct sm5440_dc_ta *ta)
+{
+	struct sm5440_dc *dc = &monitor->dc;
+	int ret;
+
+	ret = sm5440_usb_set(monitor, POWER_SUPPLY_PROP_CURRENT_MAX,
+			     (ta->ma + SM5440_DC_CHGIN_MA) * 1000);
+	if (!ret)
+		ret = sm5440_usb_set(monitor, POWER_SUPPLY_PROP_VOLTAGE_NOW, ta->mv * 1000);
+	if (ret)
+		return ret;
+	dc->elevated = true;
+	dc->sent = *ta;
+	return 0;
+}
+
+static void sm5440_dc_track(struct sm5440_dc *dc, int vbus_mv)
+{
+	if (vbus_mv < dc->vbus_min_mv)
+		dc->vbus_min_mv = vbus_mv;
+	if (vbus_mv > dc->vbus_max_mv)
+		dc->vbus_max_mv = vbus_mv;
+	if (dc->s.ibus_ma > dc->ibus_max_ma)
+		dc->ibus_max_ma = dc->s.ibus_ma;
+	if (dc->s.ntc > dc->ntc_max)
+		dc->ntc_max = dc->s.ntc;
+	if (dc->s.die > dc->die_max)
+		dc->die_max = dc->s.die;
+}
+
+/* The chip dropped out of CHG_ON by itself: a pull, its watchdog or a fault. */
+static int sm5440_dc_chip_off_reason(struct sm5440_monitor *monitor)
+{
+	int online;
+
+	if (!sm5440_usb_get(monitor, POWER_SUPPLY_PROP_ONLINE, &online) && !online)
+		return SM5440_DC_STOP_DISCONNECT;
+	if ((monitor->events_now | monitor->latched) & SM5440_FAULT_WDT)
+		return SM5440_DC_ERR_WDT;
+	if ((monitor->events_now | monitor->live) & SM5440_EVENT_VBUSUVLO)
+		return SM5440_DC_ERR_UVLO;
+	if (monitor->latched & SM5440_FAULT_CUTOFF)
+		return SM5440_DC_ERR_CUTOFF;
+	return SM5440_DC_ERR_CHIP_OFF;
+}
+
+static void sm5440_dc_entry_poll(struct sm5440_monitor *monitor)
+{
+	struct sm5440_dc *dc = &monitor->dc;
+	bool timed_out = time_after_eq(jiffies, dc->step_deadline);
+	int ret, type, limit;
+
+	switch (dc->state) {
+	case SM5440_DC_YIELD:
+		if (!dc->leased) {
+			if (sm5440_usb_set(monitor, POWER_SUPPLY_PROP_CHARGE_TYPE,
+					   POWER_SUPPLY_CHARGE_TYPE_NONE)) {
+				if (timed_out)
+					sm5440_dc_stop(monitor, SM5440_DC_STOP_LEASE_BUSY);
+				return;
+			}
+			dc->leased = true;
+		}
+		if (sm5440_usb_get(monitor, POWER_SUPPLY_PROP_CHARGE_TYPE, &type) ||
+		    type != POWER_SUPPLY_CHARGE_TYPE_NONE ||
+		    sm5440_usb_get(monitor, POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT, &limit) ||
+		    limit > SM5440_DC_CHGIN_MA * 1000) {
+			sm5440_dc_stop(monitor, SM5440_DC_ERR_LEASE);
+			return;
+		}
+		if (!dc->probe) {
+			ret = sm5440_dc_preset(monitor->vbat_mv, &dc->goal, &dc->limits,
+					       &dc->ta, &dc->ramp);
+			if (ret) {
+				sm5440_dc_stop(monitor, ret);
+				return;
+			}
+		}
+		if (sm5440_dc_request(monitor, &dc->ta)) {
+			sm5440_dc_stop(monitor, SM5440_DC_ERR_PD_REQUEST);
+			return;
+		}
+		dev_info(&monitor->client->dev, "dc lease held, requested %d mV / %d mA (+%d mA buck)\n",
+			 dc->ta.mv, dc->ta.ma, SM5440_DC_CHGIN_MA);
+		dc->state = SM5440_DC_REQUEST;
+		dc->step_deadline = jiffies + msecs_to_jiffies(SM5440_DC_REQUEST_MS);
+		return;
+	case SM5440_DC_REQUEST:
+		ret = sm5440_dc_check_contract(monitor, dc->ta.mv);
+		if (ret == SM5440_DC_ERR_PD_CONTRACT && !timed_out)
+			return;
+		if (ret) {
+			sm5440_dc_stop(monitor, ret);
+			return;
+		}
+		dc->state = SM5440_DC_VERIFY;
+		dc->step_deadline = jiffies + msecs_to_jiffies(SM5440_DC_VERIFY_MS);
+		return;
+	case SM5440_DC_VERIFY:
+	case SM5440_DC_HOLD:
+		ret = sm5440_dc_check_contract(monitor, dc->ta.mv);
+		if (!ret && sm5440_adc_sample(monitor))
+			ret = SM5440_DC_ERR_ADC;
+		if (!ret && (monitor->latched & SM5440_FAULT_CUTOFF))
+			ret = SM5440_DC_ERR_CUTOFF;
+		if (ret) {
+			sm5440_dc_stop(monitor, ret);
+			return;
+		}
+		dc->s.vbus_mv = monitor->vbus_mv;
+		dc->s.vbat_mv = monitor->vbat_mv;
+		dc->s.ibus_ma = monitor->ibus_ma;
+		dc->s.ntc = monitor->ntc_mc / 100;
+		dc->s.die = monitor->die_mc / 100;
+		sm5440_dc_track(dc, monitor->vbus_mv);
+		/* A pump-off probe has no battery relation to check. */
+		ret = sm5440_dc_vbus_check(monitor->vbus_mv, dc->probe ? 0 : monitor->vbat_mv,
+					   dc->ta.mv, &dc->limits);
+		if (dc->state == SM5440_DC_HOLD) {
+			if (ret)
+				sm5440_dc_stop(monitor, ret);
+			else if (timed_out)
+				sm5440_dc_stop(monitor, SM5440_DC_STOP_PROBE_DONE);
+			return;
+		}
+		if (ret == SM5440_DC_ERR_VBUS_LOW && !timed_out)
+			return;
+		if (ret) {
+			sm5440_dc_stop(monitor, ret);
+			return;
+		}
+		sm5440_dc_log(monitor, "vbus verified");
+		if (dc->probe) {
+			dc->state = SM5440_DC_HOLD;
+			dc->step_deadline = jiffies + msecs_to_jiffies(dc->hold_ms);
+			return;
+		}
+		/* Last gate before energy moves. */
+		sm5440_dc_gauge(monitor);
+		if (!allow_pump) {
+			sm5440_dc_stop(monitor, SM5440_DC_STOP_USER);
+			return;
+		}
+		if (monitor->vbat_mv > dc->goal.cv_mv + 20 ||
+		    dc->gauge_mv > dc->goal.cv_mv + 20) {
+			sm5440_dc_stop(monitor, SM5440_DC_ERR_VBAT_ABOVE_TARGET);
+			return;
+		}
+		if (sm5440_dc_program(monitor)) {
+			sm5440_dc_stop(monitor, SM5440_DC_ERR_I2C);
+			return;
+		}
+		dc->state = SM5440_DC_ENABLE;
+		dc->step_deadline = jiffies + msecs_to_jiffies(SM5440_DC_ENABLE_MS);
+		ret = sm5440_dc_pump_on(monitor);
+		dev_info(&monitor->client->dev, "dc pump enable at %d mV: %d\n", dc->ta.mv, ret);
+		if (ret)
+			sm5440_dc_stop(monitor, SM5440_DC_ERR_ENABLE);
+		return;
+	}
+}
+
+/* Samples and guards shared by ENABLE and RUN. Returns 0 when the loop may
+ * act on dc->s this cycle, SM5440_DC_SKIP to wait a cycle, or a stop reason.
+ */
+static int sm5440_dc_running_checks(struct sm5440_monitor *monitor)
+{
+	struct sm5440_dc *dc = &monitor->dc;
+	int ret, mv;
+
+	if (monitor->op_mode != SM5440_OP_MODE_CHG_ON)
+		return sm5440_dc_chip_off_reason(monitor);
+	ret = sm5440_dc_hold_lease(monitor);
+	if (!ret)
+		ret = sm5440_dc_policy(monitor);
+	if (ret)
+		return ret;
+	if (sm5440_dc_adc_live(monitor, &dc->s))
+		return SM5440_DC_ERR_ADC;
+	if (dc_thermal_test_bump_ds) {
+		int bump = clamp(dc_thermal_test_bump_ds, 0, 200);
+
+		dc->s.ntc += bump;
+		dc->s.die += bump;
+	}
+	/* ADCUPDATED in INT4 or any movement in the converted values counts
+	 * as a fresh conversion; identical samples for 3 s do not.
+	 */
+	if (memcmp(&dc->s, &dc->prev, sizeof(dc->s)))
+		monitor->adc_fresh_at = jiffies;
+	dc->prev = dc->s;
+	if (time_after(jiffies, monitor->adc_fresh_at +
+		       msecs_to_jiffies(SM5440_DC_ADC_STALE_MS)))
+		return SM5440_DC_ERR_ADC;
+	sm5440_dc_track(dc, dc->s.vbus_mv);
+	ret = sm5440_dc_guard(&dc->s, &dc->goal, &dc->limits);
+	if (ret)
+		return ret;
+	sm5440_dc_gauge(monitor);
+	if (dc->gauge_mv > dc->goal.cv_mv + 50)
+		return SM5440_DC_ERR_VBAT_OVER;
+	/* A retarget keeps the contract settled, so 0 means the MAX77705 has
+	 * withdrawn it and started its grace period: stop now, the pump must
+	 * be off before that period ends. 5 V under a pump is worse.
+	 */
+	if (sm5440_usb_get(monitor, POWER_SUPPLY_PROP_VOLTAGE_NOW, &mv) || mv <= 5000000)
+		return SM5440_DC_ERR_PD_CONTRACT;
+	/* Stock's SM_DC_ERR_RETRY: UVLO while still on is waited out. */
+	if (monitor->live & SM5440_EVENT_VBUSUVLO) {
+		if (++dc->uvlo >= SM5440_DC_UVLO_MAX)
+			return SM5440_DC_ERR_UVLO;
+		return SM5440_DC_SKIP;
+	}
+	dc->uvlo = 0;
+	return 0;
+}
+
+/* A reduction constrains the pump before reducing the source request. For a
+ * recovery, the accepted source current is checked before raising the pump
+ * register. Any I2C or PD failure makes the caller stop synchronously.
+ */
+static int sm5440_dc_thermal_poll(struct sm5440_monitor *monitor)
+{
+	struct sm5440_dc *dc = &monitor->dc;
+	struct sm5440_dc_ta ta;
+	int target, accepted, ret;
+	unsigned int now = jiffies_to_msecs(jiffies);
+
+	target = sm5440_dc_thermal_step(&dc->thermal, dc->s.ntc, dc->s.die,
+					 dc->requested_ci_ma, dc->goal.ci_ma, now);
+	if (dc->pending_ci_ma) {
+		if (target < dc->pending_ci_ma) {
+			dc->pending_ci_ma = 0;
+		} else {
+			ret = sm5440_usb_get(monitor, POWER_SUPPLY_PROP_CURRENT_MAX,
+					     &accepted);
+			if (ret)
+				return SM5440_DC_ERR_PD_CONTRACT;
+			if (accepted >= (dc->pending_ta.ma + SM5440_DC_CHGIN_MA) * 1000) {
+				ret = sm5440_dc_program_current(monitor, dc->pending_ci_ma);
+				if (ret)
+					return SM5440_DC_ERR_I2C;
+				dc->goal.ci_ma = dc->pending_ci_ma;
+				dc->limits.ta_max_ma = dc->pending_ci_ma;
+				dc->ta = dc->pending_ta;
+				dc->pending_ci_ma = 0;
+				dc->thermal.last_up_ms = now;
+				dc->next_adjust = jiffies;
+			} else if (time_after_eq(jiffies, dc->pending_deadline)) {
+				return SM5440_DC_ERR_PD_CONTRACT;
+			}
+			return SM5440_DC_SKIP;
+		}
+	}
+	if (target == dc->goal.ci_ma)
+		return 0;
+	ta = dc->ta;
+	if (target < dc->goal.ci_ma) {
+		ret = sm5440_dc_program_current(monitor, target);
+		if (ret)
+			return SM5440_DC_ERR_I2C;
+		dc->goal.ci_ma = target;
+		dc->limits.ta_max_ma = target;
+		if (ta.ma > target)
+			ta.ma = target;
+		if (ta.ma != dc->sent.ma && sm5440_dc_request(monitor, &ta))
+			return SM5440_DC_ERR_PD_REQUEST;
+		dc->ta = ta;
+	} else {
+		if (ta.ma < target)
+			ta.ma = target;
+		ret = sm5440_usb_get(monitor, POWER_SUPPLY_PROP_CURRENT_MAX,
+					    &accepted);
+		if (ret)
+			return SM5440_DC_ERR_PD_CONTRACT;
+		if (accepted < (ta.ma + SM5440_DC_CHGIN_MA) * 1000) {
+			if (sm5440_dc_request(monitor, &ta))
+				return SM5440_DC_ERR_PD_REQUEST;
+			dc->pending_ci_ma = target;
+			dc->pending_ta = ta;
+			dc->pending_deadline = jiffies + msecs_to_jiffies(3000);
+			return SM5440_DC_SKIP;
+		}
+		ret = sm5440_dc_program_current(monitor, target);
+		if (ret)
+			return SM5440_DC_ERR_I2C;
+		dc->goal.ci_ma = target;
+		dc->limits.ta_max_ma = target;
+		dc->ta = ta;
+		dc->thermal.last_up_ms = now;
+	}
+	dc->next_adjust = jiffies;
+	dev_info(&monitor->client->dev, "dc thermal level %u: %d/%d mA, ntc %d die %d\n",
+		 dc->thermal.level, dc->goal.ci_ma, dc->requested_ci_ma,
+		 dc->s.ntc, dc->s.die);
+	return SM5440_DC_SKIP;
+}
+
+static void sm5440_dc_run_poll(struct sm5440_monitor *monitor)
+{
+	struct sm5440_dc *dc = &monitor->dc;
+	struct sm5440_dc_step st;
+	struct sm5440_dc_ta ta;
+	int ret;
+
+	ret = sm5440_dc_running_checks(monitor);
+	if (ret > 0) {
+		sm5440_dc_stop(monitor, ret);
+		return;
+	}
+	if (dc->state == SM5440_DC_ENABLE) {
+		if (!ret && dc->s.ibus_ma >= SM5440_DC_ENABLE_MIN_MA &&
+		    !((monitor->events_now | monitor->live) &
+		      (SM5440_FAULT_STUP_FAIL | SM5440_FAULT_CFLY_SHORT))) {
+			dc->state = SM5440_DC_RUN;
+			dc->phase = SM5440_DC_PHASE_PRE_CC;
+			dc->next_adjust = jiffies;
+			sm5440_dc_log(monitor, "pump running");
+		} else if (time_after_eq(jiffies, dc->step_deadline)) {
+			sm5440_dc_stop(monitor, SM5440_DC_ERR_ENABLE);
+		}
+		return;
+	}
+	if (ret || time_before(jiffies, dc->next_adjust))
+		return;
+	ret = sm5440_dc_thermal_poll(monitor);
+	if (ret > 0)
+		sm5440_dc_stop(monitor, ret);
+	if (ret)
+		return;
+	ta = dc->ta;
+	sm5440_dc_run(dc->phase, &dc->s, &dc->goal, &dc->limits, &ta, &dc->ramp, &st);
+	if (st.phase != dc->phase)
+		dev_info(&monitor->client->dev, "dc %s -> %s at %d mV/%d mA, ibus %d mA vbat %d mV\n",
+			 sm5440_dc_phase_names[dc->phase], sm5440_dc_phase_names[st.phase],
+			 ta.mv, ta.ma, dc->s.ibus_ma, dc->s.vbat_mv);
+	if (st.phase == SM5440_DC_PHASE_FAIL || st.phase == SM5440_DC_PHASE_DONE) {
+		sm5440_dc_stop(monitor, st.reason);
+		return;
+	}
+	/* The MAX77705 renews an unchanged contract itself; only changes go
+	 * through the mailbox.
+	 */
+	if (ta.mv != dc->sent.mv || ta.ma != dc->sent.ma) {
+		if (sm5440_dc_request(monitor, &ta)) {
+			sm5440_dc_stop(monitor, SM5440_DC_ERR_PD_REQUEST);
+			return;
+		}
+	}
+	dc->ta = ta;
+	dc->phase = st.phase;
+	dc->next_adjust = jiffies + msecs_to_jiffies(st.delay_ms);
+}
+
+/* Watchdog expiry test: no SM5440 I2C at all for two timeouts plus margin,
+ * while the lease and the MAX77705 policy stay checked. The window is kept
+ * under the 5 s lease.
+ */
+static void sm5440_dc_wdt_test_poll(struct sm5440_monitor *monitor)
+{
+	struct sm5440_dc *dc = &monitor->dc;
+	int ret, fault, mv;
+
+	ret = sm5440_dc_hold_lease(monitor);
+	if (!ret)
+		ret = sm5440_dc_policy(monitor);
+	/* The window (4.5 s) is longer than the MAX77705 grace (3.5 s): a
+	 * withdrawn contract ends the test at once, like a running session.
+	 */
+	if (!ret && (sm5440_usb_get(monitor, POWER_SUPPLY_PROP_VOLTAGE_NOW, &mv) ||
+		     mv <= 5000000))
+		ret = SM5440_DC_ERR_PD_CONTRACT;
+	if (!ret && !allow_pump)
+		ret = SM5440_DC_STOP_USER;
+	if (!ret && time_after_eq(jiffies, dc->deadline))
+		ret = SM5440_DC_STOP_TIMEOUT;
+	if (!ret && time_before(jiffies, dc->wdt_test_until))
+		return;
+	fault = sm5440_fault_sample(monitor);
+	if (ret) {
+		dc->wdt_test = -1;
+		sm5440_dc_stop(monitor, ret);
+	} else if (fault) {
+		dc->wdt_test = -1;
+		sm5440_dc_stop(monitor, SM5440_DC_ERR_I2C);
+	} else if (monitor->op_mode != SM5440_OP_MODE_CHG_ON &&
+		   ((monitor->events_now | monitor->latched) & SM5440_FAULT_WDT)) {
+		dc->wdt_test = 2;
+		dev_info(&monitor->client->dev, "dc watchdog test PASSED: expiry cut the running pump\n");
+		sm5440_dc_stop(monitor, SM5440_DC_ERR_WDT);
+	} else {
+		dc->wdt_test = -1;
+		dev_err(&monitor->client->dev,
+			"dc watchdog test FAILED: op_mode=%u events=0x%08x after %u ms without kicks\n",
+			monitor->op_mode, monitor->events_now,
+			2 * sm5440_wdt_timer_ms(SM5440_DC_WDT_TIMER) + 500);
+		sm5440_dc_stop(monitor, SM5440_DC_ERR_WDT_NOT_CUT);
+	}
+}
+
+/* Forward declaration: sm5440_dc_begin() is defined later in the file (the
+ * sysfs 'start'/'pump' handler already calls it from further down), but
+ * sm5440_dc_auto_poll() below -- reached from sm5440_dc_advance(), which is
+ * defined earlier -- needs it too.
+ */
+static int sm5440_dc_begin(struct sm5440_monitor *monitor, bool probe, int a, int b);
+
+#define SM5440_DC_AUTO_RETRY_MS	5000
+#define SM5440_DC_AUTO_CV_MV	4100
+
+/* Autonomous entry: no script or sysfs 'start' write needed. Runs only
+ * while dc->state == SM5440_DC_OFF, from the OFF branch of the poll worker
+ * (sm5440_dc_advance() is never reached in that state). Gated on
+ * allow_pump exactly like the manual path, so turning that off still stops
+ * both new and in-progress sessions the same way it always has.
+ *
+ * The cheap pre-check (a single cached power_supply read, no new SM5440
+ * I2C) filters out the common case of not being on a settled fixed-5V
+ * contract at all, so idling on a non-PD charger or no charger doesn't
+ * repeatedly touch the SM5440. Only once that passes does this fall
+ * through to sm5440_dc_begin(), which does real I2C and the full entry
+ * check (sm5440_dc_entry_check: latched faults, thermal policy, VBAT
+ * window, NTC/die -- the same gates the manual path has always used); a
+ * refusal there is normal and silent, not logged as an error, and this
+ * just retries after the cooldown. A latched fault from an earlier session
+ * blocks new attempts until it clears (a physical detach already does that
+ * automatically, same as it always has -- see the DC_TD_ABANDON handling).
+ *
+ * The requested current is whatever max_pump_ma is currently set to (the
+ * same knob every staged test has used), not a separate auto-specific
+ * ceiling -- so the safe default (1000 mA) is what this runs at until a
+ * human deliberately raises it, and a session ending (deadline, thermal
+ * stop, disconnect) just means the next poll tries again while conditions
+ * still allow it, which is the continuous-renewal behavior this is for.
+ */
+static void sm5440_dc_auto_poll(struct sm5440_monitor *monitor)
+{
+	struct sm5440_dc *dc = &monitor->dc;
+	int online, mv, ret;
+
+	if (!allow_pump || dc->stopped || dc->latched)
+		return;
+	if (time_before(jiffies, dc->auto_next_try))
+		return;
+	dc->auto_next_try = jiffies + msecs_to_jiffies(SM5440_DC_AUTO_RETRY_MS);
+	if (sm5440_dc_acquire(monitor))
+		return;
+	if (sm5440_usb_get(monitor, POWER_SUPPLY_PROP_ONLINE, &online) || !online)
+		return;
+	if (sm5440_usb_get(monitor, POWER_SUPPLY_PROP_VOLTAGE_NOW, &mv) || mv != 5000000)
+		return;
+	ret = sm5440_dc_begin(monitor, false, min(max_pump_ma, SM5440_DC_PUMP_MAX_MA),
+			      SM5440_DC_AUTO_CV_MV);
+	if (ret != dc->auto_last_ret) {
+		dc->auto_last_ret = ret;
+		dev_info(&monitor->client->dev, "auto entry result %d (reason: %s)\n",
+			 ret, sm5440_dc_reason_name(dc->last_reason));
+	}
+}
+
+static unsigned int sm5440_dc_advance(struct sm5440_monitor *monitor, int fault)
+{
+	struct sm5440_dc *dc = &monitor->dc;
+
+	if (dc->state != SM5440_DC_OFF && dc->state != SM5440_DC_TEARDOWN) {
+		if (fault)
+			sm5440_dc_stop(monitor, SM5440_DC_ERR_I2C);
+		else if (time_after_eq(jiffies, dc->deadline))
+			sm5440_dc_stop(monitor, SM5440_DC_STOP_TIMEOUT);
+		else if (dc->state >= SM5440_DC_ENABLE && !allow_pump)
+			sm5440_dc_stop(monitor, SM5440_DC_STOP_USER);
+		else if (dc->state >= SM5440_DC_ENABLE)
+			sm5440_dc_run_poll(monitor);
+		else
+			sm5440_dc_entry_poll(monitor);
+	}
+	if (dc->state == SM5440_DC_TEARDOWN)
+		sm5440_dc_teardown_poll(monitor);
+	switch (dc->state) {
+	case SM5440_DC_OFF:
+		return SM5440_POLL_MS;
+	case SM5440_DC_RUN:
+		return dc->phase == SM5440_DC_PHASE_PRE_CC ? 250 : 500;
+	case SM5440_DC_VERIFY:
+	case SM5440_DC_HOLD:
+		return 300;
+	default:
+		return 250;
+	}
+}
+
+/* Synchronous teardown for suspend and unbind; the poll is already
+ * cancelled. Returns -EBUSY if the pump could not be confirmed off.
+ */
+static int sm5440_dc_teardown_sync(struct sm5440_monitor *monitor, int reason)
+{
+	struct sm5440_dc *dc = &monitor->dc;
+	int i;
+
+	if (dc->state == SM5440_DC_OFF)
+		return 0;
+	if (dc->wdt_test == 1)
+		dc->wdt_test = -1;
+	sm5440_dc_stop(monitor, reason);
+	for (i = 0; i < SM5440_DC_SYNC_LOOPS && dc->state != SM5440_DC_OFF; i++) {
+		sm5440_fault_sample(monitor);
+		sm5440_dc_teardown_poll(monitor);
+		if (dc->state != SM5440_DC_OFF)
+			msleep(100);
+	}
+	if (dc->state != SM5440_DC_OFF)
+		dev_err(&monitor->client->dev, "synchronous teardown incomplete at %s\n",
+			sm5440_dc_td_names[dc->td_step]);
+	return dc->pumping ? -EBUSY : 0;
+}
+
+static int sm5440_dc_begin(struct sm5440_monitor *monitor, bool probe, int a, int b)
+{
+	struct sm5440_dc *dc = &monitor->dc;
+	struct sm5440_dc_entry e = { 0 };
+	int cntl5, online, health, mv, ret;
+
+	if (dc->stopped)
+		return -ESHUTDOWN;
+	if (dc->state != SM5440_DC_OFF)
+		return -EBUSY;
+	if (dc->latched)
+		return -EIO;
+	dc->limits = sm5440_dc_pilot;
+	dc->goal.ci_ma = 1000;
+	dc->requested_ci_ma = 0;
+	dc->pending_ci_ma = 0;
+	memset(&dc->thermal, 0, sizeof(dc->thermal));
+	dc->thermal.last_up_ms = jiffies_to_msecs(jiffies);
+	if (probe) {
+		/* Pump stays off: only the envelope and the VBUS relation
+		 * matter, not the battery window.
+		 */
+		if (a % 20 || a < dc->limits.ta_min_mv || a > dc->limits.ta_max_mv ||
+		    b < 1 || b > 20)
+			return -EINVAL;
+		dc->goal.cv_mv = 4500;
+		dc->limits.vbat_entry_min_mv = dc->limits.vbat_floor_mv + 1;
+		dc->limits.vbat_entry_max_mv = 4500;
+		dc->ta.mv = a;
+		dc->ta.ma = dc->limits.ta_min_ma;
+		dc->hold_ms = b * 1000;
+	} else {
+		if (!allow_pump)
+			return -EPERM;
+		/* cv below ~4050 mV puts 2 * cv well under the 8200 mV PPS
+		 * floor: CV could not taper by voltage and the pump would
+		 * burn the difference. 4150 mV is the WARM float.
+		 */
+		if (a < 1000 || a % 50 || a > min(max_pump_ma, SM5440_DC_PUMP_MAX_MA) ||
+		    b < 4050 || b > 4150)
+			return -EINVAL;
+		dc->goal.cv_mv = b;
+		dc->goal.ci_ma = a;
+		dc->requested_ci_ma = a;
+		dc->limits.ta_max_ma = a;
+		dc->limits.p_max = (long long)dc->limits.ta_max_mv * a;
+	}
+	ret = sm5440_dc_acquire(monitor);
+	if (ret)
+		return ret;
+	cntl5 = i2c_smbus_read_byte_data(monitor->client, SM5440_CNTL5);
+	if (cntl5 < 0)
+		return cntl5;
+	ret = sm5440_adc_sample(monitor);
+	if (ret)
+		return ret;
+	monitor->valid = true;
+	sm5440_dc_gauge(monitor);
+	e.vbat_mv = monitor->vbat_mv;
+	e.gauge_vbat_mv = dc->gauge_mv;
+	e.ntc = monitor->ntc_mc / 100;
+	e.die = monitor->die_mc / 100;
+	e.op_mode = sm5440_op_mode(cntl5);
+	e.cutoff = !!((monitor->latched | monitor->live) & SM5440_DC_ENTRY_FAULTS);
+	e.vbus_present = sm5440_vbus_present(monitor);
+	/* Online on a settled fixed 5 V contract, with no PPS state left over. */
+	e.source_online = !sm5440_usb_get(monitor, POWER_SUPPLY_PROP_ONLINE, &online) &&
+		online && !sm5440_usb_get(monitor, POWER_SUPPLY_PROP_VOLTAGE_NOW, &mv) &&
+		mv == 5000000;
+	e.policy_good = !sm5440_usb_get(monitor, POWER_SUPPLY_PROP_HEALTH, &health) &&
+		health == POWER_SUPPLY_HEALTH_GOOD;
+	ret = sm5440_dc_entry_check(&e, &dc->goal, &dc->limits);
+	if (ret) {
+		dc->last_reason = ret;
+		dev_info(&monitor->client->dev, "direct charge refused: %s (vbat %d/%d mV, ntc %d, die %d)\n",
+			 sm5440_dc_reason_name(ret), e.vbat_mv, e.gauge_vbat_mv, e.ntc, e.die);
+		return -ERANGE;
+	}
+	ret = sm5440_dc_init_chip(monitor);
+	if (ret) {
+		dc->last_reason = SM5440_DC_ERR_I2C;
+		dev_err(&monitor->client->dev, "SM5440 init failed: %d\n", ret);
+		sm5440_safe_state(monitor, "init failure");
+		return ret;
+	}
+	dc->probe = probe;
+	dc->phase = SM5440_DC_PHASE_PRE_CC;
+	dc->reason = 0;
+	dc->elevated = false;
+	dc->fixed_sent = false;
+	dc->leased = false;
+	dc->abandoned = false;
+	dc->wdt_test = 0;
+	dc->uvlo = 0;
+	dc->sent = (struct sm5440_dc_ta){ 0 };
+	dc->prev = (struct sm5440_dc_sample){ 0 };
+	dc->s = (struct sm5440_dc_sample){ .vbus_mv = monitor->vbus_mv,
+					    .vbat_mv = monitor->vbat_mv };
+	dc->vbus_min_mv = INT_MAX;
+	dc->vbus_max_mv = 0;
+	dc->ibus_max_ma = 0;
+	dc->ntc_max = e.ntc;
+	dc->die_max = e.die;
+	dc->started = jiffies;
+	dc->deadline = jiffies + clamp(session_max_s, 10U, 900U) * HZ;
+	dc->step_deadline = jiffies + msecs_to_jiffies(SM5440_DC_STEP_MS);
+	dc->state = SM5440_DC_YIELD;
+	dc->sessions++;
+	/* Hold the system awake for the session, as stock does
+	 * (sm5440_start_charging): a pump session is not something to sleep
+	 * through, and suspend is not yet functional on this port anyway.
+	 */
+	pm_stay_awake(&monitor->client->dev);
+	dev_info(&monitor->client->dev,
+		 "direct charge %s: %s%d, ci %d mA, vbat %d/%d mV, vbus %d mV, ntc %d, die %d, deadline %u s\n",
+		 probe ? "pump-off probe" : "session", probe ? "request mV " : "cv mV ",
+		 probe ? a : b, dc->goal.ci_ma, e.vbat_mv, e.gauge_vbat_mv, monitor->vbus_mv,
+		 e.ntc, e.die,
+		 clamp(session_max_s, 10U, 900U));
+	mod_delayed_work(system_wq, &monitor->poll, 0);
+	return 0;
+}
+
+static ssize_t direct_charge_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct sm5440_monitor *monitor = dev_get_drvdata(dev);
+	struct sm5440_dc *dc = &monitor->dc;
+	ssize_t ret;
+
+	mutex_lock(&monitor->lock);
+	ret = sysfs_emit(buf,
+		"state=%s phase=%s teardown=%s reason=%s last=%s probe=%d pump=%s allow_pump=%d leased=%d latched=%d abandoned=%d wdt_test=%d\n"
+		"ta=%d mV/%d mA (+%d mA buck) sent=%d mV/%d mA goal cv=%d mV ci=%d/%d mA thermal=%u pending=%d\n"
+		"sample vbus=%d ibus=%d vout=%d vbat=%d mV ntc=%d die=%d (0.1 C) loop=%u gauge=%d mV %d uA\n"
+		"seen vbus=%d..%d mV ibus_max=%d mA ntc_max=%d die_max=%d elapsed=%u ms steps=%u sessions=%u failures=%u\n",
+		sm5440_dc_state_names[dc->state], sm5440_dc_phase_names[dc->phase],
+		sm5440_dc_td_names[dc->td_step], sm5440_dc_reason_name(dc->reason),
+		sm5440_dc_reason_name(dc->last_reason), dc->probe,
+		dc->pumping ? "on" : "off", allow_pump, dc->leased, dc->latched,
+		dc->abandoned, dc->wdt_test,
+		dc->ta.mv, dc->ta.ma, SM5440_DC_CHGIN_MA, dc->sent.mv, dc->sent.ma,
+		dc->goal.cv_mv, dc->goal.ci_ma, dc->requested_ci_ma,
+		dc->thermal.level, dc->pending_ci_ma,
+		dc->s.vbus_mv, dc->s.ibus_ma, dc->s.vout_mv, dc->s.vbat_mv, dc->s.ntc,
+		dc->s.die, dc->s.loop, dc->gauge_mv, dc->gauge_ua,
+		dc->vbus_min_mv == INT_MAX ? 0 : dc->vbus_min_mv, dc->vbus_max_mv,
+		dc->ibus_max_ma, dc->ntc_max, dc->die_max,
+		dc->started ? jiffies_to_msecs(jiffies - dc->started) : 0,
+		dc->ramp.steps, dc->sessions, dc->failures);
+	mutex_unlock(&monitor->lock);
+	return ret;
+}
+
+/* Root-only. Commands:
+ *   probe <mV> <hold_s>   pump-off: lease, PPS request, VBUS verify, hold, teardown
+ *   start <ci_mA> <cv_mV> pump-on session, ci 1000..max_pump_ma (<= 4500),
+ *                         cv 4050..4150; needs allow_pump=1
+ *   wdt_test              while running in CC/CV: stop kicking, expect the
+ *                         chip's watchdog to cut the pump
+ *   stop                  ordered teardown
+ *   clear                 clear a latched failure (session off only)
+ */
+static ssize_t direct_charge_store(struct device *dev, struct device_attribute *attr,
+				   const char *buf, size_t count)
+{
+	struct sm5440_monitor *monitor = dev_get_drvdata(dev);
+	struct sm5440_dc *dc = &monitor->dc;
+	int a, b, ret = 0;
+
+	mutex_lock(&monitor->lock);
+	if (dc->stopped) {
+		ret = -ESHUTDOWN;
+	} else if (sysfs_streq(buf, "stop")) {
+		if (dc->wdt_test == 1)
+			dc->wdt_test = -1;
+		sm5440_dc_stop(monitor, SM5440_DC_STOP_USER);
+		mod_delayed_work(system_wq, &monitor->poll, 0);
+	} else if (sysfs_streq(buf, "clear")) {
+		if (dc->state != SM5440_DC_OFF) {
+			ret = -EBUSY;
+		} else {
+			dc->latched = false;
+			dc->abandoned = false;
+			dc->wdt_test = 0;
+		}
+	} else if (sysfs_streq(buf, "wdt_test")) {
+		if (dc->state != SM5440_DC_RUN || dc->wdt_test == 1 ||
+		    (dc->phase != SM5440_DC_PHASE_CC && dc->phase != SM5440_DC_PHASE_CV)) {
+			ret = -EBUSY;
+		} else {
+			dc->wdt_test = 1;
+			dc->wdt_test_until = jiffies + msecs_to_jiffies(
+				2 * sm5440_wdt_timer_ms(SM5440_DC_WDT_TIMER) + 500);
+			dev_info(dev, "dc watchdog test: kicks stopped at %d mV, ibus %d mA\n",
+				 dc->ta.mv, dc->s.ibus_ma);
+		}
+	} else if (sscanf(buf, "probe %d %d", &a, &b) == 2) {
+		ret = sm5440_dc_begin(monitor, true, a, b);
+	} else if (sscanf(buf, "start %d %d", &a, &b) == 2) {
+		ret = sm5440_dc_begin(monitor, false, a, b);
+	} else {
+		ret = -EINVAL;
+	}
+	mutex_unlock(&monitor->lock);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_RW(direct_charge);
+
+static struct attribute *sm5440_monitor_attrs[] = {
+	&dev_attr_adc.attr,
+	&dev_attr_faults.attr,
+	&dev_attr_registers.attr,
+	&dev_attr_direct_charge.attr,
+#ifdef SM5440_MONITOR_SELFTEST
+	&dev_attr_watchdog_selftest.attr,
+#endif
+	NULL,
+};
+
+static umode_t sm5440_monitor_attr_mode(struct kobject *kobj, struct attribute *attr, int n)
+{
+	/* Commands and register dumps are for root only. */
+	if (attr == &dev_attr_direct_charge.attr)
+		return 0600;
+	if (attr == &dev_attr_registers.attr)
+		return 0400;
+	return attr->mode;
+}
+
+static const struct attribute_group sm5440_monitor_group = {
+	.attrs = sm5440_monitor_attrs,
+	.is_visible = sm5440_monitor_attr_mode,
+};
+
+static const struct power_supply_desc sm5440_monitor_desc = {
+	.name = "sm5440_direct",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.properties = sm5440_monitor_properties,
+	.num_properties = ARRAY_SIZE(sm5440_monitor_properties),
+	.get_property = sm5440_monitor_property,
+};
+
+static void sm5440_monitor_poll(struct work_struct *work)
+{
+	struct sm5440_monitor *monitor = container_of(to_delayed_work(work),
+						    struct sm5440_monitor, poll);
+	struct sm5440_dc *dc = &monitor->dc;
+	unsigned int delay;
+	int fault = 0, adc = 0;
+
+	mutex_lock(&monitor->lock);
+	if (dc->stopped) {
+		mutex_unlock(&monitor->lock);
+		return;
+	}
+	if (dc->state != SM5440_DC_OFF && dc->wdt_test == 1) {
+		sm5440_dc_wdt_test_poll(monitor);
+		delay = 250;
+		if (dc->state == SM5440_DC_TEARDOWN)
+			sm5440_dc_teardown_poll(monitor);
+		goto out;
+	}
+	fault = sm5440_fault_sample(monitor);
+	if (dc->state == SM5440_DC_OFF) {
+		if (!fault) {
+			adc = sm5440_adc_sample(monitor);
+			monitor->valid = !adc;
+			/* A physical detach clears a latched session failure. This
+			 * chip's VBUS ADC is not refreshed without VBUS, so the
+			 * MAX77705's attach state is what reliably shows a detach.
+			 */
+			if (dc->latched) {
+				int online = 1;
+
+				if (!sm5440_dc_acquire(monitor))
+					sm5440_usb_get(monitor, POWER_SUPPLY_PROP_ONLINE, &online);
+				if (!online || monitor->vbus_mv < 3500) {
+					dc->latched = false;
+					dev_info(&monitor->client->dev,
+						 "direct charge latch cleared by detach\n");
+				}
+			}
+			sm5440_dc_auto_poll(monitor);
+		} else {
+			monitor->valid = false;
+		}
+		delay = monitor->ocp_strikes ? SM5440_OCP_POLL_MS : SM5440_POLL_MS;
+		if (dc->state != SM5440_DC_OFF)
+			delay = 250;
+	} else {
+		delay = sm5440_dc_advance(monitor, fault);
+	}
+	/* Never kick while tearing down: if the pump-off write is not
+	 * landing, the watchdog is the thing that must end it.
+	 */
+	if (monitor->wdt_armed && dc->state != SM5440_DC_TEARDOWN)
+		sm5440_wdt_kick(monitor);
+out:
+	mutex_unlock(&monitor->lock);
+	if (fault)
+		dev_err_ratelimited(&monitor->client->dev, "fault sampling failed: %d\n", fault);
+	else if (adc)
+		dev_err_ratelimited(&monitor->client->dev, "off-mode ADC failed: %d\n", adc);
+	power_supply_changed(monitor->supply);
+	schedule_delayed_work(&monitor->poll, msecs_to_jiffies(delay));
+}
+
+static int sm5440_monitor_probe(struct i2c_client *client)
+{
+	struct sm5440_monitor *monitor;
+	struct power_supply_config config = {};
+	int id, mode, ret;
+
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_SMBUS_BYTE_DATA |
+					   I2C_FUNC_SMBUS_READ_I2C_BLOCK))
+		return -EOPNOTSUPP;
+	id = i2c_smbus_read_byte_data(client, SM5440_DEVICEID);
+	mode = i2c_smbus_read_byte_data(client, SM5440_CNTL5);
+	if (id < 0 || (id & 15) != 1 || mode < 0 || (mode & 12))
+		return dev_err_probe(&client->dev, id < 0 ? id : -ENODEV,
+				     "SM5440 identity/off-mode check failed\n");
+	monitor = devm_kzalloc(&client->dev, sizeof(*monitor), GFP_KERNEL);
+	if (!monitor)
+		return -ENOMEM;
+	monitor->client = client;
+	mutex_init(&monitor->lock);
+	i2c_set_clientdata(client, monitor);
+	/* A watchdog left armed by earlier firmware would expire against a
+	 * driver that does not yet charge; make the state explicit.
+	 */
+	ret = i2c_smbus_read_byte_data(client, SM5440_CNTL1);
+	if (ret < 0)
+		return dev_err_probe(&client->dev, ret, "cannot read CNTL1\n");
+	monitor->wdt_timer = (ret >> 4) & 7;
+	monitor->wdt_armed = !!(ret & 0x80);
+	if (monitor->wdt_armed) {
+		dev_warn(&client->dev, "disarming inherited charge watchdog (CNTL1=0x%02x)\n", ret);
+		ret = sm5440_wdt_set(monitor, false, monitor->wdt_timer);
+		if (ret)
+			return dev_err_probe(&client->dev, ret, "cannot disarm watchdog\n");
+	}
+	/* Only an I2C failure is a probe failure; inherited fault latches are
+	 * drained and reported, not judged.
+	 */
+	ret = sm5440_fault_sample(monitor);
+	if (ret)
+		return dev_err_probe(&client->dev, ret, "cannot read fault registers\n");
+	ret = sm5440_adc_sample(monitor);
+	if (ret)
+		return dev_err_probe(&client->dev, ret, "cannot read fresh fitted NTC/ADC\n");
+	monitor->valid = true;
+	config.drv_data = monitor;
+	config.of_node = client->dev.of_node;
+	monitor->supply = devm_power_supply_register(&client->dev, &sm5440_monitor_desc, &config);
+	if (IS_ERR(monitor->supply))
+		return PTR_ERR(monitor->supply);
+	ret = devm_device_add_group(&client->dev, &sm5440_monitor_group);
+	if (ret)
+		return ret;
+	ret = devm_delayed_work_autocancel(&client->dev, &monitor->poll, sm5440_monitor_poll);
+	if (ret)
+		return ret;
+	ret = device_init_wakeup(&client->dev, true);
+	if (ret)
+		return ret;
+	dev_info(&client->dev,
+		 "SM5440 rev%d off-mode ADC: VBUS%d mV VBAT%d mV directNTC%d mC, live 0x%08x; direct charge %s\n",
+		 id >> 4, monitor->vbus_mv, monitor->vbat_mv, monitor->ntc_mc, monitor->live,
+		 allow_pump ? "ARMED" : "disarmed");
+	if (max_pump_ma > SM5440_DC_PUMP_MAX_MA)
+		dev_warn(&client->dev, "max_pump_ma %u clamped to %u\n",
+			 max_pump_ma, SM5440_DC_PUMP_MAX_MA);
+	schedule_delayed_work(&monitor->poll, msecs_to_jiffies(SM5440_POLL_MS));
+	return 0;
+}
+
+static void sm5440_monitor_remove(struct i2c_client *client)
+{
+	struct sm5440_monitor *monitor = i2c_get_clientdata(client);
+	struct sm5440_dc *dc = &monitor->dc;
+
+	mutex_lock(&monitor->lock);
+	dc->stopped = true;
+	mutex_unlock(&monitor->lock);
+	cancel_delayed_work_sync(&monitor->poll);
+	mutex_lock(&monitor->lock);
+	sm5440_dc_teardown_sync(monitor, SM5440_DC_STOP_UNBIND);
+	sm5440_safe_state(monitor, "driver unbind");
+	if (dc->usb)
+		power_supply_put(dc->usb);
+	if (dc->gauge)
+		power_supply_put(dc->gauge);
+	dc->usb = NULL;
+	dc->gauge = NULL;
+	mutex_unlock(&monitor->lock);
+	pm_relax(&client->dev);
+	device_init_wakeup(&client->dev, false);
+}
+
+static int sm5440_monitor_suspend(struct device *dev)
+{
+	struct sm5440_monitor *monitor = dev_get_drvdata(dev);
+	struct sm5440_dc *dc = &monitor->dc;
+	int ret;
+
+	mutex_lock(&monitor->lock);
+	dc->stopped = true;
+	mutex_unlock(&monitor->lock);
+	cancel_delayed_work_sync(&monitor->poll);
+	mutex_lock(&monitor->lock);
+	ret = sm5440_dc_teardown_sync(monitor, SM5440_DC_STOP_SUSPEND);
+	if (!ret && dc->state != SM5440_DC_OFF) {
+		/* Pump confirmed off; the MAX77705 suspend, which runs after
+		 * this one, closes the contract synchronously. Not a failure.
+		 */
+		dc->state = SM5440_DC_OFF;
+		dc->leased = false;
+		dc->last_reason = dc->reason;
+		pm_relax(dev);
+	}
+	if (ret) {
+		/* Refuse to sleep with a pump we could not stop. */
+		dc->stopped = false;
+		mutex_unlock(&monitor->lock);
+		schedule_delayed_work(&monitor->poll, 0);
+		return ret;
+	}
+	sm5440_safe_state(monitor, "suspend");
+	monitor->valid = false;
+	mutex_unlock(&monitor->lock);
+	return 0;
+}
+
+static int sm5440_monitor_resume(struct device *dev)
+{
+	struct sm5440_monitor *monitor = dev_get_drvdata(dev);
+
+	mutex_lock(&monitor->lock);
+	monitor->dc.stopped = false;
+	monitor->latched = 0;
+	monitor->ocp_strikes = 0;
+	monitor->drained = false;
+	mutex_unlock(&monitor->lock);
+	schedule_delayed_work(&monitor->poll, 0);
+	return 0;
+}
+static DEFINE_SIMPLE_DEV_PM_OPS(sm5440_monitor_pm, sm5440_monitor_suspend, sm5440_monitor_resume);
+
+static const struct of_device_id sm5440_monitor_match[] = {
+	{ .compatible = "siliconmitus,sm5440" }, {}
+};
+MODULE_DEVICE_TABLE(of, sm5440_monitor_match);
+static const struct i2c_device_id sm5440_monitor_ids[] = { { "sm5440-monitor" }, {} };
+MODULE_DEVICE_TABLE(i2c, sm5440_monitor_ids);
+static struct i2c_driver sm5440_monitor_driver = {
+	.driver = { .name = SM5440_DRIVER_NAME, .of_match_table = sm5440_monitor_match,
+		.pm = pm_sleep_ptr(&sm5440_monitor_pm) },
+	.probe = sm5440_monitor_probe,
+	.remove = sm5440_monitor_remove,
+	.shutdown = sm5440_monitor_remove,
+	.id_table = sm5440_monitor_ids,
+};
+module_i2c_driver(sm5440_monitor_driver);
