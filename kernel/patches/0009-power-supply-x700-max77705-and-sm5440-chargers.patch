@@ -0,0 +1,195 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* SM-X700 graduated charging thermal policy, decoded from Samsung's sec_battery.
+ *
+ * Replaces this driver's original binary "pause outside the normal band" with
+ * stock's three independent, latching controllers, which REDUCE current rather
+ * than stopping. That distinction is the prerequisite for raising FCC at all:
+ * a hard pause at 500 mA is survivable, a hard pause at 2 A is not a thermal
+ * policy.
+ *
+ * Sensor mapping for the three fitted ADC7 channels:
+ *   battery -> bat_thm   : the zone machine (sec_battery_thermal.c:1569)
+ *   blanket -> blkt_temp : the mix controller's BODY sensor. Stock substitutes
+ *                          blkt_temp for battery->temperature at
+ *                          sec_battery_thermal.c:208, so mix_high_temp = 420
+ *                          is a body threshold, not a cell one.
+ *   charger -> chg_temp  : the switching-charger controller
+ *                          (sec_bat_check_pdic_temp, :978) and, while not on
+ *                          an APDO, also the mix controller's second sensor.
+ *
+ * Deliberately NOT implemented, because they are dead on this device:
+ *   - body/LRP 45 W control: lrp_temp_check_type = 0, table malformed.
+ *   - COOL1: cool1_normal == cool2_cool1 == 150 makes the zone unreachable,
+ *     so wire_cool1_current = 3146 is never selected.
+ *   - mix_v2: enable_mix_v2 absent from the X700 DT.
+ * All temperatures are in 0.1 C, matching the fitted NTC tables.
+ */
+#ifndef GTS8_THERMAL_POLICY_H
+#define GTS8_THERMAL_POLICY_H
+
+enum gts8_zone {
+	GTS8_ZONE_COLD = 0,
+	GTS8_ZONE_COOL3,
+	GTS8_ZONE_COOL2,
+	GTS8_ZONE_NORMAL,
+	GTS8_ZONE_WARM,
+	GTS8_ZONE_OVERHEAT,
+	GTS8_ZONE_OVERHEATLIMIT,
+};
+
+/* Latches. Stock keeps these in struct sec_battery_info; they must persist
+ * across samples or the hysteresis below means nothing.
+ */
+struct gts8_thermal_state {
+	int zone;
+	int mix_limit;
+	int chg_limit;
+};
+
+struct gts8_charge_limit {
+	int fcc_ma;		/* 0 disables charging */
+	int icl_ma;		/* 0 means no thermal cap from this policy */
+	int float_mv;		/* 0 means keep the inherited float voltage */
+	int buck_off;		/* drop the system buck as well */
+	int zone;
+};
+
+/* runtime.dts:35327-35332, with THERMAL_HYSTERESIS_2 = 19 (1.9 C) already
+ * folded in as stock folds it: applied to the occupied zone's boundary and
+ * every colder boundary below it, never symmetrically to all six.
+ */
+static inline int gts8_zone_step(int zone, int bat)
+{
+	int ohl = zone >= GTS8_ZONE_OVERHEATLIMIT ? 681 : 700;
+	int oh = zone >= GTS8_ZONE_OVERHEAT ? 481 : 500;
+	int warm = zone >= GTS8_ZONE_WARM ? 401 : 420;
+	int cool2 = zone <= GTS8_ZONE_COOL2 ? 169 : 150;
+	int cool3 = zone <= GTS8_ZONE_COOL3 ? 69 : 50;
+	int cold = zone <= GTS8_ZONE_COLD ? 19 : 0;
+
+	if (bat >= ohl)
+		return GTS8_ZONE_OVERHEATLIMIT;
+	if (bat >= oh)
+		return GTS8_ZONE_OVERHEAT;
+	if (bat >= warm)
+		return GTS8_ZONE_WARM;
+	if (bat <= cold)
+		return GTS8_ZONE_COLD;
+	if (bat <= cool3)
+		return GTS8_ZONE_COOL3;
+	if (bat <= cool2)
+		return GTS8_ZONE_COOL2;
+	return GTS8_ZONE_NORMAL;
+}
+
+/* Per-zone actions, sec_battery_thermal.c:1623-1848. WARM also drops the float
+ * voltage to 4150 mV, which matters more as FCC rises because the CV corner
+ * arrives sooner.
+ */
+static inline void gts8_zone_limit(int zone, int ceiling_ma,
+				   struct gts8_charge_limit *out)
+{
+	out->float_mv = 0;
+	out->buck_off = 0;
+	switch (zone) {
+	case GTS8_ZONE_OVERHEATLIMIT:
+		out->fcc_ma = 0;
+		out->buck_off = 1;
+		break;
+	case GTS8_ZONE_OVERHEAT:
+	case GTS8_ZONE_COLD:
+		out->fcc_ma = 0;
+		break;
+	case GTS8_ZONE_WARM:
+		out->fcc_ma = ceiling_ma < 2750 ? ceiling_ma : 2750;
+		out->float_mv = 4150;
+		break;
+	case GTS8_ZONE_COOL2:
+		out->fcc_ma = ceiling_ma < 1850 ? ceiling_ma : 1850;
+		break;
+	case GTS8_ZONE_COOL3:
+		out->fcc_ma = ceiling_ma < 750 ? ceiling_ma : 750;
+		break;
+	default:
+		out->fcc_ma = ceiling_ma;
+	}
+}
+
+/* Mix: the only genuine AND across two sensors. Entry needs both; once
+ * latched only the body sensor can clear it (sec_battery_thermal.c:221-260).
+ */
+static inline int gts8_mix_step(int mix, int blanket, int charger)
+{
+	if (!mix)
+		return blanket >= 420 && charger >= 500;
+	return blanket > 390;
+}
+
+/* Reduced input limit while mix is latched: max_icl 1600 mA scaled by float
+ * voltage over 90% of the input voltage (sec_battery_thermal.c:224-239).
+ * 1557 mA at 5 V with a 4380 mV float; 865 mA at 9 V.
+ */
+static inline int gts8_mix_icl(int float_mv, int input_mv)
+{
+	int icl;
+
+	if (input_mv <= 0)
+		return 1600;
+	icl = 1600 * float_mv / (input_mv * 9 / 10);
+	return icl < 1600 ? icl : 1600;
+}
+
+/* Switching-charger control, sec_bat_check_pdic_temp (:978). Note the edge
+ * case: the limiting branch wins at exactly 770, so release needs < 770.
+ */
+static inline int gts8_chg_step(int chg_limit, int charger)
+{
+	if (!chg_limit)
+		return charger >= 800;
+	return charger >= 770;
+}
+
+/* chg_input_limit_current is expressed AT 9 V (runtime.dts:35358), so it is
+ * 1000 mA at 9 V but 1800 mA at 5 V. Taking the DT number as a literal 5 V
+ * setpoint would under-charge by 45%.
+ */
+static inline int gts8_chg_icl(int input_mv)
+{
+	return input_mv > 0 ? 1000 * 9000 / input_mv : 1000;
+}
+
+#define GTS8_CHG_LIMIT_FCC 1900
+
+/* One policy pass. ceiling_ma is what the caller would charge at with no
+ * thermal restriction; input_mv is the negotiated contract voltage.
+ * Returns 1 if charging is permitted, 0 if it must stop.
+ */
+static inline int gts8_thermal_step(struct gts8_thermal_state *state,
+				    int battery, int blanket, int charger,
+				    int input_mv, int ceiling_ma,
+				    struct gts8_charge_limit *out)
+{
+	int float_mv;
+
+	state->zone = gts8_zone_step(state->zone, battery);
+	gts8_zone_limit(state->zone, ceiling_ma, out);
+	out->zone = state->zone;
+	out->icl_ma = 0;
+
+	state->mix_limit = gts8_mix_step(state->mix_limit, blanket, charger);
+	state->chg_limit = gts8_chg_step(state->chg_limit, charger);
+
+	float_mv = out->float_mv ? out->float_mv : 4380;
+	if (state->mix_limit) {
+		/* Stock sets SKIP_HEATING_CONTROL for this pass, so the
+		 * switching-charger reduction does not also apply (:246).
+		 */
+		out->icl_ma = gts8_mix_icl(float_mv, input_mv);
+	} else if (state->chg_limit) {
+		out->icl_ma = gts8_chg_icl(input_mv);
+		if (out->fcc_ma > GTS8_CHG_LIMIT_FCC)
+			out->fcc_ma = GTS8_CHG_LIMIT_FCC;
+	}
+	return out->fcc_ma > 0 && !out->buck_off;
+}
+#endif
--- /dev/null
+++ b/drivers/power/supply/max77705-altmode.h
@@ -0,0 +1,193 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * MAX77705 DisplayPort alternate mode: frame encoding and VDM decoding.
+ *
+ * The USB-C firmware runs Discover Identity/SVIDs/Modes itself once
+ * SET_ALTERNATEMODE (0x55) has its VDM bit set, and flags each received VDM:
+ * VDM_INT (0x05) bits 0-3 for Discover ID/SVIDs/Modes and Enter Mode,
+ * PD_INT (0x04) bits 2-4 for DP Status Update, DP Configure and Attention.
+ * The AP reads a flagged VDM with GET_VDM_RESP (0x4b, one byte naming it) and
+ * sends Enter Mode and DP Configure with SET_VDM_REQ (0x48). Layouts follow
+ * Samsung's GPL max77705_alternate.c; the VDOs are the standard DisplayPort
+ * alternate mode ones.
+ *
+ * GET_VDM_RESP reply: [0] opcode, [1] VDM id, [2..3] PD message header,
+ * [4..7] VDM header, [8..] VDOs, all little endian.
+ */
+#ifndef MAX77705_ALTMODE_H
+#define MAX77705_ALTMODE_H
+
+#include <linux/bits.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+#define MAX77705_REG_VDM_INT		0x05
+#define MAX77705_VDM_INT_ID		0x01
+#define MAX77705_VDM_INT_SVIDS		0x02
+#define MAX77705_VDM_INT_MODES		0x04
+#define MAX77705_VDM_INT_ENTER		0x08
+#define MAX77705_PD_INT_DP_STATUS	0x04
+#define MAX77705_PD_INT_DP_CONFIGURE	0x08
+#define MAX77705_PD_INT_ATTENTION	0x10
+
+#define MAX77705_OP_SET_VDM_REQ		0x48
+#define MAX77705_OP_GET_VDM_RESP	0x4b
+#define MAX77705_ALTMODE_VDM		0x02
+
+/* VDM ids named in GET_VDM_RESP and its reply byte 1. */
+#define MAX77705_VDM_ID_IDENTITY	0x01
+#define MAX77705_VDM_ID_SVIDS		0x02
+#define MAX77705_VDM_ID_MODES		0x03
+#define MAX77705_VDM_ID_ENTER		0x04
+#define MAX77705_VDM_ID_EXIT		0x05
+#define MAX77705_VDM_ID_ATTENTION	0x06
+#define MAX77705_VDM_ID_DP_STATUS	0x10
+#define MAX77705_VDM_ID_DP_CONFIGURE	0x11
+
+/* Pending-read bits, in the order they are serviced. */
+#define MAX77705_DPV_IDENTITY		BIT(0)
+#define MAX77705_DPV_SVIDS		BIT(1)
+#define MAX77705_DPV_MODES		BIT(2)
+#define MAX77705_DPV_ENTER		BIT(3)
+#define MAX77705_DPV_DP_STATUS		BIT(4)
+#define MAX77705_DPV_DP_CONFIGURE	BIT(5)
+#define MAX77705_DPV_ATTENTION		BIT(6)
+#define MAX77705_DPV_COUNT		7
+
+static const u8 max77705_dpv_ids[MAX77705_DPV_COUNT] = {
+	MAX77705_VDM_ID_IDENTITY, MAX77705_VDM_ID_SVIDS, MAX77705_VDM_ID_MODES,
+	MAX77705_VDM_ID_ENTER, MAX77705_VDM_ID_DP_STATUS,
+	MAX77705_VDM_ID_DP_CONFIGURE, MAX77705_VDM_ID_ATTENTION,
+};
+
+static inline unsigned int max77705_dpv_pending(int vdm_int, int pd_int)
+{
+	return (vdm_int & MAX77705_VDM_INT_ID ? MAX77705_DPV_IDENTITY : 0) |
+	       (vdm_int & MAX77705_VDM_INT_SVIDS ? MAX77705_DPV_SVIDS : 0) |
+	       (vdm_int & MAX77705_VDM_INT_MODES ? MAX77705_DPV_MODES : 0) |
+	       (vdm_int & MAX77705_VDM_INT_ENTER ? MAX77705_DPV_ENTER : 0) |
+	       (pd_int & MAX77705_PD_INT_DP_STATUS ? MAX77705_DPV_DP_STATUS : 0) |
+	       (pd_int & MAX77705_PD_INT_DP_CONFIGURE ? MAX77705_DPV_DP_CONFIGURE : 0) |
+	       (pd_int & MAX77705_PD_INT_ATTENTION ? MAX77705_DPV_ATTENTION : 0);
+}
+
+#define MAX77705_DP_SVID		0xff01
+#define MAX77705_VDM_CMD_ENTER		4
+#define MAX77705_VDM_CMD_DP_CONFIGURE	17
+#define MAX77705_VDM_CT_ACK		1
+
+/* DisplayPort capability VDO (Discover Modes). */
+#define MAX77705_DP_CAP_RECEPTACLE	BIT(6)
+#define MAX77705_DP_PIN_C		BIT(2)
+#define MAX77705_DP_PIN_D		BIT(3)
+#define MAX77705_DP_PIN_E		BIT(4)
+
+/* DisplayPort status VDO (DP Status Update, Attention). */
+#define MAX77705_DP_ST_CONNECTED	(BIT(0) | BIT(1))
+#define MAX77705_DP_ST_MULTI_FUNC	BIT(4)
+#define MAX77705_DP_ST_HPD		BIT(7)
+#define MAX77705_DP_ST_IRQ_HPD		BIT(8)
+
+/* DP Configure VDO: UFP_U as UFP_D, DP 1.3 signalling, pins in bits 15:8. */
+#define MAX77705_DP_CONF_UFP_D		0x02
+#define MAX77705_DP_CONF_DP13		0x04
+
+static inline u32 max77705_le32(const u8 *p)
+{
+	return p[0] | p[1] << 8 | p[2] << 16 | (u32)p[3] << 24;
+}
+
+static inline u32 max77705_vdm_header(const u8 *reply)
+{
+	return max77705_le32(reply + 4);
+}
+
+static inline u16 max77705_vdm_svid(const u8 *reply)
+{
+	return max77705_vdm_header(reply) >> 16;
+}
+
+static inline bool max77705_vdm_acked(const u8 *reply)
+{
+	return ((max77705_vdm_header(reply) >> 6) & 3) == MAX77705_VDM_CT_ACK;
+}
+
+static inline u32 max77705_vdm_vdo(const u8 *reply, unsigned int i)
+{
+	return max77705_le32(reply + 8 + 4 * i);
+}
+
+/* Discover SVIDs: each VDO is a little-endian word holding two SVIDs, the
+ * first in bits 31:16; a zero SVID ends the list.
+ */
+static inline bool max77705_svids_have_dp(const u8 *reply, size_t len)
+{
+	size_t off;
+
+	for (off = 8; off + 3 < len; off += 4) {
+		u32 vdo = max77705_le32(reply + off);
+		u16 svid[2] = { vdo >> 16, vdo & 0xffff };
+		int i;
+
+		for (i = 0; i < 2; i++) {
+			if (!svid[i])
+				return false;
+			if (svid[i] == MAX77705_DP_SVID)
+				return true;
+		}
+	}
+	return false;
+}
+
+/* The pin assignments the partner offers as UFP_D: a receptacle lists them
+ * in the UFP_D field, a captive plug in the DFP_D one.
+ */
+static inline u8 max77705_dp_cap_pins(u32 cap)
+{
+	return cap & MAX77705_DP_CAP_RECEPTACLE ? (cap >> 16) & 0x3f : (cap >> 8) & 0x3f;
+}
+
+/* D (2 DP lanes + USB3) whenever offered: the 6.13 QMP combo PHY cannot
+ * leave its USB3+DP combined mode, so 4-lane C/E is only the fallback for
+ * DP-only adapters.
+ */
+static inline u8 max77705_dp_pick_pin(u8 pins)
+{
+	if (pins & MAX77705_DP_PIN_D)
+		return MAX77705_DP_PIN_D;
+	if (pins & MAX77705_DP_PIN_C)
+		return MAX77705_DP_PIN_C;
+	if (pins & MAX77705_DP_PIN_E)
+		return MAX77705_DP_PIN_E;
+	return 0;
+}
+
+/* SET_VDM_REQ payloads: a count/type byte (VDO count incl. header, ACK
+ * expected), the VDM header, then the VDOs.
+ */
+static inline size_t max77705_encode_discover_identity(u8 *buf)
+{
+	const u8 frame[] = { 0x09, 0x01, 0x80, 0x00, 0xff };
+
+	memcpy(buf, frame, sizeof(frame));
+	return sizeof(frame);
+}
+
+static inline size_t max77705_encode_enter_dp(u8 *buf)
+{
+	const u8 frame[] = { 0x09, 0x04, 0x81, 0x01, 0xff };
+
+	memcpy(buf, frame, sizeof(frame));
+	return sizeof(frame);
+}
+
+static inline size_t max77705_encode_dp_configure(u8 *buf, u8 pin)
+{
+	const u8 frame[] = { 0x0a, 0x11, 0x81, 0x01, 0xff,
+			     MAX77705_DP_CONF_UFP_D | MAX77705_DP_CONF_DP13, pin, 0, 0 };
+
+	memcpy(buf, frame, sizeof(frame));
+	return sizeof(frame);
+}
+
+#endif
--- /dev/null
+++ b/drivers/power/supply/max77705-charge-lease.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MAX77705_CHARGE_LEASE_H
+#define MAX77705_CHARGE_LEASE_H
+
+/* The grant is only valid with a live wired source, fresh acceptable
+ * temperatures and the buck in the expected mode. New grants start in mode 5;
+ * renewals must still find mode 4, so an external mode change revokes the lease.
+ */
+static inline int max77705_lease_can_grant(int active, int mode,
+					    int source_valid, int temperature_valid,
+					    int temperature_paused, int fault,
+					    int pd_transition)
+{
+	return source_valid && temperature_valid && !temperature_paused &&
+		!fault && !pd_transition && mode == (active ? 4 : 5);
+}
+
+/* USB-C STATUS1 VBADC bands (Samsung max77705-muic.h): 2 = 4.5-5.5 V,
+ * 6 = 8.5-9.5 V. A plain fixed 5 V source must sit in band 2. While PPS
+ * state is live, or after PPS was used on this attachment (the firmware
+ * does not refresh the band on the way back down), bands 2..6 are
+ * accepted; 7 and above (over 9.5 V) are never valid on this board.
+ */
+static inline int max77705_vbadc_ok(int band, int pps_busy)
+{
+	return band == 2 || (pps_busy && band >= 2 && band <= 6);
+}
+
+#endif
--- /dev/null
+++ b/drivers/power/supply/max77705-charger-monitor.c
@@ -0,0 +1,2534 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MAX77705 wired-input monitor and conservative input policy for SM-X700.
+ * Register meanings and charger-state mapping follow Samsung's GPL driver.
+ * Provides the fuel gauge's supply relationship and periodic change events.
+ * With fitted NTCs configured, the thermal policy manages charging current
+ * and reduces float voltage to 4150 mV in the WARM zone. Protection settings
+ * are retained.
+ *
+ * This driver is the single owner of the USB-C opcode mailbox: one serialized
+ * command at a time, completion proven by a fresh APCmdResI, and the
+ * read-clear UIC/CC/PD interrupt registers read exactly once per cycle and
+ * routed to both the mailbox and the fault classifier. Capability queries and
+ * bounded PPS requests therefore share one path -- no second sender, and no
+ * need to unbind this driver to talk to the chip.
+ *
+ * PPS requests are bounded by MAX77705_PPS_MAX_*: 5.2 V is deliberately below
+ * anything the switching charger's input stage would object to, because the
+ * SM5440 charge pump is off and all current flows through that buck. Direct
+ * charging uses the separate MAX77705_DC_PPS_* envelope, reachable only by the
+ * SM5440 driver through a charge lease. An active PPS contract is renewed by
+ * this driver and expires on its own.
+ *
+ * Nibble and register conventions are shared with the X800 port's
+ * max77705-otg.c: modes0xe/0xf mean an OTG boost is stacked on the buck, and
+ * CHG_CNFG_02 bits7:6 are that boost's current limit. Charging control here
+ * only ever acts on modes4/5 and only ever writes bits5:0, so an OTG session
+ * makes this driver stand down rather than fight it.
+ *
+ * The same driver also owns that boost for USB host mode, because a second
+ * writer of CHG_CNFG_00 would race the charging policy. CC_STATUS0 decides:
+ * CCStat SOURCE turns the boost on (4 -> 0xe, charging off first) and CCStat
+ * SINK or no connection turns it off (0xe -> 4). The data role follows the
+ * Type-C default (source = host), or the PD DataRole bit once an explicit
+ * contract exists (DR_Swap by docks), and goes to the dwc3 role switch named
+ * by the "connector" child node's graph.
+ *
+ * Two USB-C firmware commands that stock sends are needed for host mode
+ * (verified on X700): SET_ALTERNATEMODE 0x55 = 0x01 (source
+ * capability; without it a sink is seen on CCPinStat but CCStat never becomes
+ * SOURCE), and MUIC CONTROL1 0x06 = 0x09 while host (D+/D- to the AP; in
+ * device mode BC1.2 closes the switch by itself, so the previous value is
+ * restored afterwards).
+ */
+#include <linux/auxiliary_bus.h>
+#include <linux/devm-helpers.h>
+#include <linux/i2c.h>
+#include <linux/iio/consumer.h>
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/power_supply.h>
+#include <linux/property.h>
+#include <linux/usb/role.h>
+#include <linux/usb/typec_altmode.h>
+#include <linux/usb/typec_dp.h>
+#include <linux/usb/typec_mux.h>
+#include <drm/bridge/aux-bridge.h>
+#include <linux/workqueue.h>
+#include "gts8-charging-ntc.h"
+#include "gts8-thermal-policy.h"
+#include "max77705-float-control.h"
+#include "max77705-charge-lease.h"
+#include "max77705-pd-protocol.h"
+#include "max77705-altmode.h"
+
+#define MAX77705_CHG_INT_OK	0xb2
+#define MAX77705_CHG_DETAILS_00	0xb3
+#define MAX77705_CHG_DETAILS_01	0xb4
+#define MAX77705_CHG_DETAILS_02	0xb5
+#define MAX77705_BYP_OTG_OCP		BIT(0)
+#define MAX77705_CHGIN_OK		BIT(6)
+#define MAX77705_CHGIN_VALID	GENMASK(6, 5)
+#define MAX77705_CHG_CNFG_00	0xb7
+#define MAX77705_CHG_CNFG_02	0xb9
+#define MAX77705_OTG_ILIM		GENMASK(7, 6)
+#define MAX77705_OTG_ILIM_900		0x40
+#define MAX77705_CHG_CNFG_04	0xbb
+#define MAX77705_CHG_CNFG_06	0xbd
+#define MAX77705_CHG_CNFG_09	0xc0
+#define MAX77705_BASE_MA		500
+#ifndef MAX77705_MAX_MA
+/* Stock's fixed-PDO budget is 15000 mW at any voltage (battery,
+ * pd_charging_charge_power), so 3000 mA is the ceiling at 5 V and the selected
+ * PDO advertises exactly that. Raised from 2000 once the graduated thermal
+ * policy was in place and a soak at 3000 mA input / 1500 mA FCC held steady.
+ */
+#define MAX77705_MAX_MA		3000
+#endif
+#define MAX77705_POLL_MS		200
+/* Nothing attached and nothing in flight: a plug-in is still seen within 2 s,
+ * and the idle tablet stops doing ~300 I2C transfers a second.
+ */
+#define MAX77705_IDLE_POLL_MS		2000
+#define MAX77705_MB_TIMEOUT_MS	1000
+#define MAX77705_QUERY_MS		5000
+/* Bounded PPS envelope for this stage; see the file comment. */
+#define MAX77705_PPS_MAX_MV	5200
+#define MAX77705_PPS_MAX_MA	1000
+#define MAX77705_PPS_MAX_MW	5200
+#define MAX77705_PPS_RENEW_MS	1600
+#define MAX77705_PPS_LIFE_MS	60000
+#define MAX77705_LEASE_MS	5000
+/* Direct-charge envelope. Only the lease holder can reach it, and only while
+ * the lease holds CHGIN at 500 mA with battery charging off: up to
+ * MAX77705_DC_PPS_MAX_MA - SM5440_DC_CHGIN_MA(500) mA pump share (the
+ * SM5440 side's own SM5440_DC_PUMP_MAX_MA caps it further) plus the 500 mA
+ * buck allowance, at no more than 10 V.
+ *
+ * 5000 mA with SM5440_DC_PUMP_MAX_MA = 4500 is a 5 A request: stock's own
+ * 45 W limit, and the 5 A a compliant source only advertises when its cable
+ * carries it (there is no e-marker check, see sm5440-charger-monitor.c).
+ */
+/* 10 V is stock's request ceiling (see sm5440_dc_pilot.ta_max_mv). The
+ * power cap is 50 W because the SM5440 power check counts only its pump
+ * share (4500 mA): at 10 V the pump share plus the 500 mA buck allowance is
+ * 50 W, and a 45 W cap here refused every step above 9 V. The real draw
+ * stays bounded by the pump's 4.5 A IBUS goal (~9.5 V -> ~43 W) and the
+ * thermal steps.
+ */
+#define MAX77705_DC_PPS_MAX_MV	10000
+#define MAX77705_DC_PPS_MAX_MA	5000
+#define MAX77705_DC_PPS_MAX_MW	50000
+/* A non-fatal PD failure during a leased contract gives the holder this long
+ * to switch its pump off before the source is returned to 5 V anyway: its
+ * detection (one 250-500 ms poll) plus its 2 s pump watchdog plus margin,
+ * still under the 5 s lease.
+ */
+#define MAX77705_PPS_ABORT_MS	3500
+#define MAX77705_FIXED_RECHECK_MS 500
+/* A fixed request not confirmed in this time is re-sent; 3 attempts total. */
+#define MAX77705_FIXED_CONFIRM_MS 3000
+#define MAX77705_FIXED_TRIES	3
+#define MAX77705_AICL_QUIET_MS	5000
+/* CC_STATUS0 CCStat values and the CC_STATUS1 bits that forbid sourcing:
+ * CC/SBU shorts, water, AttachSrcErr.
+ */
+#define MAX77705_CCSTAT_SINK		1
+#define MAX77705_CCSTAT_SOURCE		2
+#define MAX77705_CC_SOURCE_FAULTS	0xc6
+#define MAX77705_PD_STATUS1_DFP		BIT(7)
+#define MAX77705_OP_CTRL1_R		0x05
+#define MAX77705_OP_CTRL1_W		0x06
+#define MAX77705_OP_SET_ALTMODE		0x55
+#define MAX77705_ALTMODE_SRCCAP		0x01
+#define MAX77705_CTRL1_COM_USB		0x09
+#define MAX77705_PORT_RETRY_MS		5000
+
+#ifndef MAX77705_DRIVER_NAME
+#define MAX77705_DRIVER_NAME "max77705-charger-monitor"
+#endif
+
+#ifdef MAX77705_TEST_FCC_OVERRIDE
+/* Runtime-test build only: stage the normal-band FCC above the DT value so a
+ * higher current can be measured on real hardware before it is committed to a
+ * flashed DTB. Never compiled into the native driver, and still clamped by the
+ * same thermal policy and by the charger's own 3150 mA register ceiling.
+ */
+static unsigned int fcc_override_ma;
+module_param(fcc_override_ma, uint, 0644);
+MODULE_PARM_DESC(fcc_override_ma, "test-only normal-band FCC ceiling in mA");
+#endif
+
+/* DisplayPort alternate mode (verified 2026-09-25: 3440x1440 over a USB-C
+ * HDMI hub, pin D with USB3 alongside). VDM discovery is only enabled while
+ * the tablet is USB host: as a sink on a charger the firmware's VDM exchange
+ * drew Reject/Not_Supported replies that withdrew PPS direct-charging leases
+ * The DP HPD bridge is registered either way.
+ */
+static bool dp_altmode = true;
+module_param(dp_altmode, bool, 0444);
+MODULE_PARM_DESC(dp_altmode, "Let the USB-C firmware enter DisplayPort alternate mode");
+
+struct max77705_monitor {
+	struct i2c_client *client;
+	struct i2c_client *usbc;
+	struct power_supply *supply;
+	struct delayed_work poll;
+	unsigned long notify_at;
+	unsigned long query_at;
+	int pd_ma;
+	int ceiling_ma;
+	int last_ma;
+	u8 source;
+	/* Serialized opcode mailbox: at most one command outstanding. */
+	struct {
+		bool busy;
+		u8 opcode;
+		unsigned long deadline;
+	} mb;
+	/* One queued request; the poll issues it when the mailbox frees up. */
+	struct {
+		bool wanted;
+		int step;
+		unsigned int mv;
+		unsigned int ma;
+	} req;
+	bool pps_active;
+	bool pps_enabled;
+	unsigned int pps_pos;
+	unsigned int pps_mv;
+	unsigned int pps_ma;
+	unsigned long pps_renew_at;
+	unsigned long pps_expire_at;
+	int pps_return_step;
+	/* Lease-holder contract state; see max77705_pps_abort(). */
+	bool pps_leased;
+	bool pps_settled;
+	bool pps_aborting;
+	bool fixed_pending;
+	unsigned int fixed_tries;
+	bool pps_stuck;
+	bool pps_used;
+	unsigned int last_invalid;
+	unsigned long aicl_quiet_until;
+	unsigned long pps_stuck_at;
+	unsigned long fixed_deadline;
+	unsigned long pps_abort_at;
+	unsigned int sent_mv;
+	unsigned int sent_ma;
+	unsigned int pps_ok_mv;
+	unsigned int pps_ok_ma;
+	unsigned int pps_pending_ma;
+	bool pps_current_pending;
+	unsigned int lease_req_ma;
+	unsigned int events;
+	unsigned int events_seen;
+	unsigned long error_until;
+	bool ints_drained;
+	bool source_valid;
+	u8 last_sysmsg;
+	u8 last_pdmsg;
+	struct iio_channel *ntc[3];
+	int temperature[3];
+	unsigned long temperature_at;
+	u32 normal_fcc_ua;
+	struct gts8_thermal_state thermal;
+	struct gts8_charge_limit limit;
+	int fcc_ceiling_ma;
+	u8 boot_float_code;
+	bool temperature_valid;
+	bool temperature_paused;
+	bool charge_owned;
+	bool lease_active;
+	bool lease_stopped;
+	unsigned long lease_expires;
+	struct mutex lease_lock;
+	struct mutex pd_lock;
+	struct mutex temperature_lock;
+	struct max77705_pd_caps caps;
+	bool caps_valid;
+	/* USB port: data role and OTG boost; see max77705_port_update(). */
+	struct fwnode_handle *connector;
+	struct usb_role_switch *role_sw;
+	int role;	/* enum usb_role, or -1 before the first set */
+	u8 ccstat;
+	bool otg_on;
+	/* Boost over-current or refusal: stay off until the sink detaches. */
+	bool otg_blocked;
+	int otg_err;
+	/* Firmware port setup; see max77705_port_mailbox(). */
+	bool srccap_done;
+	u8 altmode_sent;	/* last SET_ALTERNATEMODE value accepted */
+	bool switch_host;
+	u8 ctrl1_saved;
+	unsigned long port_retry_at;
+	/* SuperSpeed lane orientation and mode for the redriver, PHY and SBU
+	 * switch named by the connector graph; see max77705_typec_set().
+	 */
+	struct typec_switch *typec_sw;
+	struct typec_mux *typec_mux;
+	bool typec_got;
+	enum typec_orientation orientation;
+	unsigned long mux_mode;
+	/* DisplayPort alternate mode; see max77705_dp_service(). */
+	struct auxiliary_device *hpd_bridge;
+	unsigned int dpv_pending;
+	bool dp_svid;
+	bool dp_identity_seen;
+	unsigned long dp_kick_at;	/* 0: no Discover Identity kick pending */
+	u8 dp_pin;
+	bool dp_enter_wanted;
+	bool dp_entered;
+	bool dp_conf_wanted;
+	bool dp_configured;
+	u32 dp_status;
+	bool hpd;
+};
+
+static void max77705_pps_return(struct max77705_monitor *monitor);
+static int max77705_update_bits(struct i2c_client *client, u8 reg, u8 mask, u8 value);
+static int max77705_input_limit(struct max77705_monitor *monitor, int ma);
+static int max77705_charge_control(struct max77705_monitor *monitor, bool enable, int ma);
+static int max77705_mb_sync(struct max77705_monitor *monitor, u8 opcode,
+			    const u8 *payload, u8 length, u8 *reply, size_t reply_len);
+
+/* Any PPS state at all, including a return still in flight and a fixed 5 V
+ * request whose contract has not been seen yet. While this is true the buck
+ * stays at the 500 mA baseline with battery charging off, whoever holds or
+ * held the lease: switching charging only resumes on a confirmed 5 V.
+ */
+static bool max77705_pps_busy(const struct max77705_monitor *monitor)
+{
+	return monitor->pps_active || monitor->pps_enabled || monitor->pps_return_step ||
+		monitor->req.wanted || monitor->fixed_pending || monitor->pps_aborting;
+}
+
+static void max77705_pps_envelope(const struct max77705_monitor *monitor,
+				  unsigned int *mv, unsigned int *ma, unsigned int *mw)
+{
+	*mv = monitor->pps_leased ? MAX77705_DC_PPS_MAX_MV : MAX77705_PPS_MAX_MV;
+	*ma = monitor->pps_leased ? MAX77705_DC_PPS_MAX_MA : MAX77705_PPS_MAX_MA;
+	*mw = monitor->pps_leased ? MAX77705_DC_PPS_MAX_MW : MAX77705_PPS_MAX_MW;
+}
+
+/* A leased contract may have a charge pump running on it, and dropping VBUS
+ * under a running pump is the one ordering stock forbids outright
+ * (sec_direct_charger.c:515-516). So a non-fatal failure only withdraws the
+ * contract from the holder's view and starts a short grace period; the holder
+ * turns its pump off and asks for 5 V itself, and if it does not, the poll
+ * returns the source when the period ends. Unleased contracts return at once.
+ */
+static void max77705_pps_abort(struct max77705_monitor *monitor, const char *why)
+{
+	if (!monitor->pps_leased) {
+		max77705_pps_return(monitor);
+		return;
+	}
+	monitor->pps_settled = false;
+	monitor->req.wanted = false;
+	if (monitor->pps_aborting)
+		return;
+	monitor->pps_aborting = true;
+	monitor->pps_abort_at = jiffies + msecs_to_jiffies(MAX77705_PPS_ABORT_MS);
+	dev_warn(&monitor->client->dev, "leased PPS contract withdrawn: %s\n", why);
+}
+
+/* Every way a lease ends goes through here. An expiry means the holder went
+ * silent (its pump watchdog is shorter than the lease), so a leased contract
+ * returns at once; a revocation while the holder is alive gets the grace.
+ */
+static void max77705_lease_end(struct max77705_monitor *monitor, bool expired,
+			       const char *why)
+{
+	if (monitor->lease_active)
+		dev_warn(&monitor->client->dev, "switching-charge lease %s\n", why);
+	monitor->lease_active = false;
+	if (!monitor->pps_leased)
+		return;
+	if (expired)
+		max77705_pps_return(monitor);
+	else
+		max77705_pps_abort(monitor, why);
+}
+
+/* The mailbox only runs on a valid sample with PS_RDY set. PPS state that
+ * cannot be serviced for a grace period is first withdrawn from a lease
+ * holder (so its pump stops), then reported as stuck so the caller closes it
+ * synchronously. Returns true when the caller must close it now.
+ */
+static bool max77705_pps_unserviceable(struct max77705_monitor *monitor, bool serviceable)
+{
+	if (serviceable || !max77705_pps_busy(monitor)) {
+		monitor->pps_stuck = false;
+		return false;
+	}
+	if (!monitor->pps_stuck) {
+		monitor->pps_stuck = true;
+		monitor->pps_stuck_at = jiffies + msecs_to_jiffies(MAX77705_PPS_ABORT_MS);
+		return false;
+	}
+	if (time_before(jiffies, monitor->pps_stuck_at))
+		return false;
+	if (monitor->pps_leased && !monitor->pps_aborting) {
+		max77705_lease_end(monitor, false, "revoked: PD not serviceable");
+		monitor->pps_stuck_at = jiffies + msecs_to_jiffies(MAX77705_PPS_ABORT_MS);
+		return false;
+	}
+	monitor->pps_stuck = false;
+	dev_warn(&monitor->client->dev, "PPS state unserviceable, closing synchronously\n");
+	return true;
+}
+
+/* The source is on a fixed 5 V PDO and nothing is pending. */
+static bool max77705_contract_fixed(struct max77705_monitor *monitor)
+{
+	bool fixed;
+
+	if (!monitor->source_valid || max77705_pps_busy(monitor))
+		return false;
+	mutex_lock(&monitor->pd_lock);
+	fixed = monitor->caps_valid &&
+		max77705_pd_fixed_5v(&monitor->caps, monitor->caps.selected) > 0;
+	mutex_unlock(&monitor->pd_lock);
+	return fixed;
+}
+
+/* The contract this driver holds is always fixed 5 V today. When a 9 V fixed
+ * PDO is ever requested this must follow the actual contract, because two of
+ * stock's reduced limits are expressed at 9 V and scale with it.
+ */
+#define MAX77705_CONTRACT_MV 5000
+
+/* A failed sensor read pauses charging. Do not use the stale gauge TEMP.
+ * WARM lowers the float before charging and only resumes below stock's 4000 mV
+ * swelling recharge threshold. Keep the buck on for system power even above
+ * 4150 mV; charging remains off until the cell has fallen sufficiently.
+ */
+static int max77705_temperature(struct max77705_monitor *monitor)
+{
+	const struct gts8_ntc_point *tables[] = {
+		gts8_battery_ntc, gts8_blanket_ntc, gts8_charger_ntc,
+	};
+	struct power_supply *gauge;
+	union power_supply_propval vbat;
+	int raw, temp[3], i, ret, zone, ceiling, target_code, vbat_uv = 0;
+	bool allowed;
+
+	if (!monitor->normal_fcc_ua)
+		return 0;
+	if (time_before(jiffies, monitor->temperature_at))
+		return monitor->temperature_valid && !monitor->temperature_paused ? 0 : -ERANGE;
+	monitor->temperature_at = jiffies + msecs_to_jiffies(1000);
+	monitor->temperature_valid = false;
+	for (i = 0; i < ARRAY_SIZE(tables); i++) {
+		ret = iio_read_channel_raw(monitor->ntc[i], &raw);
+		if (ret < 0 || !gts8_ntc_temperature(tables[i],
+				ARRAY_SIZE(gts8_battery_ntc), raw, &temp[i])) {
+			monitor->temperature_paused = true;
+			return ret < 0 ? ret : -ERANGE;
+		}
+	}
+	for (i = 0; i < ARRAY_SIZE(tables); i++)
+		WRITE_ONCE(monitor->temperature[i], temp[i]);
+	monitor->temperature_valid = true;
+	zone = monitor->thermal.zone;
+	ceiling = monitor->normal_fcc_ua / 1000;
+#ifdef MAX77705_TEST_FCC_OVERRIDE
+	if (fcc_override_ma >= 100 && fcc_override_ma <= 3150)
+		ceiling = fcc_override_ma - fcc_override_ma % 50;
+#endif
+	monitor->fcc_ceiling_ma = ceiling;
+	allowed = gts8_thermal_step(&monitor->thermal, temp[0], temp[1], temp[2],
+				    MAX77705_CONTRACT_MV, ceiling, &monitor->limit);
+	if (monitor->limit.zone == GTS8_ZONE_WARM) {
+		gauge = power_supply_get_by_name("max170xx_battery");
+		if (gauge) {
+			ret = power_supply_get_property(gauge, POWER_SUPPLY_PROP_VOLTAGE_NOW, &vbat);
+			power_supply_put(gauge);
+			if (!ret)
+				vbat_uv = vbat.intval;
+		}
+	}
+	if (!max77705_float_target(monitor->boot_float_code,
+		monitor->limit.zone, vbat_uv, &target_code))
+		allowed = false;
+	/* A failed write or readback must prevent charging. Retain the lower
+	 * setting on sensor errors; only a valid non-WARM sample restores boot FV.
+	 */
+	ret = max77705_update_bits(monitor->client, MAX77705_CHG_CNFG_04,
+				   0x3f, target_code);
+	if (ret) {
+		monitor->temperature_paused = true;
+		return ret;
+	}
+	if (monitor->thermal.zone != zone)
+		dev_info(&monitor->client->dev,
+			 "thermal zone %d -> %d: battery %d, blanket %d, charger %d (0.1 C)\n",
+			 zone, monitor->thermal.zone, temp[0], temp[1], temp[2]);
+	if (monitor->temperature_paused == allowed)
+		dev_info(&monitor->client->dev,
+			 "charging %s: zone %d, FCC %d mA, thermal ICL %d mA\n",
+			 allowed ? "resumed" : "paused", monitor->limit.zone,
+			 monitor->limit.fcc_ma, monitor->limit.icl_ma);
+	monitor->temperature_paused = !allowed;
+	return allowed ? 0 : -ERANGE;
+}
+
+static int max77705_update_bits(struct i2c_client *client, u8 reg, u8 mask, u8 value)
+{
+	int old, ret;
+
+	old = i2c_smbus_read_byte_data(client, reg);
+	if (old < 0)
+		return old;
+	value = (old & ~mask) | (value & mask);
+	if (old == value)
+		return 0;
+	ret = i2c_smbus_write_byte_data(client, reg, value);
+	if (ret < 0)
+		return ret;
+	ret = i2c_smbus_read_byte_data(client, reg);
+	return ret < 0 ? ret : ret == value ? 0 : -EIO;
+}
+
+/* Preserve boost/OTG limits and all upper mode bits. Only manage the known
+ * wired buck states 4/5. A reverse/OTG/unknown mode is never overwritten.
+ */
+static int max77705_charge_control(struct max77705_monitor *monitor, bool enable, int ma)
+{
+	int mode, ret;
+
+	if (!monitor->charge_owned)
+		return 0;
+	mode = i2c_smbus_read_byte_data(monitor->client, MAX77705_CHG_CNFG_00);
+	if (mode < 0)
+		return mode;
+	if ((mode & 0x0f) != 4 && (mode & 0x0f) != 5)
+		return -EPERM;
+	if (!enable) {
+		ret = max77705_update_bits(monitor->client, MAX77705_CHG_CNFG_00, 1, 0);
+		if (ret)
+			return ret;
+	}
+	ma = enable ? min_t(int, ma, monitor->limit.fcc_ma ? : 100) : 100;
+	ret = max77705_update_bits(monitor->client, MAX77705_CHG_CNFG_02, 0x3f, ma / 50);
+	if (ret) {
+		max77705_update_bits(monitor->client, MAX77705_CHG_CNFG_00, 1, 0);
+		return ret;
+	}
+	return enable ? max77705_update_bits(monitor->client, MAX77705_CHG_CNFG_00, 1, 1) : 0;
+}
+
+/* Samsung's mode table: the boost stacks on the buck (4 -> 0xe) and comes
+ * back to 4; the poll's charge control restores mode 5 itself. Mode 0 and so
+ * 0xa are never used, because probe and charge control need the buck up.
+ */
+static int max77705_otg_set(struct max77705_monitor *monitor, bool enable)
+{
+	int mode, ok, ret;
+
+	mode = i2c_smbus_read_byte_data(monitor->client, MAX77705_CHG_CNFG_00);
+	if (mode < 0)
+		return mode;
+	if (!enable) {
+		monitor->otg_on = false;
+		if ((mode & 0x0f) != 0x0e && (mode & 0x0f) != 0x0f)
+			return 0;
+		ret = max77705_update_bits(monitor->client, MAX77705_CHG_CNFG_00, 0x0f,
+					   (mode & 0x0f) == 0x0f ? 5 : 4);
+		if (!ret)
+			dev_info(&monitor->client->dev, "OTG VBUS off\n");
+		else
+			monitor->otg_on = true;
+		return ret;
+	}
+	if ((mode & 0x0f) == 0x0e || (mode & 0x0f) == 0x0f) {
+		monitor->otg_on = true;
+		return 0;
+	}
+	/* The boost drives the pins CHGIN feeds from: never against a source. */
+	ok = i2c_smbus_read_byte_data(monitor->client, MAX77705_CHG_INT_OK);
+	if (ok < 0)
+		return ok;
+	if (ok & MAX77705_CHGIN_OK)
+		return -EBUSY;
+	if ((mode & 0x0f) != 4 && (mode & 0x0f) != 5)
+		return -EPERM;
+	if ((mode & 0x0f) == 5 && monitor->charge_owned) {
+		ret = max77705_update_bits(monitor->client, MAX77705_CHG_CNFG_00, 1, 0);
+		if (ret)
+			return ret;
+		mode &= ~1;
+	}
+	ret = max77705_update_bits(monitor->client, MAX77705_CHG_CNFG_02,
+				   MAX77705_OTG_ILIM, MAX77705_OTG_ILIM_900);
+	if (ret)
+		return ret;
+	ret = max77705_update_bits(monitor->client, MAX77705_CHG_CNFG_00, 0x0f,
+				   (mode & 0x0f) | 0x0a);
+	if (ret)
+		return ret;
+	monitor->otg_on = true;
+	dev_info(&monitor->client->dev, "OTG VBUS on (900 mA limit)\n");
+	return 0;
+}
+
+static void max77705_role_set(struct max77705_monitor *monitor, enum usb_role role)
+{
+	struct usb_role_switch *sw;
+	int ret;
+
+	if (!monitor->role_sw && monitor->connector) {
+		/* Looked up lazily so charging never waits for dwc3. */
+		sw = fwnode_usb_role_switch_get(monitor->connector);
+		if (IS_ERR_OR_NULL(sw))
+			return;
+		monitor->role_sw = sw;
+		monitor->role = -1;
+	}
+	if (!monitor->role_sw || role == monitor->role)
+		return;
+	ret = usb_role_switch_set_role(monitor->role_sw, role);
+	if (ret) {
+		dev_err_ratelimited(&monitor->client->dev, "USB role %s failed: %d\n",
+				    usb_role_string(role), ret);
+		return;
+	}
+	monitor->role = role;
+	dev_info(&monitor->client->dev, "USB data role %s\n", usb_role_string(role));
+}
+
+/* The connector graph names the lane switches: the PS5169 redriver (which
+ * forwards to the QMP PHY) on port@1 and the SBU/AUX switch on port@2. Looked
+ * up lazily, like the role switch, until the redriver has probed.
+ */
+static void max77705_typec_get(struct max77705_monitor *monitor)
+{
+	struct typec_switch *sw;
+	struct typec_mux *mux;
+
+	if (monitor->typec_got || !monitor->connector)
+		return;
+	sw = fwnode_typec_switch_get(monitor->connector);
+	if (IS_ERR(sw))
+		return;
+	mux = fwnode_typec_mux_get(monitor->connector);
+	if (IS_ERR(mux)) {
+		typec_switch_put(sw);
+		return;
+	}
+	monitor->typec_sw = sw;
+	monitor->typec_mux = mux;
+	monitor->typec_got = true;
+	monitor->orientation = TYPEC_ORIENTATION_NONE;
+	monitor->mux_mode = TYPEC_STATE_SAFE;
+}
+
+static void max77705_typec_set(struct max77705_monitor *monitor,
+			       enum typec_orientation orientation, unsigned long mode)
+{
+	static struct typec_altmode dp_alt = {
+		.svid = USB_TYPEC_DP_SID,
+		.mode = USB_TYPEC_DP_MODE,
+	};
+	struct typec_displayport_data dp_data = {};
+	struct typec_mux_state state = {};
+	int ret;
+
+	max77705_typec_get(monitor);
+	if (!monitor->typec_got)
+		return;
+	/* Orientation first: the PHY lanes must be right before a mode that
+	 * routes signals through the redriver.
+	 */
+	if (orientation != monitor->orientation) {
+		ret = typec_switch_set(monitor->typec_sw, orientation);
+		if (ret) {
+			dev_warn_ratelimited(&monitor->client->dev,
+					     "Type-C orientation %d failed: %d\n", orientation, ret);
+			return;
+		}
+		dev_info(&monitor->client->dev, "Type-C orientation %s\n",
+			 orientation == TYPEC_ORIENTATION_NORMAL ? "normal (CC1)" :
+			 orientation == TYPEC_ORIENTATION_REVERSE ? "reverse (CC2)" : "none");
+		monitor->orientation = orientation;
+	}
+	if (mode == monitor->mux_mode)
+		return;
+	state.mode = mode;
+	if (mode >= TYPEC_STATE_MODAL) {
+		dp_data.status = monitor->dp_status;
+		dp_data.conf = MAX77705_DP_CONF_UFP_D | MAX77705_DP_CONF_DP13 |
+			       monitor->dp_pin << 8;
+		state.alt = &dp_alt;
+		state.data = &dp_data;
+	}
+	ret = typec_mux_set(monitor->typec_mux, &state);
+	if (ret) {
+		dev_warn_ratelimited(&monitor->client->dev,
+				     "Type-C mode %lu failed: %d\n", mode, ret);
+		return;
+	}
+	monitor->mux_mode = mode;
+}
+
+/* HPD is reported only once the lanes are in a DP mode, so the DP controller
+ * never trains a link the redriver is not passing through yet.
+ */
+static void max77705_dp_hpd(struct max77705_monitor *monitor)
+{
+	bool hpd = monitor->dp_configured && monitor->mux_mode >= TYPEC_STATE_MODAL &&
+		   (monitor->dp_status & MAX77705_DP_ST_HPD);
+
+	if (hpd == monitor->hpd)
+		return;
+	monitor->hpd = hpd;
+	dev_info(&monitor->client->dev, "DP HPD %s\n", hpd ? "high" : "low");
+	if (monitor->hpd_bridge)
+		drm_aux_hpd_bridge_notify(&monitor->hpd_bridge->dev,
+					  hpd ? connector_status_connected :
+						connector_status_disconnected);
+}
+
+static void max77705_dp_reset(struct max77705_monitor *monitor)
+{
+	monitor->dpv_pending = 0;
+	monitor->dp_svid = false;
+	monitor->dp_identity_seen = false;
+	monitor->dp_kick_at = 0;
+	monitor->dp_pin = 0;
+	monitor->dp_enter_wanted = false;
+	monitor->dp_entered = false;
+	monitor->dp_conf_wanted = false;
+	monitor->dp_configured = false;
+	monitor->dp_status = 0;
+	max77705_dp_hpd(monitor);
+}
+
+static unsigned long max77705_dp_mode(const struct max77705_monitor *monitor)
+{
+	if (!monitor->dp_configured)
+		return TYPEC_STATE_USB;
+	if (monitor->dp_pin == MAX77705_DP_PIN_D)
+		return TYPEC_DP_STATE_D;
+	if (monitor->dp_pin == MAX77705_DP_PIN_E)
+		return TYPEC_DP_STATE_E;
+	return TYPEC_DP_STATE_C;
+}
+
+static void max77705_dp_vdm(struct max77705_monitor *monitor, u8 id,
+			    const u8 *reply, size_t len)
+{
+	struct device *dev = &monitor->client->dev;
+	bool dp = max77705_vdm_svid(reply) == MAX77705_DP_SVID;
+	u32 vdo = max77705_vdm_vdo(reply, 0);
+	u8 pins;
+
+	switch (id) {
+	case MAX77705_VDM_ID_IDENTITY:
+		monitor->dp_identity_seen = true;
+		dev_info(dev, "USB-C partner %04x:%04x\n", vdo & 0xffff,
+			 max77705_vdm_vdo(reply, 2) >> 16);
+		break;
+	case MAX77705_VDM_ID_SVIDS:
+		monitor->dp_svid = max77705_svids_have_dp(reply, len);
+		dev_info(dev, "USB-C partner %s DisplayPort\n",
+			 monitor->dp_svid ? "offers" : "does not offer");
+		break;
+	case MAX77705_VDM_ID_MODES:
+		/* Discovery may run twice (firmware and our kick): enter once. */
+		if (!dp || !monitor->dp_svid || !max77705_vdm_acked(reply) ||
+		    monitor->dp_entered || monitor->dp_enter_wanted)
+			break;
+		pins = max77705_dp_cap_pins(vdo);
+		monitor->dp_pin = max77705_dp_pick_pin(pins);
+		dev_info(dev, "DP capabilities 0x%08x, pins 0x%02x, using 0x%02x\n",
+			 vdo, pins, monitor->dp_pin);
+		monitor->dp_enter_wanted = monitor->dp_pin != 0;
+		break;
+	case MAX77705_VDM_ID_ENTER:
+		if (!dp || monitor->dp_entered)
+			break;
+		monitor->dp_entered = max77705_vdm_acked(reply);
+		dev_info(dev, "DP Enter Mode %s\n", monitor->dp_entered ? "ACK" : "refused");
+		break;
+	case MAX77705_VDM_ID_DP_STATUS:
+	case MAX77705_VDM_ID_ATTENTION:
+		if (!dp)
+			break;
+		monitor->dp_status = vdo;
+		dev_info(dev, "DP status 0x%08x%s\n", vdo,
+			 vdo & MAX77705_DP_ST_IRQ_HPD ? " (IRQ_HPD, not forwarded)" : "");
+		if (monitor->dp_entered && !monitor->dp_configured &&
+		    (vdo & MAX77705_DP_ST_CONNECTED))
+			monitor->dp_conf_wanted = true;
+		break;
+	case MAX77705_VDM_ID_DP_CONFIGURE:
+		if (!dp)
+			break;
+		monitor->dp_configured = max77705_vdm_acked(reply);
+		dev_info(dev, "DP Configure pin 0x%02x %s\n", monitor->dp_pin,
+			 monitor->dp_configured ? "ACK" : "refused");
+		break;
+	}
+}
+
+/* One DP alternate mode mailbox command per poll, after the port setup:
+ * read the VDMs the firmware flagged, then send Enter Mode / DP Configure.
+ */
+static void max77705_dp_service(struct max77705_monitor *monitor)
+{
+	u8 reply[32], frame[16], id;
+	unsigned int i;
+	size_t len;
+	int ret;
+
+	if (!(monitor->altmode_sent & MAX77705_ALTMODE_VDM) || monitor->mb.busy ||
+	    time_before(jiffies, monitor->port_retry_at))
+		return;
+	for (i = 0; i < MAX77705_DPV_COUNT; i++) {
+		if (!(monitor->dpv_pending & BIT(i)))
+			continue;
+		monitor->dpv_pending &= ~BIT(i);
+		id = max77705_dpv_ids[i];
+		ret = max77705_mb_sync(monitor, MAX77705_OP_GET_VDM_RESP, &id, 1,
+				       reply, sizeof(reply));
+		if (ret || reply[1] != id) {
+			dev_warn(&monitor->client->dev, "VDM 0x%02x read failed: %d\n", id, ret);
+			return;
+		}
+		dev_dbg(&monitor->client->dev, "VDM 0x%02x: %*ph\n", id,
+			 (int)sizeof(reply), reply);
+		max77705_dp_vdm(monitor, id, reply, sizeof(reply));
+		return;
+	}
+	/* VDM enabled after the contract was set up (a dock powering the
+	 * tablet): the firmware may not start discovery by itself, so ask for
+	 * the partner's identity as stock does for a sink DFP.
+	 */
+	if (monitor->dp_kick_at && time_after_eq(jiffies, monitor->dp_kick_at)) {
+		monitor->dp_kick_at = 0;
+		if (monitor->dp_identity_seen)
+			return;
+		len = max77705_encode_discover_identity(frame);
+	} else if (monitor->dp_enter_wanted) {
+		monitor->dp_enter_wanted = false;
+		len = max77705_encode_enter_dp(frame);
+	} else if (monitor->dp_conf_wanted) {
+		monitor->dp_conf_wanted = false;
+		len = max77705_encode_dp_configure(frame, monitor->dp_pin);
+	} else {
+		return;
+	}
+	ret = max77705_mb_sync(monitor, MAX77705_OP_SET_VDM_REQ, frame, len, reply, 2);
+	if (ret)
+		dev_warn(&monitor->client->dev, "VDM request 0x%02x failed: %d\n",
+			 frame[1], ret);
+}
+
+/* Called once per poll with the same register snapshot as the charging
+ * policy. Host: VBUS first, then the role. Anything else: role first.
+ */
+static void max77705_port_update(struct max77705_monitor *monitor, int cc,
+				 int fault, int pd)
+{
+	u8 ccstat = cc & 7;
+	enum usb_role role = USB_ROLE_NONE;
+	bool dfp = ccstat == MAX77705_CCSTAT_SOURCE, want;
+	int ret, dtls, pin;
+
+	if (ccstat != monitor->ccstat) {
+		dev_info(&monitor->client->dev, "CC state %u -> %u (pin %u)\n",
+			 monitor->ccstat, ccstat, (cc >> 6) & 3);
+		monitor->ccstat = ccstat;
+		monitor->otg_blocked = false;
+	}
+	if (ccstat == MAX77705_CCSTAT_SINK || ccstat == MAX77705_CCSTAT_SOURCE) {
+		if (pd & MAX77705_PD_STATUS1_PSRDY)
+			dfp = pd & MAX77705_PD_STATUS1_DFP;
+		role = dfp ? USB_ROLE_HOST : USB_ROLE_DEVICE;
+	}
+	if (monitor->otg_on) {
+		dtls = i2c_smbus_read_byte_data(monitor->client, MAX77705_CHG_DETAILS_02);
+		if (dtls >= 0 && (dtls & MAX77705_BYP_OTG_OCP)) {
+			dev_warn(&monitor->client->dev,
+				 "OTG boost over-current (DETAILS_02=0x%02x), VBUS off until detach\n",
+				 dtls);
+			monitor->otg_blocked = true;
+		}
+	}
+	want = ccstat == MAX77705_CCSTAT_SOURCE && !monitor->otg_blocked &&
+	       !(fault & MAX77705_CC_SOURCE_FAULTS);
+	if (ccstat == MAX77705_CCSTAT_SINK || ccstat == MAX77705_CCSTAT_SOURCE) {
+		pin = (cc >> 6) & 3;
+		max77705_typec_set(monitor, pin == 1 ? TYPEC_ORIENTATION_NORMAL :
+					    pin == 2 ? TYPEC_ORIENTATION_REVERSE :
+						       TYPEC_ORIENTATION_NONE,
+				   max77705_dp_mode(monitor));
+	} else {
+		max77705_dp_reset(monitor);
+		max77705_typec_set(monitor, TYPEC_ORIENTATION_NONE, TYPEC_STATE_SAFE);
+	}
+	max77705_dp_hpd(monitor);
+	if (role != USB_ROLE_HOST)
+		max77705_role_set(monitor, role);
+	if (want != monitor->otg_on) {
+		ret = max77705_otg_set(monitor, want);
+		if (ret && ret != monitor->otg_err)
+			dev_warn(&monitor->client->dev, "OTG VBUS %s refused: %d\n",
+				 want ? "on" : "off", ret);
+		/* A refused enable is not retried every 200 ms. */
+		if (ret && want)
+			monitor->otg_blocked = true;
+		monitor->otg_err = ret;
+	}
+	if (role == USB_ROLE_HOST)
+		max77705_role_set(monitor, role);
+}
+
+/* Blocking commands are only sent with no PD command outstanding; they read
+ * UIC_INT themselves, which costs at most the events of those few ms.
+ */
+static void max77705_port_mailbox(struct max77705_monitor *monitor)
+{
+	bool host = monitor->role == USB_ROLE_HOST;
+	u8 reply[2], data;
+	int ret;
+
+	if (monitor->mb.busy || time_before(jiffies, monitor->port_retry_at))
+		return;
+	data = MAX77705_ALTMODE_SRCCAP |
+	       (dp_altmode && host ? MAX77705_ALTMODE_VDM : 0);
+	if (!monitor->srccap_done || data != monitor->altmode_sent) {
+		ret = max77705_mb_sync(monitor, MAX77705_OP_SET_ALTMODE, &data, 1,
+				       reply, sizeof(reply));
+		if (ret)
+			goto retry;
+		monitor->srccap_done = true;
+		monitor->altmode_sent = data;
+		if (data & MAX77705_ALTMODE_VDM)
+			monitor->dp_kick_at = jiffies + msecs_to_jiffies(1500);
+		dev_info(&monitor->client->dev, "USB-C alternate modes 0x%02x (reply 0x%02x)\n",
+			 data, reply[1]);
+	}
+	if (host == monitor->switch_host)
+		return;
+	if (host) {
+		ret = max77705_mb_sync(monitor, MAX77705_OP_CTRL1_R, NULL, 0,
+				       reply, sizeof(reply));
+		if (ret)
+			goto retry;
+		monitor->ctrl1_saved = reply[1];
+		data = MAX77705_CTRL1_COM_USB;
+	} else {
+		data = monitor->ctrl1_saved;
+	}
+	ret = max77705_mb_sync(monitor, MAX77705_OP_CTRL1_W, &data, 1,
+			       reply, sizeof(reply));
+	if (ret)
+		goto retry;
+	monitor->switch_host = host;
+	dev_info(&monitor->client->dev, "D+/D- switch 0x%02x (%s)\n", data,
+		 host ? "host" : "restored");
+	return;
+retry:
+	dev_warn(&monitor->client->dev, "USB-C port command failed: %d, retrying\n", ret);
+	monitor->port_retry_at = jiffies + msecs_to_jiffies(MAX77705_PORT_RETRY_MS);
+}
+
+static void max77705_port_stop(struct max77705_monitor *monitor)
+{
+	max77705_role_set(monitor, USB_ROLE_NONE);
+	monitor->port_retry_at = 0;
+	max77705_port_mailbox(monitor);
+	if (max77705_otg_set(monitor, false))
+		dev_err(&monitor->client->dev, "cannot switch OTG VBUS off\n");
+	monitor->ccstat = 0;
+	monitor->otg_blocked = false;
+	max77705_dp_reset(monitor);
+	max77705_typec_set(monitor, TYPEC_ORIENTATION_NONE, TYPEC_STATE_SAFE);
+}
+
+static ssize_t usb_port_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct max77705_monitor *monitor = dev_get_drvdata(dev);
+	ssize_t ret;
+
+	mutex_lock(&monitor->lease_lock);
+	ret = sysfs_emit(buf, "ccstat=%u role=%s switch=%s otg=%d blocked=%d err=%d\n",
+			 monitor->ccstat,
+			 monitor->role_sw ? usb_role_string(monitor->role) : "-",
+			 monitor->role_sw ? "found" : monitor->connector ? "pending" : "none",
+			 monitor->otg_on, monitor->otg_blocked, monitor->otg_err);
+	mutex_unlock(&monitor->lease_lock);
+	return ret;
+}
+static DEVICE_ATTR_RO(usb_port);
+
+static struct attribute *max77705_port_attrs[] = {
+	&dev_attr_usb_port.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(max77705_port);
+
+static void max77705_port_release(void *data)
+{
+	struct max77705_monitor *monitor = data;
+
+	usb_role_switch_put(monitor->role_sw);
+	typec_mux_put(monitor->typec_mux);
+	typec_switch_put(monitor->typec_sw);
+	fwnode_handle_put(monitor->connector);
+}
+
+static ssize_t temperatures_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct max77705_monitor *monitor = dev_get_drvdata(dev);
+	ssize_t ret;
+
+	mutex_lock(&monitor->temperature_lock);
+	ret = monitor->temperature_valid ? sysfs_emit(buf,
+			  "battery=%d blanket=%d charger=%d (0.1 C) zone=%d mix=%d chg=%d fcc=%d mA icl=%d mA\n",
+			  READ_ONCE(monitor->temperature[0]), READ_ONCE(monitor->temperature[1]),
+			  READ_ONCE(monitor->temperature[2]), monitor->limit.zone,
+			  monitor->thermal.mix_limit, monitor->thermal.chg_limit,
+			  monitor->limit.fcc_ma, monitor->limit.icl_ma) : -ENODATA;
+	mutex_unlock(&monitor->temperature_lock);
+	return ret;
+}
+static DEVICE_ATTR_RO(temperatures);
+
+static ssize_t pd_capabilities_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct max77705_monitor *monitor = dev_get_drvdata(dev);
+	unsigned int i;
+	ssize_t length;
+
+	mutex_lock(&monitor->pd_lock);
+	if (!monitor->caps_valid) {
+		mutex_unlock(&monitor->pd_lock);
+		return -ENODATA;
+	}
+	length = sysfs_emit(buf, "selected=%u count=%u source PDOs:", monitor->caps.selected, monitor->caps.count);
+	for (i = 0; i < monitor->caps.count; i++)
+		length += sysfs_emit_at(buf, length, " %08x", monitor->caps.pdo[i]);
+	length += sysfs_emit_at(buf, length, "\n");
+	mutex_unlock(&monitor->pd_lock);
+	return length;
+}
+static DEVICE_ATTR_RO(pd_capabilities);
+
+/* Bounded request entry point, root-only. "fixed" returns the source to its
+ * fixed 5 V PDO; "pps <mV> <mA>" asks for an adjustable voltage inside
+ * MAX77705_PPS_MAX_*. The request is queued for the one serialized mailbox
+ * rather than issued here, is renewed by the poll, and expires by itself after
+ * MAX77705_PPS_LIFE_MS -- there is no way to leave the source held indefinitely.
+ */
+static ssize_t pd_request_store(struct device *dev, struct device_attribute *attr,
+				const char *buf, size_t count)
+{
+	struct max77705_monitor *monitor = dev_get_drvdata(dev);
+	struct max77705_pd_caps caps;
+	unsigned int mv, ma;
+	u8 payload[4];
+	bool valid;
+
+	ssize_t ret = count;
+
+	if (sysfs_streq(buf, "fixed")) {
+		mutex_lock(&monitor->lease_lock);
+		/* A leased contract may have a pump on it; only its holder
+		 * (or the lease machinery) closes it.
+		 */
+		if (monitor->pps_leased || monitor->lease_active)
+			ret = -EBUSY;
+		else
+			max77705_pps_return(monitor);
+		mutex_unlock(&monitor->lease_lock);
+		return ret;
+	}
+	if (sscanf(buf, "pps %u %u", &mv, &ma) != 2)
+		return -EINVAL;
+	mutex_lock(&monitor->temperature_lock);
+	valid = monitor->temperature_valid && !monitor->temperature_paused;
+	mutex_unlock(&monitor->temperature_lock);
+	if (!valid)
+		return -EBUSY;
+	mutex_lock(&monitor->lease_lock);
+	/* The manual path never touches a direct-charge session. */
+	if (monitor->lease_active || monitor->pps_leased || monitor->pps_aborting) {
+		ret = -EBUSY;
+		goto out;
+	}
+	if (monitor->events & (MAX77705_EVT_ERROR | MAX77705_EVT_WATER)) {
+		ret = -EIO;
+		goto out;
+	}
+	mutex_lock(&monitor->pd_lock);
+	caps = monitor->caps;
+	valid = monitor->caps_valid;
+	mutex_unlock(&monitor->pd_lock);
+	/* Validate against the live source capabilities and this board's
+	 * envelope before anything is queued.
+	 */
+	if (!valid || !max77705_pd_find_pps(&caps, mv, ma, MAX77705_PPS_MAX_MV,
+					    MAX77705_PPS_MAX_MA, MAX77705_PPS_MAX_MW,
+					    payload)) {
+		ret = -ERANGE;
+		goto out;
+	}
+	monitor->req.step = 0;
+	monitor->req.mv = mv;
+	monitor->req.ma = ma;
+	monitor->pps_mv = mv;
+	monitor->pps_ma = ma;
+	monitor->pps_expire_at = jiffies + msecs_to_jiffies(MAX77705_PPS_LIFE_MS);
+	monitor->req.wanted = true;
+out:
+	mutex_unlock(&monitor->lease_lock);
+	return ret;
+}
+static DEVICE_ATTR_WO(pd_request);
+
+static ssize_t pd_state_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct max77705_monitor *monitor = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf,
+		"mailbox=%s opcode=0x%02x pps=%s(fw=%d) apdo=%u req_step=%d requested=%u mV/%u mA return_step=%d events=0x%02x seen=0x%02x sysmsg=0x%02x pdmsg=0x%02x lease=%d leased=%d settled=%d accepted=%u mV aborting=%d fixed_pending=%d wanted=%d busy=%d used=%d invalid=0x%03x source_valid=%d pd_ma=%d ceiling=%d error_hold=%d\n",
+		monitor->mb.busy ? "busy" : "idle", monitor->mb.opcode,
+		monitor->pps_active ? "active" : "off", monitor->pps_enabled,
+		monitor->pps_pos, monitor->req.step,
+		monitor->pps_mv, monitor->pps_ma, monitor->pps_return_step,
+		monitor->events, monitor->events_seen, monitor->last_sysmsg,
+		monitor->last_pdmsg, monitor->lease_active, monitor->pps_leased,
+		monitor->pps_settled, monitor->pps_ok_mv, monitor->pps_aborting,
+		monitor->fixed_pending, monitor->req.wanted, max77705_pps_busy(monitor),
+		monitor->pps_used,
+		monitor->last_invalid, monitor->source_valid, monitor->pd_ma,
+		monitor->ceiling_ma, !!monitor->error_until);
+}
+static DEVICE_ATTR_RO(pd_state);
+
+static struct attribute *max77705_temperature_attrs[] = {
+	&dev_attr_temperatures.attr,
+	&dev_attr_pd_capabilities.attr,
+	&dev_attr_pd_request.attr,
+	&dev_attr_pd_state.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(max77705_temperature);
+
+static enum power_supply_property max77705_monitor_props[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_CHARGE_TYPE,
+	POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+	POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT,
+	POWER_SUPPLY_PROP_USB_TYPE,
+	POWER_SUPPLY_PROP_HEALTH,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_CURRENT_MAX,
+};
+
+static int max77705_monitor_get_property(struct power_supply *supply,
+		enum power_supply_property prop, union power_supply_propval *val)
+{
+	struct max77705_monitor *monitor = power_supply_get_drvdata(supply);
+	int status, details;
+
+	switch (prop) {
+	case POWER_SUPPLY_PROP_CHARGE_TYPE:
+		mutex_lock(&monitor->lease_lock);
+		status = i2c_smbus_read_byte_data(monitor->client, MAX77705_CHG_CNFG_00);
+		if (status >= 0)
+			val->intval = monitor->lease_active &&
+				!time_after_eq(jiffies, monitor->lease_expires) &&
+				(status & 0x0f) == 4 ? POWER_SUPPLY_CHARGE_TYPE_NONE :
+				POWER_SUPPLY_CHARGE_TYPE_STANDARD;
+		mutex_unlock(&monitor->lease_lock);
+		return status < 0 ? status : 0;
+	/* Lease-holder view of the contract: the last accepted APDO voltage
+	 * once the source has confirmed it, 5 V on a settled fixed PDO, and 0
+	 * for anything in between or withdrawn.
+	 */
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		mutex_lock(&monitor->lease_lock);
+		if (monitor->pps_active && monitor->pps_settled && !monitor->pps_aborting &&
+		    !monitor->pps_return_step)
+			val->intval = monitor->pps_ok_mv * 1000;
+		else
+			val->intval = max77705_contract_fixed(monitor) ? 5000000 : 0;
+		mutex_unlock(&monitor->lease_lock);
+		return 0;
+	case POWER_SUPPLY_PROP_CURRENT_MAX:
+		mutex_lock(&monitor->lease_lock);
+		if (monitor->pps_active && monitor->pps_settled &&
+		    !monitor->pps_current_pending &&
+		    !monitor->pps_aborting && !monitor->pps_return_step)
+			val->intval = monitor->pps_ok_ma * 1000;
+		else if (monitor->lease_active || monitor->pps_leased ||
+			 monitor->pps_aborting || monitor->pps_return_step)
+			val->intval = 0;
+		else
+			val->intval = monitor->pd_ma * 1000;
+		mutex_unlock(&monitor->lease_lock);
+		return 0;
+	/* GOOD only in the normal zone with no thermal reduction latched: the
+	 * direct-charge pilot runs nowhere else.
+	 */
+	case POWER_SUPPLY_PROP_HEALTH:
+		mutex_lock(&monitor->temperature_lock);
+		if (!monitor->normal_fcc_ua || !monitor->temperature_valid)
+			val->intval = POWER_SUPPLY_HEALTH_UNKNOWN;
+		else if (monitor->limit.zone >= GTS8_ZONE_OVERHEAT)
+			val->intval = POWER_SUPPLY_HEALTH_OVERHEAT;
+		else if (monitor->limit.zone == GTS8_ZONE_WARM)
+			val->intval = POWER_SUPPLY_HEALTH_WARM;
+		else if (monitor->limit.zone == GTS8_ZONE_COLD)
+			val->intval = POWER_SUPPLY_HEALTH_COLD;
+		else if (monitor->limit.zone < GTS8_ZONE_NORMAL)
+			val->intval = POWER_SUPPLY_HEALTH_COOL;
+		else if (monitor->temperature_paused)
+			val->intval = POWER_SUPPLY_HEALTH_UNSPEC_FAILURE;
+		else if (monitor->limit.icl_ma || monitor->thermal.mix_limit ||
+			 monitor->thermal.chg_limit)
+			val->intval = POWER_SUPPLY_HEALTH_WARM;
+		else
+			val->intval = POWER_SUPPLY_HEALTH_GOOD;
+		mutex_unlock(&monitor->temperature_lock);
+		return 0;
+	case POWER_SUPPLY_PROP_USB_TYPE:
+		val->intval = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+		mutex_lock(&monitor->pd_lock);
+		if (monitor->caps_valid) {
+			u32 pdo = monitor->caps.pdo[monitor->caps.selected - 1];
+			val->intval = pdo >> 30 == 3 && !((pdo >> 28) & 3) ?
+				POWER_SUPPLY_USB_TYPE_PD_PPS : POWER_SUPPLY_USB_TYPE_PD;
+		}
+		mutex_unlock(&monitor->pd_lock);
+		return 0;
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		status = i2c_smbus_read_byte_data(monitor->client, MAX77705_CHG_CNFG_09);
+		if (status < 0)
+			return status;
+		status &= 0x7f;
+		val->intval = (status <= 3 ? 100 : (status + 1) * 25) * 1000;
+		return 0;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+		status = i2c_smbus_read_byte_data(monitor->client, MAX77705_CHG_CNFG_02);
+		if (status < 0)
+			return status;
+		status &= 0x3f;
+		val->intval = (status <= 2 ? 100 : status * 50) * 1000;
+		return 0;
+	case POWER_SUPPLY_PROP_ONLINE:
+		status = i2c_smbus_read_byte_data(monitor->client, MAX77705_CHG_INT_OK);
+		if (status < 0)
+			return status;
+		details = i2c_smbus_read_byte_data(monitor->client, MAX77705_CHG_DETAILS_00);
+		if (details < 0)
+			return details;
+		val->intval = !!(status & MAX77705_CHGIN_OK) &&
+			(details & MAX77705_CHGIN_VALID) == MAX77705_CHGIN_VALID;
+		return 0;
+	case POWER_SUPPLY_PROP_STATUS:
+		status = i2c_smbus_read_byte_data(monitor->client, MAX77705_CHG_DETAILS_01);
+		if (status < 0)
+			return status;
+		switch (status & 0x0f) {
+		case 0: case 1: case 2:
+			val->intval = POWER_SUPPLY_STATUS_CHARGING;
+			break;
+		case 3: case 4:
+			val->intval = POWER_SUPPLY_STATUS_FULL;
+			break;
+		case 5: case 6: case 7:
+			val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
+			break;
+		case 8: case 10: case 11:
+			val->intval = POWER_SUPPLY_STATUS_DISCHARGING;
+			break;
+		default:
+			val->intval = POWER_SUPPLY_STATUS_UNKNOWN;
+		}
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+/* Queue a PPS operating point for the lease holder. Called with lease_lock
+ * held and the lease verified. The same capability search as pd_request,
+ * against the direct-charge envelope.
+ */
+static int max77705_lease_request(struct max77705_monitor *monitor, unsigned int mv,
+				  unsigned int ma)
+{
+	struct max77705_pd_caps caps;
+	u8 payload[4];
+	bool valid;
+
+	if (monitor->pps_aborting || monitor->pps_return_step || monitor->fixed_pending)
+		return -EAGAIN;
+	if (monitor->pps_active && !monitor->pps_leased)
+		return -EBUSY;
+	mutex_lock(&monitor->pd_lock);
+	caps = monitor->caps;
+	valid = monitor->caps_valid;
+	mutex_unlock(&monitor->pd_lock);
+	if (!valid)
+		return -EAGAIN;
+	if (!max77705_pd_find_pps(&caps, mv, ma, MAX77705_DC_PPS_MAX_MV,
+				  MAX77705_DC_PPS_MAX_MA, MAX77705_DC_PPS_MAX_MW, payload))
+		return -ERANGE;
+	monitor->pps_leased = true;
+	monitor->req.step = 0;
+	monitor->req.mv = mv;
+	monitor->req.ma = ma;
+	monitor->pps_mv = mv;
+	monitor->pps_ma = ma;
+	monitor->req.wanted = true;
+	return 0;
+}
+
+/* Private handoff convention for the SM5440 direct-charge client:
+ *  CHARGE_TYPE  NONE      yield battery charging (buck stays up in mode 4,
+ *                         CHGIN 500 mA); repeating it renews a 5 s lease
+ *               STANDARD  release; normal charging resumes once any PPS
+ *                         state has returned to a confirmed fixed 5 V
+ *  CURRENT_MAX  uA        operating current for the next VOLTAGE_NOW write
+ *  VOLTAGE_NOW  uV        5000000 returns to fixed 5 V and is always
+ *                         accepted; anything else needs the lease and is
+ *                         bounded by MAX77705_DC_PPS_MAX_*
+ * Reads of VOLTAGE_NOW report the settled contract (see get_property).
+ */
+static int max77705_monitor_set_property(struct power_supply *supply,
+		enum power_supply_property prop, const union power_supply_propval *val)
+{
+	struct max77705_monitor *monitor = power_supply_get_drvdata(supply);
+	int mode, ret = 0;
+	bool wake = false;
+
+	switch (prop) {
+	case POWER_SUPPLY_PROP_CHARGE_TYPE:
+		if (val->intval != POWER_SUPPLY_CHARGE_TYPE_NONE &&
+		    val->intval != POWER_SUPPLY_CHARGE_TYPE_STANDARD)
+			return -EINVAL;
+		break;
+	case POWER_SUPPLY_PROP_CURRENT_MAX:
+		if (val->intval < 50000 || val->intval > MAX77705_DC_PPS_MAX_MA * 1000 ||
+		    val->intval % 50000)
+			return -ERANGE;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		if (val->intval != 5000000 &&
+		    (val->intval < MAX77705_PPS_DEFAULT_MV * 1000 ||
+		     val->intval > MAX77705_DC_PPS_MAX_MV * 1000 || val->intval % 20000))
+			return -ERANGE;
+		break;
+	default:
+		return -EINVAL;
+	}
+	mutex_lock(&monitor->lease_lock);
+	if (monitor->lease_stopped) {
+		ret = -ESHUTDOWN;
+		goto out;
+	}
+	if (prop == POWER_SUPPLY_PROP_VOLTAGE_NOW && val->intval == 5000000) {
+		max77705_pps_return(monitor);
+		wake = true;
+		goto out;
+	}
+	if (monitor->lease_active &&
+	    time_after_eq(jiffies, monitor->lease_expires)) {
+		max77705_lease_end(monitor, true, "expired");
+		wake = true;
+	}
+	if (prop == POWER_SUPPLY_PROP_CHARGE_TYPE &&
+	    val->intval == POWER_SUPPLY_CHARGE_TYPE_STANDARD) {
+		/* Releasing never hands a leased contract to the manual path:
+		 * whatever PPS state is left goes back to 5 V.
+		 */
+		monitor->lease_active = false;
+		if (monitor->pps_leased)
+			max77705_pps_return(monitor);
+		wake = true;
+		goto out;
+	}
+	if (prop != POWER_SUPPLY_PROP_CHARGE_TYPE) {
+		if (!monitor->lease_active) {
+			ret = -EPERM;
+		} else if (prop == POWER_SUPPLY_PROP_CURRENT_MAX) {
+			monitor->lease_req_ma = val->intval / 1000;
+		} else if (!monitor->lease_req_ma) {
+			ret = -EINVAL;
+		} else {
+			ret = max77705_lease_request(monitor, val->intval / 1000,
+						     monitor->lease_req_ma);
+			wake = !ret;
+		}
+		goto out;
+	}
+	if (!monitor->charge_owned) {
+		ret = -EPERM;
+		goto out;
+	}
+	mode = i2c_smbus_read_byte_data(monitor->client, MAX77705_CHG_CNFG_00);
+	if (mode < 0) {
+		ret = mode;
+		goto out;
+	}
+	/* A first grant needs a quiet PD state. A renewal does not look at
+	 * PPS state at all: the holder is the one changing it.
+	 */
+	if (!max77705_lease_can_grant(monitor->lease_active, mode & 0x0f,
+			monitor->source_valid, monitor->temperature_valid,
+			monitor->temperature_paused,
+			monitor->events & (MAX77705_EVT_ERROR | MAX77705_EVT_HARD_RESET |
+					   MAX77705_EVT_WATER) || monitor->error_until,
+			!monitor->lease_active && max77705_pps_busy(monitor))) {
+		ret = -EAGAIN;
+		goto out;
+	}
+	if (!monitor->lease_active) {
+		ret = max77705_charge_control(monitor, false, 100);
+		if (ret)
+			goto out;
+		mode = i2c_smbus_read_byte_data(monitor->client, MAX77705_CHG_CNFG_00);
+		if (mode < 0 || (mode & 0x0f) != 4) {
+			ret = mode < 0 ? mode : -EIO;
+			goto out;
+		}
+		monitor->lease_active = true;
+	}
+	ret = max77705_input_limit(monitor, MAX77705_BASE_MA);
+	if (ret) {
+		monitor->lease_active = false;
+		goto out;
+	}
+	monitor->lease_expires = jiffies + msecs_to_jiffies(MAX77705_LEASE_MS);
+out:
+	mutex_unlock(&monitor->lease_lock);
+	if (ret != -ESHUTDOWN && (ret || wake))
+		mod_delayed_work(system_wq, &monitor->poll, 0);
+	return ret;
+}
+
+/* No property_is_writeable: the handoff properties are for the in-kernel
+ * SM5440 client only (power_supply_set_property does not consult it), so a
+ * root shell cannot drop the voltage or release the lease under a pump.
+ */
+
+static const struct power_supply_desc max77705_monitor_desc = {
+	.name = "max77705_usb",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.usb_types = BIT(POWER_SUPPLY_USB_TYPE_UNKNOWN) | BIT(POWER_SUPPLY_USB_TYPE_PD) |
+		     BIT(POWER_SUPPLY_USB_TYPE_PD_PPS),
+	.properties = max77705_monitor_props,
+	.num_properties = ARRAY_SIZE(max77705_monitor_props),
+	.get_property = max77705_monitor_get_property,
+	.set_property = max77705_monitor_set_property,
+};
+
+static int max77705_input_limit(struct max77705_monitor *monitor, int ma)
+{
+	int old, ret, value;
+
+	ma = clamp(ma, MAX77705_BASE_MA, MAX77705_MAX_MA);
+	old = i2c_smbus_read_byte_data(monitor->client, MAX77705_CHG_CNFG_09);
+	if (old < 0)
+		return old;
+	value = (old & 0x80) | (ma / 25 - 1);
+	if (old != value) {
+		ret = i2c_smbus_write_byte_data(monitor->client,
+				MAX77705_CHG_CNFG_09, value);
+		if (ret < 0)
+			return ret;
+		ret = i2c_smbus_read_byte_data(monitor->client, MAX77705_CHG_CNFG_09);
+		if (ret < 0)
+			return ret;
+		if (ret != value)
+			return -EIO;
+	}
+	if (monitor->last_ma != ma) {
+		monitor->last_ma = ma;
+		if (ma == MAX77705_BASE_MA || ma == MAX77705_MAX_MA)
+			dev_info(&monitor->client->dev, "CHGIN input limit %d mA\n", ma);
+	}
+	return 0;
+}
+
+/* Mailbox transport. Samsung writes the opcode at 0x21 with its payload
+ * following, then the terminator 0 at 0x41; replies start at 0x51. The
+ * caller has already read (and thereby cleared) UIC_INT this cycle, so any
+ * APCmdResI seen from here on belongs to this command and not an older one.
+ */
+static int max77705_mb_send(struct max77705_monitor *monitor, u8 opcode,
+			    const u8 *payload, u8 length)
+{
+	u8 frame[16];
+	int ret;
+
+	if (monitor->mb.busy)
+		return -EBUSY;
+	if (length > sizeof(frame) - 1)
+		return -EINVAL;
+	if (length) {
+		frame[0] = opcode;
+		memcpy(frame + 1, payload, length);
+		ret = i2c_smbus_write_i2c_block_data(monitor->usbc,
+				MAX77705_REG_OPCODE, length + 1, frame);
+	} else {
+		ret = i2c_smbus_write_byte_data(monitor->usbc,
+				MAX77705_REG_OPCODE, opcode);
+	}
+	if (ret < 0)
+		return ret;
+	ret = i2c_smbus_write_byte_data(monitor->usbc, MAX77705_REG_OPCODE_END, 0);
+	if (ret < 0)
+		return ret;
+	monitor->mb.busy = true;
+	monitor->mb.opcode = opcode;
+	monitor->mb.deadline = jiffies + msecs_to_jiffies(MAX77705_MB_TIMEOUT_MS);
+	return 0;
+}
+
+static void max77705_pd_invalidate(struct max77705_monitor *monitor)
+{
+	monitor->pd_ma = 0;
+	mutex_lock(&monitor->pd_lock);
+	monitor->caps_valid = false;
+	mutex_unlock(&monitor->pd_lock);
+}
+
+/* Returning to a plain fixed 5 V contract takes two commands: disable PPS,
+ * then request the fixed PDO. Never leave the source on an unrenewed APDO.
+ */
+static void max77705_pps_return(struct max77705_monitor *monitor)
+{
+	/* pps_enabled matters as much as pps_active here: if SET_PPS succeeded
+	 * but the APDO request never went out -- mailbox timeout, capabilities
+	 * invalidated, a fault event -- the firmware is left with PPS enabled
+	 * and no contract, and only this disable clears it.
+	 */
+	if (monitor->pps_active || monitor->pps_enabled || monitor->pps_return_step ||
+	    monitor->req.step)
+		monitor->pps_return_step = 1;
+	monitor->fixed_tries = 0;
+	monitor->pps_active = false;
+	monitor->pps_settled = false;
+	monitor->pps_leased = false;
+	monitor->pps_aborting = false;
+	monitor->req.wanted = false;
+	monitor->req.step = 0;
+}
+
+static void max77705_mb_complete(struct max77705_monitor *monitor,
+				 const u8 *data, unsigned int length)
+{
+	struct max77705_pd_caps caps;
+	int ma;
+
+	switch (monitor->mb.opcode) {
+	case MAX77705_PD_CURRENT_SRCCAP:
+		if (!max77705_pd_decode_caps(data, length, &caps)) {
+			max77705_pd_invalidate(monitor);
+			return;
+		}
+		mutex_lock(&monitor->pd_lock);
+		monitor->caps = caps;
+		monitor->caps_valid = true;
+		mutex_unlock(&monitor->pd_lock);
+		/* An APDO is selected during a PPS contract, so there is no
+		 * fixed 5 V allowance to report; say nothing rather than
+		 * announcing a 0 mA cap.
+		 */
+		ma = min_t(int, max77705_pd_fixed_5v(&caps, caps.selected), MAX77705_MAX_MA);
+		if (ma != monitor->pd_ma && !monitor->pps_active)
+			dev_info(&monitor->client->dev,
+				 "selected PDO %u of %u permits %d mA fixed 5 V input cap\n",
+				 caps.selected, caps.count, ma);
+		monitor->pd_ma = ma;
+		/* A settled PPS contract shows up as the APDO being the
+		 * selected object; anything else means it did not take.
+		 */
+		/* An APDO selected with no request of ours is firmware PPS left
+		 * enabled (earlier session, reboot, detach): disable it and go
+		 * back to the fixed PDO.
+		 */
+		if (!monitor->pps_active && !monitor->req.wanted && !monitor->req.step &&
+		    !monitor->pps_return_step && caps.pdo[caps.selected - 1] >> 30 == 3) {
+			dev_warn(&monitor->client->dev,
+				 "APDO %u selected without a request; disabling firmware PPS\n",
+				 caps.selected);
+			monitor->pps_enabled = true;
+			max77705_pps_return(monitor);
+		}
+		if (monitor->pps_active && caps.selected != monitor->pps_pos) {
+			dev_warn(&monitor->client->dev,
+				 "PPS contract not settled: selected PDO %u, expected APDO %u\n",
+				 caps.selected, monitor->pps_pos);
+			max77705_pps_abort(monitor, "contract not settled");
+		} else if (monitor->pps_active) {
+			monitor->pps_settled = true;
+			/* A retarget remains on the same APDO. Publish its current
+			 * only after this fresh selected-object query ran with PS_RDY.
+			 */
+			if (monitor->pps_pending_ma) {
+				monitor->pps_ok_ma = monitor->pps_pending_ma;
+				monitor->pps_pending_ma = 0;
+				monitor->pps_current_pending = false;
+			}
+		}
+		/* A fixed request is only finished once the source says so;
+		 * until then keep asking at a short interval.
+		 */
+		if (monitor->fixed_pending) {
+			if (!monitor->pps_active && ma > 0) {
+				/* The disable went out before the fixed request;
+				 * a fixed contract settles the firmware flag too.
+				 */
+				monitor->fixed_pending = false;
+				monitor->pps_enabled = false;
+				monitor->fixed_tries = 0;
+			} else if (time_after_eq(jiffies, monitor->fixed_deadline) &&
+				   ++monitor->fixed_tries < MAX77705_FIXED_TRIES) {
+				dev_warn(&monitor->client->dev,
+					 "fixed 5 V not confirmed, retrying (%u)\n",
+					 monitor->fixed_tries);
+				monitor->fixed_pending = false;
+				monitor->pps_return_step = 1;
+			} else if (monitor->fixed_tries >= MAX77705_FIXED_TRIES) {
+				/* Give up waiting; the VBUS band gate still resets
+				 * to the 500 mA baseline if VBUS is not near 5 V.
+				 */
+				dev_err(&monitor->client->dev,
+					"fixed 5 V never confirmed (selected PDO %u)\n",
+					caps.selected);
+				monitor->fixed_pending = false;
+				monitor->pps_enabled = false;
+				monitor->fixed_tries = 0;
+			} else {
+				monitor->query_at = jiffies +
+					msecs_to_jiffies(MAX77705_FIXED_RECHECK_MS);
+			}
+		}
+		return;
+	case MAX77705_PD_SET_PPS:
+		/* Response bit0 reports the firmware's PPS flag. Stock does not
+		 * wait for it before requesting an APDO -- the contract is
+		 * established by the APDO request and confirmed by the selected
+		 * object -- so this is recorded, not used as a gate.
+		 */
+		monitor->pps_enabled = length >= 2 && (data[1] & 1);
+		if (monitor->req.wanted && monitor->req.step == 1)
+			monitor->req.step = 2;
+		return;
+	case MAX77705_PD_PPS_REQUEST:
+		/* Result 0 means the request was sent, not that a contract
+		 * settled. The selected object and PS_RDY confirm that.
+		 */
+		if (length < 2 || data[1]) {
+			dev_warn(&monitor->client->dev, "APDO request rejected (0x%02x)\n",
+				 length < 2 ? 0xff : data[1]);
+			max77705_pps_abort(monitor, "APDO request rejected");
+			return;
+		}
+		/* A return or abort that started while this request was in
+		 * flight wins; reviving pps_active here would make the renewal
+		 * path re-request the APDO the return is closing.
+		 */
+		if (monitor->pps_aborting || monitor->pps_return_step)
+			return;
+		/* Settled means the APDO was seen as the selected object; a
+		 * retarget within it keeps that, and the holder checks the
+		 * delivered voltage on its own ADC.
+		 */
+		monitor->pps_ok_mv = monitor->sent_mv;
+		monitor->pps_pending_ma = monitor->sent_ma;
+		monitor->pps_active = true;
+		/* USBC_STATUS1 VBADC is not refreshed after the source steps back
+		 * down: measured 0x4 (6.5-7.5 V) at a real 5.04 V after an 8.2 V
+		 * APDO, until a replug (2026-09-16). From here until a detach
+		 * the band is only bounded, and a raised input limit still
+		 * needs a confirmed fixed 5 V PDO (pd_ma).
+		 */
+		monitor->pps_used = true;
+		dev_info(&monitor->client->dev, "PPS APDO %u accepted at %u mV / %u mA%s\n",
+			 monitor->pps_pos, monitor->sent_mv, monitor->sent_ma,
+			 monitor->pps_leased ? " (leased)" : "");
+		monitor->pps_renew_at = jiffies + msecs_to_jiffies(MAX77705_PPS_RENEW_MS);
+		monitor->query_at = jiffies;
+		return;
+	case MAX77705_PD_FIXED_REQUEST:
+		if (length < 2 || data[1])
+			dev_warn(&monitor->client->dev, "fixed PDO request rejected\n");
+		monitor->query_at = jiffies;
+		return;
+	default:
+		return;
+	}
+}
+
+/* One mailbox step per poll cycle. uic is this cycle's already-read UIC_INT. */
+static void max77705_mb_service(struct max77705_monitor *monitor, int uic)
+{
+	u8 data[32], payload[4];
+	struct max77705_pd_caps caps;
+	unsigned int mv, ma, mw, pos;
+	int ret;
+
+	if (monitor->mb.busy) {
+		if (uic & MAX77705_UIC_APCMDRES) {
+			ret = i2c_smbus_read_i2c_block_data(monitor->usbc,
+					MAX77705_REG_OPCODE_RES, sizeof(data), data);
+			monitor->mb.busy = false;
+			if (ret != sizeof(data) || data[0] != monitor->mb.opcode) {
+				dev_warn(&monitor->client->dev,
+					 "mailbox reply mismatch for opcode 0x%02x\n",
+					 monitor->mb.opcode);
+				max77705_pd_invalidate(monitor);
+				return;
+			}
+			max77705_mb_complete(monitor, data, sizeof(data));
+			return;
+		}
+		if (time_after(jiffies, monitor->mb.deadline)) {
+			dev_warn(&monitor->client->dev, "mailbox timeout on opcode 0x%02x\n",
+				 monitor->mb.opcode);
+			monitor->mb.busy = false;
+			max77705_pd_invalidate(monitor);
+			max77705_pps_abort(monitor, "mailbox timeout");
+		}
+		return;
+	}
+
+	/* The holder did not close a withdrawn contract in time. */
+	if (monitor->pps_aborting && time_after_eq(jiffies, monitor->pps_abort_at)) {
+		dev_warn(&monitor->client->dev, "PPS abort grace elapsed, returning to fixed 5 V\n");
+		max77705_pps_return(monitor);
+	}
+
+	/* Returning to fixed 5 V outranks everything else. */
+	if (monitor->pps_return_step == 1) {
+		ret = max77705_pd_encode_set_pps(false, 0, 0, payload);
+		if (ret && !max77705_mb_send(monitor, MAX77705_PD_SET_PPS, payload, ret))
+			monitor->pps_return_step = 2;
+		return;
+	}
+	if (monitor->pps_return_step == 2) {
+		mutex_lock(&monitor->pd_lock);
+		caps = monitor->caps;
+		ret = monitor->caps_valid;
+		mutex_unlock(&monitor->pd_lock);
+		/* Without valid capabilities there is no position to name; the
+		 * source falls back on its own once PPS is off.
+		 */
+		if (!ret || !max77705_pd_encode_fixed(&caps, 1, payload)) {
+			monitor->pps_return_step = 0;
+			monitor->fixed_pending = true;
+			monitor->fixed_deadline = jiffies +
+				msecs_to_jiffies(MAX77705_FIXED_CONFIRM_MS);
+			monitor->query_at = jiffies;
+			return;
+		}
+		if (!max77705_mb_send(monitor, MAX77705_PD_FIXED_REQUEST, payload, 1)) {
+			monitor->pps_return_step = 0;
+			monitor->fixed_pending = true;
+			monitor->fixed_deadline = jiffies +
+				msecs_to_jiffies(MAX77705_FIXED_CONFIRM_MS);
+		}
+		return;
+	}
+
+	if (monitor->req.wanted && !monitor->pps_aborting) {
+		/* Stock order: enable PPS at its 5 V/1 A default, then request
+		 * the APDO carrying the real target. The enable is fire and
+		 * forget; only the APDO result decides whether this worked.
+		 */
+		if (monitor->req.step == 0) {
+			/* Stock skips the enable when PPS is already on
+			 * (bPPS_on == enable), so retargeting a live contract
+			 * goes straight to the APDO instead of bouncing the
+			 * source through the 5 V default first.
+			 */
+			if (monitor->pps_active) {
+				monitor->req.step = 2;
+			} else {
+				ret = max77705_pd_encode_set_pps(true, MAX77705_PPS_DEFAULT_MV,
+						MAX77705_PPS_DEFAULT_MA, payload);
+				if (ret && !max77705_mb_send(monitor, MAX77705_PD_SET_PPS,
+							     payload, ret))
+					monitor->req.step = 1;
+				return;
+			}
+		}
+		if (monitor->req.step != 2)
+			return;
+		mutex_lock(&monitor->pd_lock);
+		caps = monitor->caps;
+		ret = monitor->caps_valid;
+		mutex_unlock(&monitor->pd_lock);
+		monitor->req.wanted = false;
+		monitor->req.step = 0;
+		max77705_pps_envelope(monitor, &mv, &ma, &mw);
+		pos = ret ? max77705_pd_find_pps(&caps, monitor->req.mv,
+						 monitor->req.ma, mv, ma, mw, payload) : 0;
+		/* A retarget must stay on the APDO that was confirmed. */
+		if (pos && (!monitor->pps_active || pos == monitor->pps_pos)) {
+			monitor->pps_pos = pos;
+			monitor->sent_mv = monitor->req.mv;
+			monitor->sent_ma = monitor->req.ma;
+			monitor->pps_current_pending =
+				monitor->sent_ma != monitor->pps_ok_ma;
+			if (max77705_mb_send(monitor, MAX77705_PD_PPS_REQUEST, payload, 4))
+				max77705_pps_abort(monitor, "APDO request not sent");
+		} else {
+			max77705_pps_abort(monitor, ret ? "no APDO fits the request" :
+					   "no source capabilities");
+		}
+		return;
+	}
+
+	/* An accepted PPS contract must be renewed well inside the 10 s PD
+	 * limit, and expires by itself so no experiment can outlive its window.
+	 * A leased contract's window is the lease itself.
+	 */
+	if (monitor->pps_active) {
+		if (!monitor->pps_leased &&
+		    time_after_eq(jiffies, monitor->pps_expire_at)) {
+			dev_info(&monitor->client->dev, "PPS window elapsed, returning to fixed 5 V\n");
+			max77705_pps_return(monitor);
+			return;
+		}
+		if (time_after_eq(jiffies, monitor->pps_renew_at)) {
+			mutex_lock(&monitor->pd_lock);
+			caps = monitor->caps;
+			ret = monitor->caps_valid;
+			mutex_unlock(&monitor->pd_lock);
+			max77705_pps_envelope(monitor, &mv, &ma, &mw);
+			/* Renew the voltage the source last accepted. */
+			if (ret && max77705_pd_find_pps(&caps, monitor->pps_ok_mv,
+					monitor->pps_ma, mv, ma, mw,
+					payload) == monitor->pps_pos && monitor->pps_pos) {
+				monitor->sent_mv = monitor->pps_ok_mv;
+				monitor->sent_ma = monitor->pps_ma;
+				if (max77705_mb_send(monitor, MAX77705_PD_PPS_REQUEST, payload, 4))
+					max77705_pps_abort(monitor, "renewal not sent");
+			} else {
+				max77705_pps_abort(monitor, "renewal no longer valid");
+			}
+			return;
+		}
+	}
+
+	if (time_after_eq(jiffies, monitor->query_at)) {
+		monitor->query_at = jiffies + msecs_to_jiffies(MAX77705_QUERY_MS);
+		if (max77705_mb_send(monitor, MAX77705_PD_CURRENT_SRCCAP, NULL, 0))
+			max77705_pd_invalidate(monitor);
+	}
+}
+
+/* Classify this cycle's read-clear interrupt registers. Status registers are
+ * only read when their interrupt says there is something new to read.
+ */
+static unsigned int max77705_typec_events(struct max77705_monitor *monitor,
+					  int uic, int cc_int, int pd_int, int cc_status)
+{
+	unsigned int events;
+	int value;
+
+	/* UIC/CC/PD interrupts are read-clear and nothing read them before this
+	 * driver bound, so the first snapshot is an accumulated history --
+	 * attach errors and CC transitions from the whole session so far.
+	 * Report it and start judging from the next cycle.
+	 */
+	if (!monitor->ints_drained) {
+		monitor->ints_drained = true;
+		if (uic || cc_int || pd_int)
+			dev_info(&monitor->usbc->dev,
+				 "drained inherited interrupts UIC=0x%02x CC=0x%02x PD=0x%02x\n",
+				 uic, cc_int, pd_int);
+		return 0;
+	}
+	events = max77705_classify_cc(cc_int, cc_status);
+	if (uic & MAX77705_UIC_SYSMSG) {
+		value = i2c_smbus_read_byte_data(monitor->usbc, MAX77705_REG_USBC_STATUS2);
+		if (value < 0)
+			return events | MAX77705_EVT_ERROR;
+		monitor->last_sysmsg = value;
+		events |= max77705_classify_sysmsg(value);
+		/* BOOT_WDT/SWRSTREQ/POR: the firmware forgot the port setup. */
+		if (value >= 0x03 && value <= 0x05) {
+			monitor->srccap_done = false;
+			monitor->switch_host = false;
+		}
+		/* Anything that fails, errors or ends a lease is logged with
+		 * the mailbox and PPS state, so a dropped direct-charge session
+		 * names its cause (dynamic debug is off in this kernel).
+		 */
+		if (max77705_classify_sysmsg(value) & (MAX77705_EVT_ERROR | MAX77705_EVT_CMD_FAIL))
+			dev_info(&monitor->usbc->dev,
+				 "SYSMsg 0x%02x (mailbox %s op 0x%02x, requested %u mV/%u mA, pps %d)\n",
+				 value, monitor->mb.busy ? "busy" : "idle", monitor->mb.opcode,
+				 monitor->req.mv, monitor->req.ma, monitor->pps_active);
+		else if (value)
+			dev_dbg(&monitor->usbc->dev, "SYSMsg 0x%02x\n", value);
+	}
+	if (pd_int & MAX77705_PD_INT_PDMSG) {
+		value = i2c_smbus_read_byte_data(monitor->usbc, MAX77705_REG_PD_STATUS0);
+		if (value < 0)
+			return events | MAX77705_EVT_ERROR;
+		monitor->last_pdmsg = value;
+		events |= max77705_classify_pdmsg(value);
+		if (value == 0x13 ||
+		    (max77705_classify_pdmsg(value) &
+		     (MAX77705_EVT_ERROR | MAX77705_EVT_CMD_FAIL | MAX77705_EVT_REJECTED)))
+			dev_info(&monitor->usbc->dev,
+				 "PDMsg 0x%02x (mailbox %s op 0x%02x, requested %u mV/%u mA, pps %d)\n",
+				 value, monitor->mb.busy ? "busy" : "idle", monitor->mb.opcode,
+				 monitor->req.mv, monitor->req.ma, monitor->pps_active);
+		else if (value)
+			dev_dbg(&monitor->usbc->dev, "PDMsg 0x%02x\n", value);
+	}
+	return events;
+}
+
+#define MAX77705_ERROR_HOLD_MS	10000
+
+static void max77705_handle_events(struct max77705_monitor *monitor, unsigned int events)
+{
+	if (!events)
+		return;
+	monitor->events |= events;
+	monitor->events_seen |= events;
+	if (events & (MAX77705_EVT_ERROR | MAX77705_EVT_HARD_RESET | MAX77705_EVT_WATER))
+		dev_warn(&monitor->client->dev,
+			 "Type-C fault events 0x%02x (SYSMsg 0x%02x, PDMsg 0x%02x)\n",
+			 events, monitor->last_sysmsg, monitor->last_pdmsg);
+	/* A source in error is not holding the voltage for anyone, so that
+	 * returns at once; a refused or failed command leaves the contract
+	 * standing and gives a lease holder its grace period.
+	 */
+	if (events & MAX77705_EVT_ERROR)
+		max77705_pps_return(monitor);
+	else if (events & (MAX77705_EVT_CMD_FAIL | MAX77705_EVT_REJECTED))
+		max77705_pps_abort(monitor, "PD command failed or rejected");
+	if (events & MAX77705_EVT_ERROR) {
+		/* Back off to the baseline while the fault is fresh, then let
+		 * the normal ramp recover. Holding the ceiling down for the
+		 * rest of the session would strand a healthy tablet at 500 mA
+		 * over one transient event.
+		 */
+		monitor->ceiling_ma = MAX77705_BASE_MA;
+		monitor->error_until = jiffies + msecs_to_jiffies(MAX77705_ERROR_HOLD_MS);
+		max77705_pd_invalidate(monitor);
+	}
+	if (events & MAX77705_EVT_RENEGOTIATE) {
+		max77705_pd_invalidate(monitor);
+		monitor->query_at = jiffies;
+	}
+}
+
+/* Blocking variant for the unbind/suspend paths, where the poll work is gone
+ * but an accepted PPS contract must not be left unrenewed: an APDO the source
+ * stops hearing about ends in a source-side reset, not a graceful fallback.
+ */
+static int max77705_mb_sync(struct max77705_monitor *monitor, u8 opcode,
+			    const u8 *payload, u8 length, u8 *reply, size_t reply_len)
+{
+	int uic, ret, i;
+
+	uic = i2c_smbus_read_byte_data(monitor->usbc, MAX77705_REG_UIC_INT);
+	if (uic < 0)
+		return uic;
+	monitor->mb.busy = false;
+	ret = max77705_mb_send(monitor, opcode, payload, length);
+	if (ret)
+		return ret;
+	for (i = 0; i < 100; i++) {
+		usleep_range(10000, 11000);
+		uic = i2c_smbus_read_byte_data(monitor->usbc, MAX77705_REG_UIC_INT);
+		if (uic < 0) {
+			monitor->mb.busy = false;
+			return uic;
+		}
+		if (uic & MAX77705_UIC_APCMDRES)
+			break;
+	}
+	monitor->mb.busy = false;
+	if (i == 100)
+		return -ETIMEDOUT;
+	ret = i2c_smbus_read_i2c_block_data(monitor->usbc, MAX77705_REG_OPCODE_RES,
+					    reply_len, reply);
+	if (ret != (int)reply_len)
+		return ret < 0 ? ret : -EIO;
+	return reply[0] == opcode ? 0 : -EPROTO;
+}
+
+static void max77705_pps_shutdown(struct max77705_monitor *monitor)
+{
+	struct max77705_pd_caps caps;
+	u8 payload[4], reply[32];
+	bool valid;
+	int ret;
+
+	if (!max77705_pps_busy(monitor))
+		return;
+	ret = max77705_pd_encode_set_pps(false, 0, 0, payload);
+	if (ret) {
+		ret = max77705_mb_sync(monitor, MAX77705_PD_SET_PPS, payload, ret,
+				       reply, sizeof(reply));
+		if (ret)
+			dev_warn(&monitor->client->dev, "PPS disable failed: %d\n", ret);
+	}
+	mutex_lock(&monitor->pd_lock);
+	caps = monitor->caps;
+	valid = monitor->caps_valid;
+	mutex_unlock(&monitor->pd_lock);
+	if (valid && max77705_pd_encode_fixed(&caps, 1, payload)) {
+		ret = max77705_mb_sync(monitor, MAX77705_PD_FIXED_REQUEST, payload, 1,
+				       reply, sizeof(reply));
+		if (ret)
+			dev_warn(&monitor->client->dev, "fixed 5 V return failed: %d\n", ret);
+	}
+	monitor->pps_active = false;
+	monitor->pps_enabled = false;
+	monitor->pps_return_step = 0;
+	monitor->req.wanted = false;
+	monitor->req.step = 0;
+	monitor->pps_leased = false;
+	monitor->pps_settled = false;
+	monitor->pps_aborting = false;
+	monitor->fixed_pending = false;
+	dev_info(&monitor->client->dev, "PPS contract closed, source returned to fixed 5 V\n");
+}
+
+static void max77705_monitor_poll(struct work_struct *work)
+{
+	struct max77705_monitor *monitor = container_of(to_delayed_work(work),
+			struct max77705_monitor, poll);
+
+	int bc, cc, fault, vbus, pd, ok, details, battery, mode, fcc, voltage;
+	int uic, cc_int, pd_int, vdm_int;
+	unsigned int invalid;
+	int target = MAX77705_BASE_MA, old, ret;
+	bool charge_enable = false, thermal_hold = true, idle;
+	u8 source;
+
+	mutex_lock(&monitor->lease_lock);
+	/* An expired lease means the holder stopped renewing: its SM5440
+	 * watchdog (2 s, shorter than the lease) has already cut the pump, so
+	 * a leased contract returns to 5 V at once.
+	 */
+	if (monitor->lease_active && time_after_eq(jiffies, monitor->lease_expires))
+		max77705_lease_end(monitor, true, "expired");
+	/* A leased contract without a lease that is not already being
+	 * withdrawn can only be a missed expiry: close it.
+	 */
+	if (monitor->pps_leased && !monitor->lease_active && !monitor->pps_aborting)
+		max77705_pps_return(monitor);
+	/* Read-clear interrupt registers first and exactly once: the mailbox
+	 * completion and the fault classifier both consume this one snapshot.
+	 */
+	uic = i2c_smbus_read_byte_data(monitor->usbc, MAX77705_REG_UIC_INT);
+	cc_int = i2c_smbus_read_byte_data(monitor->usbc, MAX77705_REG_CC_INT);
+	pd_int = i2c_smbus_read_byte_data(monitor->usbc, MAX77705_REG_PD_INT);
+	vdm_int = dp_altmode ?
+		i2c_smbus_read_byte_data(monitor->usbc, MAX77705_REG_VDM_INT) : 0;
+	bc = i2c_smbus_read_byte_data(monitor->usbc, 0x08);
+	cc = i2c_smbus_read_byte_data(monitor->usbc, 0x0a);
+	fault = i2c_smbus_read_byte_data(monitor->usbc, 0x0b);
+	vbus = i2c_smbus_read_byte_data(monitor->usbc, 0x06);
+	pd = i2c_smbus_read_byte_data(monitor->usbc, 0x0d);
+	ok = i2c_smbus_read_byte_data(monitor->client, MAX77705_CHG_INT_OK);
+	details = i2c_smbus_read_byte_data(monitor->client, MAX77705_CHG_DETAILS_00);
+	battery = i2c_smbus_read_byte_data(monitor->client, MAX77705_CHG_DETAILS_01);
+	mode = i2c_smbus_read_byte_data(monitor->client, MAX77705_CHG_CNFG_00);
+	fcc = i2c_smbus_read_byte_data(monitor->client, MAX77705_CHG_CNFG_02);
+	voltage = i2c_smbus_read_byte_data(monitor->client, MAX77705_CHG_CNFG_04);
+	if (bc < 0 || cc < 0 || fault < 0 || vbus < 0 || pd < 0 || ok < 0 ||
+	    details < 0 || battery < 0 || mode < 0 || fcc < 0 || voltage < 0 ||
+	    uic < 0 || cc_int < 0 || pd_int < 0 || vdm_int < 0) {
+		if (monitor->last_invalid != 0x400)
+			dev_warn(&monitor->client->dev, "input validity: register read failed\n");
+		monitor->last_invalid = 0x400;
+		goto reset;
+	}
+	max77705_handle_events(monitor,
+			max77705_typec_events(monitor, uic, cc_int, pd_int, fault));
+	if (dp_altmode)
+		monitor->dpv_pending |= max77705_dpv_pending(vdm_int, pd_int);
+	max77705_port_update(monitor, cc, fault, pd);
+	max77705_port_mailbox(monitor);
+	max77705_dp_service(monitor);
+	/* Clear the error hold once the link has been quiet long enough. */
+	if (monitor->error_until && time_after(jiffies, monitor->error_until)) {
+		monitor->error_until = 0;
+		monitor->events &= ~(MAX77705_EVT_ERROR | MAX77705_EVT_CMD_FAIL |
+				     MAX77705_EVT_REJECTED | MAX77705_EVT_HARD_RESET);
+		if (monitor->ceiling_ma < MAX77705_MAX_MA) {
+			monitor->ceiling_ma = MAX77705_MAX_MA;
+			dev_info(&monitor->client->dev, "Type-C link quiet, input ceiling restored\n");
+		}
+	}
+	/* Sink only, dry connector, valid ~5 V input, bounded FCC and float.
+	 */
+	/* The FCC bound checks that nothing has configured a current higher than
+	 * this driver itself sanctions. It was a constant 500 mA while that was
+	 * the only value we ever set; with a staged ceiling it has to track that
+	 * ceiling, or the driver rejects its own configuration one poll after
+	 * writing it and resets forever. Register decode is reg*50 mA above
+	 * reg 2, and stock's own max_fcc is 3150 mA.
+	 */
+	/* One bit per validity term, logged on every change so a stuck
+	 * baseline can be traced to the exact register.
+	 */
+	invalid = (!(bc & BIT(7)) ? 0x001 : 0) |
+		((cc & 7) != 1 ? 0x002 : 0) |
+		((fault & 0xc6) ? 0x004 : 0) |
+		(!max77705_vbadc_ok(vbus >> 4, max77705_pps_busy(monitor) ||
+				    (monitor->pps_used && (pd & MAX77705_PD_STATUS1_PSRDY))) ?
+		 0x008 : 0) |
+		(!(ok & MAX77705_CHGIN_OK) ? 0x010 : 0) |
+		((details & MAX77705_CHGIN_VALID) != MAX77705_CHGIN_VALID ? 0x020 : 0) |
+		(((battery >> 4) & 7) != 3 ? 0x040 : 0) |
+		(((mode & 0x0f) != 5 && !(monitor->charge_owned && (mode & 0x0f) == 4)) ? 0x080 : 0) |
+		(((fcc & 0x3f) > 2 &&
+		  (fcc & 0x3f) * 50 > max(MAX77705_BASE_MA, monitor->fcc_ceiling_ma)) ? 0x100 : 0) |
+		((voltage & 0x3f) > 0x13 ? 0x200 : 0);
+	if (invalid != monitor->last_invalid) {
+		dev_warn(&monitor->client->dev,
+			 "input validity 0x%03x (was 0x%03x): BC=%02x CC0=%02x CC1=%02x USBC1=%02x PD1=%02x INT_OK=%02x DTLS0=%02x DTLS1=%02x CNFG00=%02x CNFG02=%02x CNFG04=%02x busy=%d\n",
+			 invalid, monitor->last_invalid, bc, cc, fault, vbus, pd, ok, details,
+			 battery, mode, fcc, voltage, max77705_pps_busy(monitor));
+		monitor->last_invalid = invalid;
+	}
+	if (invalid)
+		goto reset;
+	mutex_lock(&monitor->temperature_lock);
+	ret = max77705_temperature(monitor);
+	mutex_unlock(&monitor->temperature_lock);
+	/* A thermal or sensor pause stops charging and holds the input at the
+	 * baseline, but the source and the mailbox are still serviced: an
+	 * elevated PPS contract must be able to return to 5 V while paused.
+	 */
+	thermal_hold = ret;
+	charge_enable = !ret;
+	/* The temperature function verifies any new setting; this old snapshot
+	 * still catches a drifted WARM float on cached-temperature polls. Its
+	 * next fresh pass can repair the register without a reset loop.
+	 */
+	if (charge_enable && monitor->thermal.zone == GTS8_ZONE_WARM &&
+	    (voltage & 0x3f) > min_t(int, monitor->boot_float_code,
+					 MAX77705_WARM_FLOAT_CODE))
+		charge_enable = false;
+	monitor->source_valid = true;
+	source = (bc & 7) | ((cc & 0x30) >> 1) | ((pd & BIT(4)) << 2);
+	/* PD 3.0 sources move Rp between SinkTxOK and SinkTxNG around their
+	 * own messages, and PS_RDY drops during a transition, so while PPS
+	 * state exists only the BC1.2 part identifies the source. A real
+	 * detach goes through the reset path instead.
+	 */
+	if ((source ^ monitor->source) & (max77705_pps_busy(monitor) ? 0x07 : 0xff)) {
+		monitor->source = source;
+		monitor->events = 0;
+		max77705_pd_invalidate(monitor);
+		if (monitor->pps_leased) {
+			max77705_lease_end(monitor, false, "revoked: source changed");
+		} else {
+			monitor->lease_active = false;
+			max77705_pps_return(monitor);
+		}
+		monitor->query_at = jiffies;
+	} else {
+		monitor->source = source;
+	}
+	if (pd & MAX77705_PD_STATUS1_PSRDY) {
+		max77705_pps_unserviceable(monitor, true);
+		max77705_mb_service(monitor, uic);
+		target = max(target, monitor->pd_ma);
+	} else if (max77705_pps_unserviceable(monitor, false)) {
+		max77705_pps_shutdown(monitor);
+	} else if (((cc >> 4) & 3) == 3) {
+		target = MAX77705_MAX_MA;
+	} else if (((cc >> 4) & 3) == 2 ||
+		   (!(bc & BIT(2)) && (bc & 3) >= 2)) {
+		target = 1500;
+	}
+	old = i2c_smbus_read_byte_data(monitor->client, MAX77705_CHG_CNFG_09);
+	if (old < 0)
+		goto reset;
+	old = (old & 0x7f) <= 3 ? 100 : ((old & 0x7f) + 1) * 25;
+	/* Latch a reduced ceiling if AICL detects input sag; do not repeatedly
+	 * fight the source. A new attachment resets this ceiling.
+	 *
+	 * Not while a lease or PPS state is live, nor for a few seconds after:
+	 * the input is deliberately at the baseline and VBUS is being moved
+	 * between 5 and 9 V, and AICL_OK drops during that. Latching it there
+	 * stranded the tablet at 500 mA / 100 mA FCC after the first 8.2 V
+	 * probe (2026-09-16), with no detach to clear it.
+	 */
+	if (monitor->lease_active || max77705_pps_busy(monitor))
+		monitor->aicl_quiet_until = jiffies +
+			msecs_to_jiffies(MAX77705_AICL_QUIET_MS);
+	if (!(ok & BIT(7)) && time_after(jiffies, monitor->aicl_quiet_until))
+		monitor->ceiling_ma = min(monitor->ceiling_ma,
+				max(MAX77705_BASE_MA, old - 100));
+	target = min(target, monitor->ceiling_ma);
+	/* While any PPS state is live the input stays at the conservative
+	 * baseline and this path does not charge. That holds with PS_RDY
+	 * momentarily clear too, where the Rp branch above would ask for 3 A.
+	 */
+	if (thermal_hold || max77705_pps_busy(monitor))
+		target = MAX77705_BASE_MA;
+	/* A latched thermal controller caps the input as well as the FCC. */
+	if (monitor->limit.icl_ma)
+		target = min(target, monitor->limit.icl_ma);
+	/* Ramp upward by 25 mA per 200 ms; decreases are immediate. */
+	if (target > old)
+		target = min(target, old + 25);
+	goto apply;
+reset:
+	/* Only a confirmed detach forgets PPS state. A bad sample or a failed
+	 * read keeps it (and the source identity): a lease holder is told at
+	 * once, and anything still unserviceable after the grace period is
+	 * closed synchronously before the state is dropped.
+	 */
+	if (max77705_pps_busy(monitor) &&
+	    !(bc >= 0 && cc >= 0 && (!(bc & BIT(7)) || (cc & 7) != 1))) {
+		if (!max77705_pps_unserviceable(monitor, false)) {
+			if (monitor->lease_active)
+				max77705_lease_end(monitor, false, "revoked: input invalid");
+			else if (monitor->pps_leased)
+				max77705_pps_abort(monitor, "input invalid");
+			monitor->query_at = jiffies;
+			goto apply;
+		}
+		max77705_pps_shutdown(monitor);
+	}
+	monitor->pps_stuck = false;
+	if (bc >= 0 && cc >= 0 && (!(bc & BIT(7)) || (cc & 7) != 1))
+		monitor->pps_used = false;
+	max77705_pd_invalidate(monitor);
+	monitor->source = 0;
+	monitor->mb.busy = false;
+	monitor->pps_active = false;
+	/* The PPS enable lives in the USB-C firmware and survives a detach and
+	 * an AP reboot: clearing it here without SET_PPS off left the firmware
+	 * selecting the APDO by itself on every later attach (2026-09-16). Keep
+	 * it, so the next attach sends the disable.
+	 */
+	monitor->pps_return_step = 0;
+	monitor->req.wanted = false;
+	monitor->req.step = 0;
+	monitor->pps_leased = false;
+	monitor->pps_settled = false;
+	monitor->pps_aborting = false;
+	monitor->fixed_pending = false;
+	/* Interrupts accumulate while no valid source is attached, so they are
+	 * re-drained on the way back. Arm that once per detach episode: this
+	 * path runs every 200 ms for as long as the tablet stays unplugged, and
+	 * re-arming per cycle floods the log and costs the ring buffer its
+	 * boot-time evidence within hours.
+	 */
+	if (monitor->source_valid) {
+		monitor->source_valid = false;
+		monitor->ints_drained = false;
+	}
+	monitor->query_at = jiffies;
+	if (bc >= 0 && cc >= 0 && (!(bc & BIT(7)) || (cc & 7) != 1))
+		monitor->ceiling_ma = MAX77705_MAX_MA;
+	/* Transient attach/PD/status errors use 500 mA until revalidated, but
+	 * must not permanently lower the ceiling. Only real AICL sag latches a
+	 * reduction. Otherwise a quick cable swap can strand a healthy source
+	 * at 500 mA even after its selected 5 V / 3 A PDO is verified again.
+	 */
+apply:
+	/* A revoked, invalid or expired grant returns to the existing policy.
+	 * While granted, mode 4 remains powered and input stays at 500 mA.
+	 */
+	/* A revocation while the holder is alive goes through the abort grace
+	 * period so its pump is off before the voltage moves; the holder sees
+	 * the revocation on its next renewal.
+	 */
+	if (monitor->lease_active &&
+	    !max77705_lease_can_grant(1, mode & 0x0f,
+		monitor->source_valid, monitor->temperature_valid,
+		monitor->temperature_paused,
+		monitor->events & (MAX77705_EVT_ERROR | MAX77705_EVT_HARD_RESET |
+					MAX77705_EVT_WATER) || monitor->error_until, 0)) {
+		max77705_lease_end(monitor, false, "revoked");
+	}
+	if (monitor->lease_active || max77705_pps_busy(monitor)) {
+		target = MAX77705_BASE_MA;
+		charge_enable = false;
+	}
+	ret = max77705_input_limit(monitor, target);
+	if (ret)
+		dev_err_ratelimited(&monitor->client->dev, "input limit update failed: %d\n", ret);
+	/* No CHGIN while the boost runs, and mode 0xe is not ours to change. */
+	ret = monitor->otg_on ? 0 : max77705_charge_control(monitor, charge_enable && !ret,
+				       target >= 1500 ? monitor->limit.fcc_ma : 100);
+	if (ret)
+		dev_err_ratelimited(&monitor->client->dev, "charge control failed: %d\n", ret);
+	if (time_after_eq(jiffies, monitor->notify_at)) {
+		power_supply_changed(monitor->supply);
+		monitor->notify_at = jiffies + msecs_to_jiffies(5000);
+	}
+	idle = cc >= 0 && (cc & 7) == 0 && ok >= 0 && !(ok & MAX77705_CHGIN_OK) &&
+	       !monitor->otg_on && !monitor->lease_active && !max77705_pps_busy(monitor) &&
+	       !monitor->mb.busy && !monitor->req.wanted &&
+	       /* DP work queued, or lane switches not yet back to safe. */
+	       !monitor->dpv_pending && !monitor->dp_enter_wanted &&
+	       !monitor->dp_conf_wanted &&
+	       monitor->orientation == TYPEC_ORIENTATION_NONE &&
+	       monitor->mux_mode == TYPEC_STATE_SAFE;
+	schedule_delayed_work(&monitor->poll,
+			      msecs_to_jiffies(idle ? MAX77705_IDLE_POLL_MS : MAX77705_POLL_MS));
+	mutex_unlock(&monitor->lease_lock);
+}
+
+static int max77705_monitor_probe(struct i2c_client *client)
+{
+	struct power_supply_config config = {};
+	struct max77705_monitor *monitor;
+	static const char * const ntc_names[] = { "battery", "blanket", "charger" };
+	int ret, i;
+
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_SMBUS_BYTE_DATA |
+			I2C_FUNC_SMBUS_READ_I2C_BLOCK))
+		return -EOPNOTSUPP;
+	ret = i2c_smbus_read_byte_data(client, MAX77705_CHG_INT_OK);
+	if (ret < 0)
+		return dev_err_probe(&client->dev, ret, "cannot read charger status\n");
+	monitor = devm_kzalloc(&client->dev, sizeof(*monitor), GFP_KERNEL);
+	if (!monitor)
+		return -ENOMEM;
+	monitor->client = client;
+	mutex_init(&monitor->pd_lock);
+	mutex_init(&monitor->temperature_lock);
+	mutex_init(&monitor->lease_lock);
+	i2c_set_clientdata(client, monitor);
+	if (device_property_present(&client->dev,
+				    "samsung,normal-band-charge-current-microamp")) {
+		ret = device_property_read_u32(&client->dev,
+				"samsung,normal-band-charge-current-microamp", &monitor->normal_fcc_ua);
+		/* Upper bound is stock's own max_fcc (battery,max_charging_current
+		 * = 3150 mA), which is also the CHG_CNFG_02 register ceiling.
+		 */
+		if (ret || monitor->normal_fcc_ua < 100000 || monitor->normal_fcc_ua > 3150000 ||
+		    monitor->normal_fcc_ua % 50000)
+			return -EINVAL;
+		for (i = 0; i < ARRAY_SIZE(ntc_names); i++) {
+			monitor->ntc[i] = devm_iio_channel_get(&client->dev, ntc_names[i]);
+			if (IS_ERR(monitor->ntc[i]))
+				return dev_err_probe(&client->dev, PTR_ERR(monitor->ntc[i]),
+						     "cannot acquire fitted NTC %s\n", ntc_names[i]);
+		}
+		/* Require the system buck to be running on the wired path:
+		 * mode5 is buck+charge, mode4 buck with charging disabled --
+		 * which is exactly the state this driver's own remove() leaves,
+		 * so demanding mode5 here would make the driver impossible to
+		 * rebind after an unbind. Every other mode means all-off or an
+		 * OTG boost session (0xa/0xe/0xf), and those are never taken
+		 * over. What actually sanctions charging is the poll's validity
+		 * gate -- dry sink, valid 5 V input, inherited FCC and float --
+		 * together with the fitted-NTC normal-band policy, not this bit.
+		 */
+		ret = i2c_smbus_read_byte_data(client, MAX77705_CHG_CNFG_00);
+		/* This driver owns the OTG boost, so one left running (by a
+		 * hang, or an earlier kernel) is ours to stop: nothing watches
+		 * the port yet. Back to buck-only, as the OTG-off path does.
+		 */
+		if (ret >= 0 && ((ret & 0x0f) == 0x0a || (ret & 0x0f) == 0x0e ||
+				 (ret & 0x0f) == 0x0f)) {
+			dev_warn(&client->dev, "OTG boost left on (CHG_CNFG_00=0x%02x), stopping it\n",
+				 ret);
+			if (!max77705_update_bits(client, MAX77705_CHG_CNFG_00, 0x0f, 4))
+				ret = i2c_smbus_read_byte_data(client, MAX77705_CHG_CNFG_00);
+		}
+		if (ret < 0 || ((ret & 0x0f) != 5 && (ret & 0x0f) != 4))
+			return dev_err_probe(&client->dev, ret < 0 ? ret : -EPERM,
+					     "wired buck path not active (CHG_CNFG_00=0x%02x)\n",
+					     ret < 0 ? 0 : ret);
+		monitor->charge_owned = true;
+		monitor->fcc_ceiling_ma = monitor->normal_fcc_ua / 1000;
+		monitor->thermal.zone = GTS8_ZONE_NORMAL;
+		monitor->temperature_paused = true;
+		monitor->temperature_at = jiffies;
+		ret = devm_device_add_group(&client->dev, max77705_temperature_groups[0]);
+		if (ret)
+			return ret;
+	}
+	monitor->usbc = devm_i2c_new_dummy_device(&client->dev, client->adapter, 0x25);
+	if (IS_ERR(monitor->usbc))
+		return dev_err_probe(&client->dev, PTR_ERR(monitor->usbc), "cannot claim USB-C status client\n");
+	ret = i2c_smbus_read_byte_data(client, MAX77705_CHG_CNFG_06);
+	/* Require settings already unlocked by the boot firmware; do not touch
+	 * CHGPROT, watchdog, hardware thermal, timers or float settings.
+	 */
+	if (ret < 0 || (ret & 0x0c) != 0x0c)
+		return dev_err_probe(&client->dev, ret < 0 ? ret : -EPERM, "charger settings are protected\n");
+	ret = i2c_smbus_read_byte_data(client, MAX77705_CHG_CNFG_04);
+	if (ret < 0 || (ret & 0x3f) > 0x13)
+		return dev_err_probe(&client->dev, ret < 0 ? ret : -EINVAL,
+				     "unsupported boot float voltage\n");
+	monitor->boot_float_code = ret & 0x3f;
+	/* Optional: without a connector node the port stays peripheral-only. */
+	monitor->connector = device_get_named_child_node(&client->dev, "connector");
+	monitor->role = -1;
+	ret = devm_add_action_or_reset(&client->dev, max77705_port_release, monitor);
+	if (!ret && is_of_node(monitor->connector)) {
+		/* The DP bridge chain ends at the connector node: HPD from the
+		 * DP Status/Attention VDMs is reported through this bridge.
+		 */
+		monitor->hpd_bridge = devm_drm_dp_hpd_bridge_alloc(&client->dev,
+				to_of_node(monitor->connector));
+		if (IS_ERR(monitor->hpd_bridge))
+			ret = PTR_ERR(monitor->hpd_bridge);
+		else if (monitor->hpd_bridge)
+			ret = devm_drm_dp_hpd_bridge_add(&client->dev, monitor->hpd_bridge);
+		if (ret)
+			return dev_err_probe(&client->dev, ret, "cannot add DP HPD bridge\n");
+	}
+	if (ret)
+		return ret;
+	ret = devm_device_add_group(&client->dev, max77705_port_groups[0]);
+	if (ret)
+		return ret;
+	monitor->ceiling_ma = MAX77705_MAX_MA;
+	monitor->query_at = jiffies;
+	monitor->notify_at = jiffies;
+	monitor->aicl_quiet_until = jiffies;
+	/* A driver that binds (or a system that boots) with the cable still in
+	 * cannot know whether an earlier session used PPS on this attachment,
+	 * and the firmware's VBADC band stays stale until a detach: a rebind
+	 * right after a 2 A session sat at 500 mA until a replug (2026-09-16).
+	 * The relaxed band only applies with a PD contract, and more than
+	 * 500 mA still needs a confirmed fixed 5 V PDO; the first confirmed
+	 * detach clears this.
+	 */
+	monitor->pps_used = true;
+	ret = max77705_input_limit(monitor, MAX77705_BASE_MA);
+	if (ret)
+		return ret;
+	config.drv_data = monitor;
+	config.of_node = client->dev.of_node;
+	ret = devm_delayed_work_autocancel(&client->dev, &monitor->poll,
+			max77705_monitor_poll);
+	if (ret)
+		return ret;
+	monitor->supply = devm_power_supply_register(&client->dev,
+			&max77705_monitor_desc, &config);
+	if (IS_ERR(monitor->supply))
+		return dev_err_probe(&client->dev, PTR_ERR(monitor->supply),
+				"cannot register charger monitor\n");
+	schedule_delayed_work(&monitor->poll, msecs_to_jiffies(MAX77705_POLL_MS));
+	return 0;
+}
+
+static void max77705_monitor_remove(struct i2c_client *client)
+{
+	struct max77705_monitor *monitor = i2c_get_clientdata(client);
+
+	cancel_delayed_work_sync(&monitor->poll);
+	mutex_lock(&monitor->lease_lock);
+	monitor->lease_stopped = true;
+	monitor->lease_active = false;
+	max77705_port_stop(monitor);
+	max77705_charge_control(monitor, false, 100);
+	max77705_pps_shutdown(monitor);
+	max77705_input_limit(monitor, MAX77705_BASE_MA);
+	mutex_unlock(&monitor->lease_lock);
+}
+
+static int max77705_monitor_suspend(struct device *dev)
+{
+	struct max77705_monitor *monitor = dev_get_drvdata(dev);
+	int ret;
+
+	cancel_delayed_work_sync(&monitor->poll);
+	mutex_lock(&monitor->lease_lock);
+	monitor->lease_stopped = true;
+	monitor->lease_active = false;
+	/* Nothing watches CC while suspended, so no boost is left running. */
+	max77705_port_stop(monitor);
+	ret = max77705_charge_control(monitor, false, 100);
+	max77705_pps_shutdown(monitor);
+	if (!ret)
+		ret = max77705_input_limit(monitor, MAX77705_BASE_MA);
+	/* Resume is not called for a device whose suspend failed. */
+	if (ret)
+		monitor->lease_stopped = false;
+	mutex_unlock(&monitor->lease_lock);
+	if (ret)
+		schedule_delayed_work(&monitor->poll, 0);
+	return ret;
+}
+
+static int max77705_monitor_resume(struct device *dev)
+{
+	struct max77705_monitor *monitor = dev_get_drvdata(dev);
+
+	mutex_lock(&monitor->lease_lock);
+	monitor->lease_stopped = false;
+	monitor->pps_used = true;
+	monitor->source = 0;
+	monitor->lease_active = false;
+	monitor->pd_ma = 0;
+	monitor->mb.busy = false;
+	monitor->req.wanted = false;
+	monitor->req.step = 0;
+	monitor->pps_active = false;
+	monitor->pps_return_step = 0;
+	monitor->pps_leased = false;
+	monitor->pps_settled = false;
+	monitor->pps_aborting = false;
+	monitor->fixed_pending = false;
+	monitor->events = 0;
+	monitor->error_until = 0;
+	monitor->ints_drained = false;
+	monitor->source_valid = false;
+	monitor->query_at = jiffies;
+	monitor->ceiling_ma = MAX77705_MAX_MA;
+	monitor->temperature_valid = false;
+	monitor->temperature_paused = true;
+	monitor->temperature_at = jiffies;
+	monitor->thermal.zone = GTS8_ZONE_NORMAL;
+	monitor->thermal.mix_limit = 0;
+	monitor->thermal.chg_limit = 0;
+	mutex_lock(&monitor->pd_lock);
+	monitor->caps_valid = false;
+	mutex_unlock(&monitor->pd_lock);
+	mutex_unlock(&monitor->lease_lock);
+	schedule_delayed_work(&monitor->poll, 0);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(max77705_monitor_pm_ops,
+		max77705_monitor_suspend, max77705_monitor_resume);
+
+static const struct of_device_id max77705_monitor_match[] = {
+	{ .compatible = "maxim,max77705-charger-monitor" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, max77705_monitor_match);
+
+static struct i2c_driver max77705_monitor_driver = {
+	.driver = {
+		.name = MAX77705_DRIVER_NAME,
+		.of_match_table = max77705_monitor_match,
+		.pm = pm_sleep_ptr(&max77705_monitor_pm_ops),
+	},
+	.probe = max77705_monitor_probe,
+	.remove = max77705_monitor_remove,
+	.shutdown = max77705_monitor_remove,
+};
+module_i2c_driver(max77705_monitor_driver);
+
+MODULE_DESCRIPTION("MAX77705 wired charger monitor and conservative input policy");
+MODULE_LICENSE("GPL");
