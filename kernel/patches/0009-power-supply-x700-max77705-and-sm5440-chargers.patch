power: supply: add the SM-X700 MAX77705 and SM5440 charger drivers

--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -9,6 +9,31 @@
 
 if POWER_SUPPLY
 
+config SM5440_CHARGER_MONITOR
+	tristate "SM5440 off-mode ADC and direct-charger NTC monitor"
+	depends on I2C
+	help
+	  Read fresh SM5440 measurements and the SM-X700 fitted direct-charger
+	  thermistor while the charge pump remains off. ADC enable/rate bits
+	  are restored after each conversion. This is a diagnostic prerequisite
+	  for coordinated PPS/direct charging; it does not enable charging or
+	  modify protection, watchdog or interrupt registers.
+
+config MAX77705_CHARGER_MONITOR
+	tristate "MAX77705 wired charger monitor and conservative input policy"
+	depends on I2C && IIO
+	depends on TYPEC || !TYPEC
+	depends on DRM_AUX_HPD_BRIDGE || !DRM_AUX_HPD_BRIDGE
+	help
+	  Report wired input presence, state and configured current limits.
+	  For SM-X700, conservatively ramp CHGIN up to 2 A on a verified
+	  capable 5 V source. With fitted live NTC channels, manage a maximum
+	  500 mA battery charging current in the normal temperature band.
+	  Standard dedicated chargers and 1.5 A Type-C sources stay at 1.5 A.
+	  Does not negotiate new PD profiles or manage USB roles. Retains
+	  inherited float/protection settings. Falls back to 500 mA input on
+	  detach and faults; pauses controlled battery charging on suspend.
+
 config POWER_SUPPLY_DEBUG
 	bool "Power supply debug"
 	help
