--- /dev/null
+++ b/drivers/power/supply/sm5440-direct-charge.h
@@ -0,0 +1,789 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* SM5440 PD direct-charging decisions for SM-X700: pure logic, no I2C.
+ *
+ * Ports the PD path of Samsung/Silicon Mitus' sm5440_direct_charger.c
+ * (PRESET, PRE_CC, CC, CV) and adds what stock leaves out: an entry gate, a
+ * VBUS check before the pump is enabled, per-cycle guards, a give-up budget
+ * and an ordered teardown. "DC:n" and "CHG:n" below cite line numbers in
+ * sm5440_direct_charger.c and sm5440_charger.c of Samsung's SM-X706N
+ * open-source kernel (drivers/battery/charger/sm5440_charger/).
+ *
+ * Units: mV, mA, 0.1 C. Power products are mV * mA (uW), as in stock, where
+ * ta.p_max is max_voltage * max_current (sec_pd.c:353), not mW.
+ *
+ * TA current here is the PUMP's share. The MAX77705 buck keeps a CHGIN
+ * allowance during a session, so the PD request is ta.ma + allowance; the
+ * caller adds that, never this file.
+ */
+#ifndef SM5440_DIRECT_CHARGE_H
+#define SM5440_DIRECT_CHARGE_H
+
+#define SM5440_DC_PPS_V_STEP		20
+#define SM5440_DC_PPS_C_STEP		50
+#define SM5440_DC_PRE_CC_IBUS_OFFSET	150
+#define SM5440_DC_CC_IBUS_OFFSET	100
+#define SM5440_DC_DELAY_PPS_MS		250
+#define SM5440_DC_DELAY_ADC_MS		1100
+#define SM5440_DC_DELAY_LOOP_MS		2500
+
+/* STATUS2 loop decode, CHG:1211-1218. en_vbatreg=1 on X700, so the
+ * fuel-gauge half of the VBATREG test is always false and only bit3 counts.
+ */
+#define SM5440_DC_LOOP_INACTIVE	0
+#define SM5440_DC_LOOP_VBATREG	1
+#define SM5440_DC_LOOP_IBUSLIM	2
+#define SM5440_DC_LOOP_THEMREG	4
+
+static inline unsigned int sm5440_dc_loop(unsigned char status2)
+{
+	if (status2 & 0x08)
+		return SM5440_DC_LOOP_VBATREG;
+	if (status2 & 0x80)
+		return status2 & 0x02 ? SM5440_DC_LOOP_THEMREG : SM5440_DC_LOOP_IBUSLIM;
+	return SM5440_DC_LOOP_INACTIVE;
+}
+
+/* Board envelope for one session. Fixed at start, never changed mid-session. */
+struct sm5440_dc_limits {
+	int ta_min_mv;		/* 8200, CHG:1775 */
+	int ta_max_mv;		/* board cap; 9000 for the floor pilot */
+	int ta_min_ma;		/* 1000, CHG.h:17 */
+	int ta_max_ma;		/* pump-share cap */
+	long long p_max;	/* pump-share power cap, mV * mA */
+	int vbus_ovp_mv;	/* 11000, CHG:1777 */
+	int r_ttl_uohm;		/* 290000, CHG:1481 default, not measured */
+	int vbat_floor_mv;	/* 3300, CHG:1776 */
+	int vbat_entry_min_mv;	/* 3600 for the pilot */
+	int vbat_entry_max_mv;	/* 4000 for the pilot */
+	int vbat_gauge_tol_mv;	/* SM5440 ADC vs fuel gauge at entry */
+	int ntc_entry_max;	/* direct NTC, 0.1 C */
+	int ntc_trip;
+	int die_entry_max;
+	int die_trip;
+	int vbus_overshoot_mv;	/* allowed above the request while verifying */
+	int ibus_trip_margin_ma; /* above IBUSLIM before we call it OCP */
+	int topoff_ma;		/* pilot DONE current in CV */
+	int topoff_count;
+	unsigned int step_budget; /* PRE_CC steps before FAIL_ADJUST */
+	unsigned int stall_count; /* at-ceiling, low-IBUS samples before giving up */
+};
+
+struct sm5440_dc_goal {
+	int cv_mv;		/* cv_gl */
+	int ci_ma;		/* ci_gl, pump input current */
+};
+
+struct sm5440_dc_sample {
+	int vbus_mv;
+	int ibus_ma;
+	int vbat_mv;
+	int vout_mv;
+	int ntc;		/* 0.1 C */
+	int die;		/* 0.1 C */
+	unsigned int loop;
+};
+
+/* Board policy, below Samsung's 65 C direct-NTC latch while the port's
+ * separate hard stop remains at 50 C.  A 2 A/60 s dim-display run ended at
+ * 39 C with no felt warmth, so there is no measured reason to throttle there.
+ * Each level removes 250 mA from the session request.  Release needs
+ * 1 C NTC / 2 C die hysteresis and 15 s at a level;
+ * the caller raises current only after the PD request is accepted.
+ */
+struct sm5440_dc_thermal {
+	unsigned int level;
+	unsigned int changed_ms;
+	unsigned int last_up_ms;
+};
+
+static inline unsigned int sm5440_dc_thermal_level(int ntc, int die)
+{
+	static const int ntc_enter[] = { 430, 435, 440, 445 };
+	static const int die_enter[] = { 500, 550, 600, 650 };
+	unsigned int i, level = 0;
+
+	for (i = 0; i < 4; i++)
+		if (ntc >= ntc_enter[i] || die >= die_enter[i])
+			level = i + 1;
+	return level;
+}
+
+/* Return a 50 mA-aligned ceiling. Downward steps take effect immediately;
+ * recovery releases one band at a time and raises at most 50 mA per 5 s.
+ */
+static inline int sm5440_dc_thermal_step(struct sm5440_dc_thermal *th,
+					int ntc, int die, int requested_ma,
+					int current_ma, unsigned int now_ms)
+{
+	static const int ntc_enter[] = { 430, 435, 440, 445 };
+	static const int die_enter[] = { 500, 550, 600, 650 };
+	unsigned int hot = sm5440_dc_thermal_level(ntc, die);
+	int ceiling;
+
+	if (hot > th->level) {
+		th->level = hot;
+		th->changed_ms = now_ms;
+	} else if (hot < th->level && now_ms - th->changed_ms >= 15000 &&
+		   ntc <= ntc_enter[th->level - 1] - 10 &&
+		   die <= die_enter[th->level - 1] - 20) {
+		th->level--;
+		th->changed_ms = now_ms;
+	}
+	ceiling = requested_ma - 250 * (int)th->level;
+	if (ceiling < 1000)
+		ceiling = 1000;
+	if (ceiling > requested_ma)
+		ceiling = requested_ma;
+	if (ceiling < current_ma)
+		return ceiling;
+	if (ceiling > current_ma && now_ms - th->last_up_ms >= 5000)
+		return current_ma + 50;
+	return current_ma;
+}
+
+struct sm5440_dc_ta {
+	int mv;
+	int ma;
+};
+
+struct sm5440_dc_ramp {
+	int pps_cl;
+	int v_down;
+	int cc_limit;
+	int cc_cnt;
+	int cv_cnt;
+	int c_offset;
+	int prev_vbus_mv;
+	int prev_ibus_ma;
+	unsigned int steps;
+	unsigned int stalled;
+	int topoff;
+};
+
+enum sm5440_dc_phase {
+	SM5440_DC_PHASE_PRE_CC,
+	SM5440_DC_PHASE_CC,
+	SM5440_DC_PHASE_CV,
+	SM5440_DC_PHASE_DONE,
+	SM5440_DC_PHASE_FAIL,
+};
+
+/* Stop reasons. Zero is "none". Order is only for reporting. */
+enum sm5440_dc_reason {
+	SM5440_DC_OK = 0,
+	SM5440_DC_STOP_USER,
+	SM5440_DC_STOP_DONE,
+	SM5440_DC_STOP_TIMEOUT,
+	SM5440_DC_STOP_DISCONNECT,
+	SM5440_DC_STOP_SUSPEND,
+	SM5440_DC_STOP_UNBIND,
+	SM5440_DC_STOP_PROBE_DONE,
+	/* The MAX77705 did not grant the first lease (e.g. its error hold after
+	 * a plug-in fault). Nothing was changed yet, so it is retried.
+	 */
+	SM5440_DC_STOP_LEASE_BUSY,
+	SM5440_DC_ERR_VBAT_LOW,
+	SM5440_DC_ERR_VBAT_HIGH,
+	SM5440_DC_ERR_VBAT_ABOVE_TARGET,
+	SM5440_DC_ERR_VBAT_MISMATCH,
+	SM5440_DC_ERR_NTC,
+	SM5440_DC_ERR_DIE,
+	SM5440_DC_ERR_MODE,
+	SM5440_DC_ERR_CUTOFF,
+	SM5440_DC_ERR_SOURCE,
+	SM5440_DC_ERR_THERMAL_POLICY,
+	SM5440_DC_ERR_LATCHED,
+	SM5440_DC_ERR_TA_CAP,
+	SM5440_DC_ERR_LEASE,
+	SM5440_DC_ERR_PD_REQUEST,
+	SM5440_DC_ERR_PD_CONTRACT,
+	SM5440_DC_ERR_VBUS_LOW,
+	SM5440_DC_ERR_VBUS_HIGH,
+	SM5440_DC_ERR_ENABLE,
+	SM5440_DC_ERR_CHIP_OFF,
+	SM5440_DC_ERR_WDT,
+	SM5440_DC_ERR_VBAT_OVER,
+	SM5440_DC_ERR_OCP,
+	SM5440_DC_ERR_ADC,
+	SM5440_DC_ERR_I2C,
+	SM5440_DC_ERR_FAIL_ADJUST,
+	SM5440_DC_ERR_UVLO,
+	SM5440_DC_ERR_WDT_NOT_CUT,
+	SM5440_DC_REASON_COUNT,
+};
+
+static inline const char *sm5440_dc_reason_name(int reason)
+{
+	static const char * const names[SM5440_DC_REASON_COUNT] = {
+		"none", "user stop", "done", "session deadline", "disconnect",
+		"suspend", "unbind", "probe complete", "lease not granted yet",
+		"vbat below entry window",
+		"vbat above entry window", "vbat above target", "vbat adc/gauge mismatch",
+		"direct ntc", "die temperature", "sm5440 mode", "cut-off fault",
+		"source not ready", "max77705 thermal policy", "fault latched",
+		"ta voltage above board cap", "lease refused or lost", "pd request refused",
+		"pd contract not settled", "vbus below target", "vbus above cap",
+		"pump did not start", "chip cut itself off", "watchdog cut pump",
+		"vbat above cv", "ibus over-current", "adc invalid or stale", "i2c error",
+		"pps adjustment failed", "vbus uvlo persisted",
+		"watchdog did not cut pump",
+	};
+
+	return reason >= 0 && reason < SM5440_DC_REASON_COUNT ? names[reason] : "?";
+}
+
+static inline int sm5440_dc_is_error(int reason)
+{
+	return reason >= SM5440_DC_ERR_VBAT_LOW;
+}
+
+/* pps_v/pps_c, DC:26-40: round half up to 20 mV / 50 mA. */
+static inline int sm5440_dc_round_mv(int mv)
+{
+	if (mv % SM5440_DC_PPS_V_STEP >= SM5440_DC_PPS_V_STEP / 2)
+		mv += SM5440_DC_PPS_V_STEP;
+	return mv / SM5440_DC_PPS_V_STEP * SM5440_DC_PPS_V_STEP;
+}
+
+static inline int sm5440_dc_round_ma(int ma)
+{
+	if (ma % SM5440_DC_PPS_C_STEP >= SM5440_DC_PPS_C_STEP / 2)
+		ma += SM5440_DC_PPS_C_STEP;
+	return ma / SM5440_DC_PPS_C_STEP * SM5440_DC_PPS_C_STEP;
+}
+
+static inline int sm5440_dc_ir_drop_mv(int ma, int r_ttl_uohm)
+{
+	return (int)((long long)ma * r_ttl_uohm / 1000000);
+}
+
+static inline int sm5440_dc_ceiling_mv(const struct sm5440_dc_limits *l)
+{
+	int ceiling = l->vbus_ovp_mv - 500;
+
+	return l->ta_max_mv < ceiling ? l->ta_max_mv : ceiling;
+}
+
+/* Applied to every voltage this file hands back: stock floors some writes
+ * and not others (the CV retreat, DC:751-762, has no floor at all).
+ */
+static inline int sm5440_dc_clamp_mv(const struct sm5440_dc_limits *l, int mv)
+{
+	int ceiling = sm5440_dc_ceiling_mv(l) / SM5440_DC_PPS_V_STEP * SM5440_DC_PPS_V_STEP;
+
+	if (mv < l->ta_min_mv)
+		return l->ta_min_mv;
+	return mv > ceiling ? ceiling : mv;
+}
+
+static inline int sm5440_dc_clamp_ma(const struct sm5440_dc_limits *l, int ma)
+{
+	if (ma < l->ta_min_ma)
+		return l->ta_min_ma;
+	return ma > l->ta_max_ma ? l->ta_max_ma : ma;
+}
+
+/* Register encoders, CHG:151-175 and CHG:1131-1151, en_vbatreg = 1. */
+/* 3800 + n * 12.5 mV. Stock masks the code and so wraps above 4587 mV back
+ * to 3800; this saturates instead.
+ */
+static inline unsigned char sm5440_dc_vbatcntl(int cv_mv)
+{
+	int code = cv_mv < 3800 ? 0 : (cv_mv - 3800) * 10 / 125;
+
+	return code > 0x3f ? 0x3f : code;
+}
+
+static inline int sm5440_dc_ibuslim_ma(int ci_ma)
+{
+	return ci_ma <= 1000 ? ci_ma + 600 : ci_ma + 300;
+}
+
+static inline unsigned char sm5440_dc_ibuscntl(int ci_ma)
+{
+	return sm5440_dc_ibuslim_ma(ci_ma) / 50;
+}
+
+static inline int sm5440_dc_freq_khz(int ci_ma)
+{
+	return ci_ma <= 1100 ? 450 : ci_ma <= 1700 ? 650 : 1100;
+}
+
+static inline unsigned char sm5440_dc_cntl7(int khz)
+{
+	return ((khz - 250) / 50) & 0x1f;
+}
+
+/* PRESET, DC:481-499: half the target current floored at ta_min, and
+ * 2 * VBAT + IR drop + 200 mV floored at ta_min_mv. Stock would then send
+ * whatever that is; here a result above the board cap is a refusal, because
+ * clamping it would start the pump under-voltaged.
+ */
+static inline int sm5440_dc_preset(int vbat_mv, const struct sm5440_dc_goal *goal,
+				   const struct sm5440_dc_limits *l,
+				   struct sm5440_dc_ta *ta, struct sm5440_dc_ramp *ramp)
+{
+	int ma, mv;
+
+	if (vbat_mv > goal->cv_mv + 20)
+		return SM5440_DC_ERR_VBAT_ABOVE_TARGET;
+	ma = goal->ci_ma / 2;
+	if (ma > l->ta_max_ma)
+		ma = l->ta_max_ma;
+	if (ma < l->ta_min_ma)
+		ma = l->ta_min_ma;
+	ma = sm5440_dc_round_ma(ma);
+	mv = 2 * vbat_mv + sm5440_dc_ir_drop_mv(ma, l->r_ttl_uohm) + 200;
+	if (mv < l->ta_min_mv)
+		mv = l->ta_min_mv;
+	mv = sm5440_dc_round_mv(mv);
+	if (mv > sm5440_dc_ceiling_mv(l))
+		return SM5440_DC_ERR_TA_CAP;
+	ta->mv = mv;
+	ta->ma = ma;
+	*ramp = (struct sm5440_dc_ramp){ 0 };
+	return 0;
+}
+
+/* The compensated target of _pd_pre_cc_check_limitation, DC:369-382. */
+static inline int sm5440_dc_compensated_mv(const struct sm5440_dc_goal *goal,
+					   const struct sm5440_dc_limits *l)
+{
+	int calc = 2 * goal->cv_mv + sm5440_dc_ir_drop_mv(goal->ci_ma, l->r_ttl_uohm);
+	int floor;
+
+	if ((long long)sm5440_dc_round_mv(calc) * goal->ci_ma > l->p_max) {
+		floor = 2 * goal->cv_mv + sm5440_dc_ir_drop_mv(l->ta_min_ma, l->r_ttl_uohm);
+		calc = (int)(l->p_max / goal->ci_ma) - SM5440_DC_PPS_V_STEP;
+		if (calc < floor)
+			calc = floor;
+	}
+	return sm5440_dc_clamp_mv(l, sm5440_dc_round_mv(calc));
+}
+
+struct sm5440_dc_step {
+	int phase;		/* enum sm5440_dc_phase */
+	int send;		/* ta changed or keepalive: issue the PD request */
+	int delay_ms;
+	int reason;		/* set with PHASE_FAIL or PHASE_DONE */
+};
+
+static inline void sm5440_dc_goto(struct sm5440_dc_step *st, int phase, int delay)
+{
+	st->phase = phase;
+	st->delay_ms = delay;
+}
+
+/* PRE_CC, DC:519-648, one sample. The give-up budget is ours: stock has no
+ * exit from PRE_CC other than the ones below.
+ */
+static inline void sm5440_dc_pre_cc(const struct sm5440_dc_sample *s,
+				    const struct sm5440_dc_goal *goal,
+				    const struct sm5440_dc_limits *l,
+				    struct sm5440_dc_ta *ta, struct sm5440_dc_ramp *r,
+				    struct sm5440_dc_step *st)
+{
+	int stale, limited = 0;
+
+	*st = (struct sm5440_dc_step){ SM5440_DC_PHASE_PRE_CC, 0, SM5440_DC_DELAY_PPS_MS, 0 };
+	if (++r->steps > l->step_budget) {
+		st->phase = SM5440_DC_PHASE_FAIL;
+		st->reason = SM5440_DC_ERR_FAIL_ADJUST;
+		return;
+	}
+	if (s->loop == SM5440_DC_LOOP_VBATREG) {
+		r->cv_cnt = 0;
+		sm5440_dc_goto(st, SM5440_DC_PHASE_CV, SM5440_DC_DELAY_ADC_MS);
+		return;
+	}
+	if (s->loop == SM5440_DC_LOOP_IBUSLIM) {
+		r->c_offset = 0;
+		if (ta->mv - 2 * SM5440_DC_PPS_V_STEP >= l->ta_min_mv) {
+			ta->mv -= 2 * SM5440_DC_PPS_V_STEP;
+			r->v_down = 1;
+			st->send = 1;
+			return;
+		}
+		ta->mv = l->ta_min_mv;
+		r->v_down = 0;
+		r->pps_cl = 0;
+		r->cc_limit = 0;
+		st->send = 1;
+		sm5440_dc_goto(st, SM5440_DC_PHASE_CC, SM5440_DC_DELAY_ADC_MS);
+		return;
+	}
+
+	/* _pd_pre_cc_check_limitation: an unchanged ADC pair is not a sample. */
+	stale = s->ibus_ma == r->prev_ibus_ma && s->vbus_mv == r->prev_vbus_mv;
+	if (!stale) {
+		if (s->vbus_mv < r->prev_vbus_mv + SM5440_DC_PPS_V_STEP &&
+		    s->ibus_ma < r->prev_ibus_ma + SM5440_DC_PPS_C_STEP &&
+		    !r->v_down && !r->pps_cl)
+			limited = 1;
+		else if (goal->ci_ma == l->ta_min_ma)
+			limited = 1;
+		if (limited) {
+			ta->mv = sm5440_dc_compensated_mv(goal, l);
+			r->pps_cl = 1;
+		}
+	}
+
+	if (s->ibus_ma > goal->ci_ma) {
+		r->cc_limit = 0;
+		r->c_offset = goal->ci_ma > ta->ma ? goal->ci_ma - ta->ma : 0;
+		st->send = limited;
+		sm5440_dc_goto(st, SM5440_DC_PHASE_CC, SM5440_DC_DELAY_ADC_MS);
+		return;
+	}
+	if (r->pps_cl &&
+	    ((long long)ta->mv * (ta->ma + SM5440_DC_PPS_C_STEP) > l->p_max ||
+	     ta->ma + SM5440_DC_PPS_C_STEP > l->ta_max_ma ||
+	     ta->ma > goal->ci_ma + SM5440_DC_PRE_CC_IBUS_OFFSET)) {
+		r->c_offset = 0;
+		r->cc_limit = 0;
+		st->send = limited;
+		sm5440_dc_goto(st, SM5440_DC_PHASE_CC, SM5440_DC_DELAY_ADC_MS);
+		return;
+	}
+
+	if (r->pps_cl) {
+		if (s->ibus_ma < goal->ci_ma - 6 * SM5440_DC_PPS_C_STEP &&
+		    ta->ma < goal->ci_ma * 85 / 100)
+			ta->ma += 3 * SM5440_DC_PPS_C_STEP;
+		else
+			ta->ma += SM5440_DC_PPS_C_STEP;
+		if (ta->ma > l->ta_max_ma)
+			ta->ma = l->ta_max_ma;
+	} else {
+		ta->mv += SM5440_DC_PPS_V_STEP;
+		if (ta->mv > sm5440_dc_ceiling_mv(l)) {
+			ta->mv = sm5440_dc_clamp_mv(l, ta->mv);
+			r->pps_cl = 1;
+		}
+	}
+	ta->mv = sm5440_dc_clamp_mv(l, ta->mv);
+	st->send = 1;
+	/* Ours: at the voltage ceiling in current mode with the pump still
+	 * drawing under half its goal, the source is not delivering.
+	 */
+	if (r->pps_cl && ta->mv >= sm5440_dc_clamp_mv(l, 1 << 30) &&
+	    s->ibus_ma < goal->ci_ma / 2) {
+		if (++r->stalled >= l->stall_count) {
+			st->phase = SM5440_DC_PHASE_FAIL;
+			st->reason = SM5440_DC_ERR_FAIL_ADJUST;
+			st->send = 0;
+			return;
+		}
+	} else {
+		r->stalled = 0;
+	}
+	r->prev_vbus_mv = s->vbus_mv;
+	r->prev_ibus_ma = s->ibus_ma;
+}
+
+/* _try_to_adjust_cc_up, DC:388-414, including the 107 % allowance. Returns
+ * nonzero when the TA is at its limit and cc_limit latched.
+ */
+static inline int sm5440_dc_cc_up(const struct sm5440_dc_goal *goal,
+				  const struct sm5440_dc_limits *l,
+				  struct sm5440_dc_ta *ta, struct sm5440_dc_ramp *r)
+{
+	long long allowed = l->p_max / 100 * 107;
+
+	r->cc_cnt++;
+	if ((r->cc_cnt % 2) && ta->ma <= goal->ci_ma + 4 * SM5440_DC_PPS_C_STEP &&
+	    ta->ma != l->ta_max_ma) {
+		if ((long long)ta->mv * (ta->ma + SM5440_DC_PPS_C_STEP) <= allowed) {
+			ta->ma += SM5440_DC_PPS_C_STEP;
+			if (ta->ma > l->ta_max_ma)
+				ta->ma = l->ta_max_ma;
+		}
+		return 0;
+	}
+	if ((long long)(ta->mv + 2 * SM5440_DC_PPS_V_STEP) * ta->ma <= allowed &&
+	    ta->mv + 2 * SM5440_DC_PPS_V_STEP <= sm5440_dc_ceiling_mv(l)) {
+		ta->mv += 2 * SM5440_DC_PPS_V_STEP;
+		return 0;
+	}
+	/* Stock clamps an over-ceiling step and carries on; with the board cap
+	 * that close, reaching it is the limit.
+	 */
+	r->cc_limit = 1;
+	return 1;
+}
+
+/* _try_to_adjust_cc_down, DC:416-427: -50 mA or -20 mV, floored. */
+static inline void sm5440_dc_cc_down(const struct sm5440_dc_goal *goal,
+				     const struct sm5440_dc_limits *l,
+				     struct sm5440_dc_ta *ta, struct sm5440_dc_ramp *r)
+{
+	r->cc_cnt++;
+	if ((r->cc_cnt % 2) && ta->ma >= goal->ci_ma - 4 * SM5440_DC_PPS_C_STEP) {
+		if (ta->ma - SM5440_DC_PPS_C_STEP >= l->ta_min_ma)
+			ta->ma -= SM5440_DC_PPS_C_STEP;
+	} else if (ta->mv > l->ta_min_mv) {
+		ta->mv -= SM5440_DC_PPS_V_STEP;
+	}
+}
+
+/* CC, DC:650-724. Stock's keepalive sends are kept: they cost nothing and
+ * the MAX77705 side renews on its own schedule as well.
+ */
+static inline void sm5440_dc_cc(const struct sm5440_dc_sample *s,
+				const struct sm5440_dc_goal *goal,
+				const struct sm5440_dc_limits *l,
+				struct sm5440_dc_ta *ta, struct sm5440_dc_ramp *r,
+				struct sm5440_dc_step *st)
+{
+	*st = (struct sm5440_dc_step){ SM5440_DC_PHASE_CC, 1, SM5440_DC_DELAY_ADC_MS, 0 };
+	if (s->loop == SM5440_DC_LOOP_VBATREG) {
+		r->cv_cnt = 0;
+		st->send = 0;
+		sm5440_dc_goto(st, SM5440_DC_PHASE_CV, SM5440_DC_DELAY_ADC_MS);
+		return;
+	}
+	if (goal->ci_ma < s->ibus_ma) {
+		sm5440_dc_cc_down(goal, l, ta, r);
+		return;
+	}
+	if (s->ibus_ma >= goal->ci_ma - SM5440_DC_CC_IBUS_OFFSET || r->cc_limit) {
+		st->delay_ms = SM5440_DC_DELAY_LOOP_MS;
+		return;
+	}
+	if (sm5440_dc_cc_up(goal, l, ta, r))
+		st->delay_ms = SM5440_DC_DELAY_LOOP_MS;
+}
+
+/* CV, DC:726-795. DONE is ours: stock's top-off only fires when the target
+ * is the 4380 mV float, which a pilot below it never reaches, so a pilot
+ * session ends after topoff_count consecutive samples under topoff_ma.
+ */
+static inline void sm5440_dc_cv(const struct sm5440_dc_sample *s,
+				const struct sm5440_dc_goal *goal,
+				const struct sm5440_dc_limits *l,
+				struct sm5440_dc_ta *ta, struct sm5440_dc_ramp *r,
+				struct sm5440_dc_step *st)
+{
+	*st = (struct sm5440_dc_step){ SM5440_DC_PHASE_CV, 0, SM5440_DC_DELAY_LOOP_MS, 0 };
+	if (r->cv_cnt == 0 && (s->loop & SM5440_DC_LOOP_VBATREG))
+		r->cv_cnt = 1;
+	else if (r->cv_cnt == 1 && s->loop == SM5440_DC_LOOP_INACTIVE)
+		r->cv_cnt = 2;
+
+	if (s->loop & SM5440_DC_LOOP_VBATREG) {
+		ta->mv = sm5440_dc_clamp_mv(l, ta->mv - (r->cv_cnt == 1 ?
+				2 * SM5440_DC_PPS_V_STEP : SM5440_DC_PPS_V_STEP));
+		st->send = 1;
+		st->delay_ms = SM5440_DC_DELAY_PPS_MS;
+	} else if (s->loop & SM5440_DC_LOOP_THEMREG) {
+		st->send = 1;
+		st->delay_ms = SM5440_DC_DELAY_PPS_MS;
+	}
+	if (s->vbat_mv < goal->cv_mv - 100 || (s->loop & SM5440_DC_LOOP_IBUSLIM)) {
+		r->steps = 0;
+		r->stalled = 0;
+		sm5440_dc_goto(st, SM5440_DC_PHASE_PRE_CC, SM5440_DC_DELAY_ADC_MS);
+		return;
+	}
+	if (s->ibus_ma < l->topoff_ma) {
+		if (++r->topoff >= l->topoff_count) {
+			st->phase = SM5440_DC_PHASE_DONE;
+			st->reason = SM5440_DC_STOP_DONE;
+			st->send = 0;
+			return;
+		}
+	} else {
+		r->topoff = 0;
+	}
+	if (s->loop == SM5440_DC_LOOP_INACTIVE)
+		st->send = 1;
+}
+
+static inline void sm5440_dc_run(int phase, const struct sm5440_dc_sample *s,
+				 const struct sm5440_dc_goal *goal,
+				 const struct sm5440_dc_limits *l,
+				 struct sm5440_dc_ta *ta, struct sm5440_dc_ramp *r,
+				 struct sm5440_dc_step *st)
+{
+	switch (phase) {
+	case SM5440_DC_PHASE_PRE_CC:
+		sm5440_dc_pre_cc(s, goal, l, ta, r, st);
+		break;
+	case SM5440_DC_PHASE_CC:
+		sm5440_dc_cc(s, goal, l, ta, r, st);
+		break;
+	case SM5440_DC_PHASE_CV:
+		sm5440_dc_cv(s, goal, l, ta, r, st);
+		break;
+	default:
+		*st = (struct sm5440_dc_step){ SM5440_DC_PHASE_FAIL, 0, 0,
+					       SM5440_DC_ERR_FAIL_ADJUST };
+		return;
+	}
+	/* Nothing may leave this file outside the envelope. */
+	ta->mv = sm5440_dc_clamp_mv(l, ta->mv);
+	ta->ma = sm5440_dc_clamp_ma(l, ta->ma);
+}
+
+/* Everything checked before the MAX77705 is asked to yield. */
+struct sm5440_dc_entry {
+	int vbat_mv;		/* SM5440 fresh off-mode ADC */
+	int gauge_vbat_mv;	/* fuel gauge, 0 if unavailable */
+	int ntc;
+	int die;
+	unsigned int op_mode;
+	int cutoff;		/* any latched or live cut-off fault */
+	int vbus_present;
+	int source_online;	/* max77705_usb ONLINE */
+	int policy_good;	/* max77705_usb HEALTH == GOOD */
+	int fault_latched;	/* an earlier session failed */
+};
+
+static inline int sm5440_dc_entry_check(const struct sm5440_dc_entry *e,
+					const struct sm5440_dc_goal *goal,
+					const struct sm5440_dc_limits *l)
+{
+	int diff;
+
+	if (e->fault_latched)
+		return SM5440_DC_ERR_LATCHED;
+	if (e->op_mode != 0)
+		return SM5440_DC_ERR_MODE;
+	if (e->cutoff)
+		return SM5440_DC_ERR_CUTOFF;
+	if (!e->vbus_present || !e->source_online)
+		return SM5440_DC_ERR_SOURCE;
+	if (!e->policy_good)
+		return SM5440_DC_ERR_THERMAL_POLICY;
+	if (e->vbat_mv <= l->vbat_floor_mv || e->vbat_mv < l->vbat_entry_min_mv)
+		return SM5440_DC_ERR_VBAT_LOW;
+	if (e->vbat_mv > l->vbat_entry_max_mv)
+		return SM5440_DC_ERR_VBAT_HIGH;
+	if (e->vbat_mv > goal->cv_mv + 20)
+		return SM5440_DC_ERR_VBAT_ABOVE_TARGET;
+	diff = e->vbat_mv - e->gauge_vbat_mv;
+	if (!e->gauge_vbat_mv || diff > l->vbat_gauge_tol_mv || -diff > l->vbat_gauge_tol_mv)
+		return SM5440_DC_ERR_VBAT_MISMATCH;
+	if (e->ntc >= l->ntc_entry_max)
+		return SM5440_DC_ERR_NTC;
+	if (e->die >= l->die_entry_max)
+		return SM5440_DC_ERR_DIE;
+	return 0;
+}
+
+/* Entry step 4: the source must have actually moved, and not past the cap,
+ * before the pump is allowed near it. Returns 0, or the reason to keep
+ * waiting (VBUS_LOW) or abort (VBUS_HIGH).
+ */
+static inline int sm5440_dc_vbus_check(int vbus_mv, int vbat_mv, int request_mv,
+				       const struct sm5440_dc_limits *l)
+{
+	if (vbus_mv > request_mv + l->vbus_overshoot_mv ||
+	    vbus_mv > sm5440_dc_ceiling_mv(l) + l->vbus_overshoot_mv)
+		return SM5440_DC_ERR_VBUS_HIGH;
+	if (vbus_mv < 2 * vbat_mv + 200 || vbus_mv < request_mv - 300)
+		return SM5440_DC_ERR_VBUS_LOW;
+	return 0;
+}
+
+/* Guards evaluated on every pump-on sample, before any ramp decision. */
+static inline int sm5440_dc_guard(const struct sm5440_dc_sample *s,
+				  const struct sm5440_dc_goal *goal,
+				  const struct sm5440_dc_limits *l)
+{
+	if (s->vbat_mv <= l->vbat_floor_mv)
+		return SM5440_DC_ERR_VBAT_LOW;
+	if (s->vbat_mv > goal->cv_mv + 50)
+		return SM5440_DC_ERR_VBAT_OVER;
+	if (s->vbus_mv > sm5440_dc_ceiling_mv(l) + l->vbus_overshoot_mv)
+		return SM5440_DC_ERR_VBUS_HIGH;
+	if (s->ibus_ma > sm5440_dc_ibuslim_ma(goal->ci_ma) + l->ibus_trip_margin_ma)
+		return SM5440_DC_ERR_OCP;
+	if (s->ntc >= l->ntc_trip)
+		return SM5440_DC_ERR_NTC;
+	if (s->die >= l->die_trip)
+		return SM5440_DC_ERR_DIE;
+	return 0;
+}
+
+/* Ordered teardown. The sequencer only moves forward when the step's
+ * postcondition has been observed, so the ordering is a property of this
+ * function and can be tested without hardware:
+ *   pump off -> watchdog off -> input at base -> fixed 5 V requested ->
+ *   fixed 5 V confirmed (contract and SM5440 VBUS) -> lease released.
+ * The fixed request is never issued before the pump is confirmed off, and
+ * the lease is never released before 5 V is confirmed. If 5 V cannot be
+ * confirmed the caller abandons the lease instead of releasing it, and the
+ * MAX77705 expiry is the backstop.
+ */
+enum sm5440_dc_td {
+	SM5440_DC_TD_PUMP_OFF,
+	SM5440_DC_TD_WDT_OFF,
+	SM5440_DC_TD_INPUT_BASE,
+	SM5440_DC_TD_FIXED_REQUEST,
+	SM5440_DC_TD_FIXED_VERIFY,
+	SM5440_DC_TD_RELEASE,
+	SM5440_DC_TD_DONE,
+	SM5440_DC_TD_ABANDON,
+};
+
+struct sm5440_dc_td_obs {
+	int pump_off;		/* CNTL5 op mode read back != CHG_ON */
+	int wdt_off;		/* CNTL1 bit7 read back clear */
+	int input_ma;		/* max77705_usb INPUT_CURRENT_LIMIT, -1 unknown */
+	int elevated;		/* a PPS request was issued this session */
+	int fixed_sent;		/* the fixed request was accepted */
+	int contract_fixed;	/* max77705_usb reports a settled fixed 5 V */
+	int vbus_mv;		/* SM5440 off-mode VBUS, -1 unknown */
+	int source_gone;	/* no VBUS and no attached source */
+	int timed_out;		/* this step exceeded its budget */
+};
+
+/* Whether the current step's own action (disarming, the fixed request,
+ * the release) may run in this pass: never without a confirmed-off pump.
+ */
+static inline int sm5440_dc_td_may_act(int step, const struct sm5440_dc_td_obs *o)
+{
+	return step == SM5440_DC_TD_PUMP_OFF || o->pump_off;
+}
+
+static inline int sm5440_dc_td_next(int step, const struct sm5440_dc_td_obs *o)
+{
+	switch (step) {
+	case SM5440_DC_TD_PUMP_OFF:
+		/* No timeout exit: never change the voltage with the pump on. */
+		return o->pump_off ? SM5440_DC_TD_WDT_OFF : step;
+	case SM5440_DC_TD_WDT_OFF:
+		if (!o->pump_off)
+			return SM5440_DC_TD_PUMP_OFF;
+		return o->wdt_off || o->timed_out ? SM5440_DC_TD_INPUT_BASE : step;
+	case SM5440_DC_TD_INPUT_BASE:
+		if (!o->pump_off)
+			return SM5440_DC_TD_PUMP_OFF;
+		if (!o->elevated || o->source_gone)
+			return SM5440_DC_TD_FIXED_VERIFY;
+		if (o->input_ma >= 0 && o->input_ma <= 500)
+			return SM5440_DC_TD_FIXED_REQUEST;
+		return o->timed_out ? SM5440_DC_TD_ABANDON : step;
+	case SM5440_DC_TD_FIXED_REQUEST:
+		if (!o->pump_off)
+			return SM5440_DC_TD_PUMP_OFF;
+		if (o->source_gone || o->fixed_sent)
+			return SM5440_DC_TD_FIXED_VERIFY;
+		return o->timed_out ? SM5440_DC_TD_ABANDON : step;
+	case SM5440_DC_TD_FIXED_VERIFY:
+		if (!o->pump_off)
+			return SM5440_DC_TD_PUMP_OFF;
+		if (o->source_gone)
+			return SM5440_DC_TD_RELEASE;
+		if (o->contract_fixed && o->vbus_mv >= 4000 && o->vbus_mv <= 5600)
+			return SM5440_DC_TD_RELEASE;
+		return o->timed_out ? SM5440_DC_TD_ABANDON : step;
+	case SM5440_DC_TD_RELEASE:
+		return SM5440_DC_TD_DONE;
+	default:
+		return step;
+	}
+}
+
+#endif
--- /dev/null
+++ b/drivers/power/supply/sm5440-protection.h
@@ -0,0 +1,213 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* SM5440 fault, software-OCP and watchdog decoding for SM-X700.
+ *
+ * Bit meanings follow Samsung/Silicon Mitus' GPL sm5440_charger.{c,h}. On this
+ * chip STATUS1..4 (0x08..0x0b) mirror the bit layout of the read-clear
+ * INT1..4 (0x00..0x03), so one decoder serves both: INT gives latched events,
+ * STATUS gives the live condition.
+ *
+ * X700's stock sm5440@63 node carries only compatible/reg -- no
+ * "sm5440,irq-gpio" -- so stock never requests an interrupt for this chip and
+ * nothing else on the AP side consumes INT1..4. Polled read-clear ownership by
+ * a single driver is therefore safe here. Verify that again on any other board.
+ *
+ * Pure helpers only: no I2C, no policy. The caller decides what a fault does.
+ */
+#ifndef SM5440_PROTECTION_H
+#define SM5440_PROTECTION_H
+
+/* INT1/STATUS1 */
+#define SM5440_B1_VOUTOVP	0x10
+#define SM5440_B1_VBATOVP	0x08
+#define SM5440_B1_REVBPOCP	0x02
+#define SM5440_B1_REVBSTOCP	0x01
+/* INT2/STATUS2 */
+#define SM5440_B2_IBUSLIM	0x80
+#define SM5440_B2_VOUTOVP_ALM	0x10
+#define SM5440_B2_VBATREG	0x08
+#define SM5440_B2_THEM_REG	0x02
+#define SM5440_B2_THEM		0x01
+/* INT3/STATUS3 */
+#define SM5440_B3_VBUSOVP	0x80
+#define SM5440_B3_VBUSUVLO	0x40
+#define SM5440_B3_VBUSPOK	0x20
+#define SM5440_B3_THEMSHDN_ALM	0x10
+#define SM5440_B3_THEMSHDN	0x08
+#define SM5440_B3_STUP_FAIL	0x04
+#define SM5440_B3_REVBLK	0x02
+#define SM5440_B3_CFLY_SHORT	0x01
+/* INT4/STATUS4 */
+#define SM5440_B4_RVSBSTRDY	0x40
+#define SM5440_B4_MIDVBUS2VOUT	0x20
+#define SM5440_B4_SW_RDY	0x10
+#define SM5440_B4_WDTMROFF	0x04
+#define SM5440_B4_CHGTMROFF	0x02
+#define SM5440_B4_ADCUPDATED	0x01
+
+/* Decoded conditions, in this driver's own namespace. */
+#define SM5440_FAULT_VBATOVP	0x00000001
+#define SM5440_FAULT_VOUTOVP	0x00000002
+#define SM5440_FAULT_VBUSOVP	0x00000004
+#define SM5440_FAULT_THEMSHDN	0x00000008
+#define SM5440_FAULT_STUP_FAIL	0x00000010
+#define SM5440_FAULT_CFLY_SHORT	0x00000020
+#define SM5440_FAULT_REVBLK	0x00000040
+#define SM5440_FAULT_WDT	0x00000080
+#define SM5440_FAULT_IBUSOCP	0x00000100
+#define SM5440_ALARM_VOUTOVP	0x00001000
+#define SM5440_ALARM_THEMSHDN	0x00002000
+#define SM5440_ALARM_THEM_REG	0x00004000
+#define SM5440_ALARM_IBUSLIM	0x00008000
+#define SM5440_ALARM_THEM	0x00010000
+#define SM5440_EVENT_VBUSUVLO	0x00100000
+#define SM5440_EVENT_VBUSPOK	0x00200000
+#define SM5440_EVENT_VBATREG	0x00400000
+#define SM5440_EVENT_CHGTMROFF	0x00800000
+#define SM5440_EVENT_ADCUPDATED	0x01000000
+#define SM5440_EVENT_SW_RDY	0x02000000
+#define SM5440_EVENT_REVBSTOCP	0x04000000
+#define SM5440_EVENT_REVBPOCP	0x08000000
+
+/* Stock only treats these as a forced cut-off when its state machine was past
+ * PRESET and the chip had dropped itself to CHG_OFF; outside a charging
+ * session the same bits are ordinary steady-state readings. Measured on X700
+ * with VBUS present and the pump idle: INT3=0x62, STATUS3=0x22, i.e. REVBLK
+ * is permanently asserted. Judging these bits without the charging gate
+ * declares a healthy tablet faulty. SM5440's hardware IBUS OCP is disabled by
+ * stock register init, so IBUSOCP is only ever set by the software check below.
+ */
+#define SM5440_FAULT_CHARGING (SM5440_FAULT_VBATOVP | SM5440_FAULT_VOUTOVP | \
+	SM5440_FAULT_VBUSOVP | SM5440_FAULT_STUP_FAIL | SM5440_FAULT_CFLY_SHORT | \
+	SM5440_FAULT_REVBLK | SM5440_FAULT_WDT | SM5440_FAULT_IBUSOCP)
+/* A die thermal shutdown is real in any mode. */
+#define SM5440_FAULT_ALWAYS SM5440_FAULT_THEMSHDN
+#define SM5440_FAULT_CUTOFF (SM5440_FAULT_CHARGING | SM5440_FAULT_ALWAYS)
+
+/* session is true while this driver has, or expects to have, the pump on.
+ * Stock classifies a forced cut-off only once the chip has already dropped
+ * itself to CHG_OFF inside a session (sm5440_irq_thread: state > PRESET and
+ * op_mode == 0). While the pump is still running, REVBLK is a steady-state
+ * reading (see above) and must not stop it; every other cut-off condition,
+ * and the software OCP that replaces the disabled hardware one, still does.
+ */
+#define SM5440_FAULT_RUNNING (SM5440_FAULT_CUTOFF & ~SM5440_FAULT_REVBLK)
+
+static inline unsigned int sm5440_cutoff_faults(unsigned int flags, int session,
+						unsigned int op_mode)
+{
+	if (!session)
+		return flags & SM5440_FAULT_ALWAYS;
+	if (op_mode == 1)	/* SM5440_OP_MODE_CHG_ON */
+		return flags & SM5440_FAULT_RUNNING;
+	return flags & SM5440_FAULT_CUTOFF;
+}
+#define SM5440_ALARM_ANY (SM5440_ALARM_VOUTOVP | SM5440_ALARM_THEMSHDN | \
+	SM5440_ALARM_THEM_REG | SM5440_ALARM_IBUSLIM | SM5440_ALARM_THEM)
+
+/* regs[] is INT1..INT4 or STATUS1..STATUS4, in register order. */
+static inline unsigned int sm5440_decode_flags(const unsigned char regs[4])
+{
+	unsigned int flags = 0;
+
+	if (regs[0] & SM5440_B1_VBATOVP)
+		flags |= SM5440_FAULT_VBATOVP;
+	if (regs[0] & SM5440_B1_VOUTOVP)
+		flags |= SM5440_FAULT_VOUTOVP;
+	if (regs[0] & SM5440_B1_REVBSTOCP)
+		flags |= SM5440_EVENT_REVBSTOCP;
+	if (regs[0] & SM5440_B1_REVBPOCP)
+		flags |= SM5440_EVENT_REVBPOCP;
+	if (regs[1] & SM5440_B2_IBUSLIM)
+		flags |= SM5440_ALARM_IBUSLIM;
+	if (regs[1] & SM5440_B2_VOUTOVP_ALM)
+		flags |= SM5440_ALARM_VOUTOVP;
+	if (regs[1] & SM5440_B2_VBATREG)
+		flags |= SM5440_EVENT_VBATREG;
+	if (regs[1] & SM5440_B2_THEM_REG)
+		flags |= SM5440_ALARM_THEM_REG;
+	if (regs[1] & SM5440_B2_THEM)
+		flags |= SM5440_ALARM_THEM;
+	if (regs[2] & SM5440_B3_VBUSOVP)
+		flags |= SM5440_FAULT_VBUSOVP;
+	if (regs[2] & SM5440_B3_VBUSUVLO)
+		flags |= SM5440_EVENT_VBUSUVLO;
+	if (regs[2] & SM5440_B3_VBUSPOK)
+		flags |= SM5440_EVENT_VBUSPOK;
+	if (regs[2] & SM5440_B3_THEMSHDN_ALM)
+		flags |= SM5440_ALARM_THEMSHDN;
+	if (regs[2] & SM5440_B3_THEMSHDN)
+		flags |= SM5440_FAULT_THEMSHDN;
+	if (regs[2] & SM5440_B3_STUP_FAIL)
+		flags |= SM5440_FAULT_STUP_FAIL;
+	if (regs[2] & SM5440_B3_REVBLK)
+		flags |= SM5440_FAULT_REVBLK;
+	if (regs[2] & SM5440_B3_CFLY_SHORT)
+		flags |= SM5440_FAULT_CFLY_SHORT;
+	if (regs[3] & SM5440_B4_WDTMROFF)
+		flags |= SM5440_FAULT_WDT;
+	if (regs[3] & SM5440_B4_CHGTMROFF)
+		flags |= SM5440_EVENT_CHGTMROFF;
+	if (regs[3] & SM5440_B4_ADCUPDATED)
+		flags |= SM5440_EVENT_ADCUPDATED;
+	if (regs[3] & SM5440_B4_SW_RDY)
+		flags |= SM5440_EVENT_SW_RDY;
+	return flags;
+}
+
+/* Reverse-boost OCP is only meaningful while the chip runs a reverse mode;
+ * in CHG_OFF/CHG_ON it is stale from an earlier OTG session.
+ */
+static inline unsigned int sm5440_filter_reverse(unsigned int flags, unsigned int op_mode)
+{
+	return op_mode >= 2 ? flags :
+		flags & ~(SM5440_EVENT_REVBSTOCP | SM5440_EVENT_REVBPOCP);
+}
+
+/* Stock sm5440_ocp_check_work: IBUSLIM regulation on its own is normal current
+ * limiting, so Samsung only calls software OCP when IBUSLIM and the thermal
+ * shutdown alarm are live together, three samples about a second apart.
+ * need_to_sw_ocp=1 in stock: this path replaces hardware OCP, which stock
+ * register init explicitly disables. Do not raise direct-charge current
+ * without it.
+ */
+static inline int sm5440_sw_ocp_strike(unsigned char status2, unsigned char status3)
+{
+	return (status2 & SM5440_B2_IBUSLIM) && (status3 & SM5440_B3_THEMSHDN_ALM);
+}
+
+#define SM5440_SW_OCP_STRIKES 3
+
+/* CNTL1: bit7 WDT enable, bits6:4 WDT timer, bit0 SW reset. Never write bit0. */
+#define SM5440_WDT_TIMER_0P5S	0
+#define SM5440_WDT_TIMER_1S	1
+#define SM5440_WDT_TIMER_2S	2
+#define SM5440_WDT_TIMER_4S	3
+#define SM5440_WDT_TIMER_30S	4
+#define SM5440_WDT_TIMER_60S	5
+#define SM5440_WDT_TIMER_90S	6
+#define SM5440_WDT_TIMER_120S	7
+
+static inline unsigned char sm5440_cntl1_wdt(unsigned char old, int enable,
+					     unsigned char timer)
+{
+	return (old & 0x0e) | (enable ? 0x80 : 0) | ((timer & 7) << 4);
+}
+
+static inline unsigned int sm5440_wdt_timer_ms(unsigned char timer)
+{
+	static const unsigned int ms[8] = { 500, 1000, 2000, 4000, 30000, 60000, 90000, 120000 };
+
+	return ms[timer & 7];
+}
+
+/* CNTL5 bits3:2 select the operating mode. */
+#define SM5440_OP_MODE_CHG_OFF		0
+#define SM5440_OP_MODE_CHG_ON		1
+#define SM5440_OP_MODE_REV_BYPASS	2
+#define SM5440_OP_MODE_REV_BOOST	3
+
+static inline unsigned int sm5440_op_mode(unsigned char cntl5)
+{
+	return (cntl5 >> 2) & 3;
+}
+#endif
