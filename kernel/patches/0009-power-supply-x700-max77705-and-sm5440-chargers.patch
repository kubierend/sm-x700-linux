+/* ADC7 calibrated raw, SCALE_HW_CALIB_DEFAULT and 1:1 prescale.
+ * Returns false on invalid code or an open/short/out-of-table sensor.
+ */
+static inline int gts8_ntc_temperature_uv(const struct gts8_ntc_point *table,
+                                         unsigned int count, int uv, int *temp)
+{
+	unsigned int i;
+	if (count < 2 || uv < table[0].uv || uv > table[count - 1].uv)
+		return 0;
+	for (i = 1; i < count; i++) {
+		if (uv <= table[i].uv) {
+			*temp = table[i - 1].temp +
+				(long long)(table[i].temp - table[i - 1].temp) *
+				(uv - table[i - 1].uv) / (table[i].uv - table[i - 1].uv);
+			return 1;
+		}
+	}
+	return 0;
+}
+
+static inline int gts8_ntc_temperature(const struct gts8_ntc_point *table,
+                                     unsigned int count, int raw, int *temp)
+{
+	if (raw < 0 || raw > 0x7fff)
+		return 0;
+	return gts8_ntc_temperature_uv(table, count,
+				      (long long)raw * 1875000 / 0x70e4, temp);
+}
+
+/* Pilot policy: use only Android's normal battery band (15..42 C).
+ * Pause outside it, recover 2 C inside it. More restrictive than Android's
+ * warm/cool profiles until their voltage and current transitions are tested.
+ * Charger uses Android's 80 C cutoff / 77 C recovery. Blanket 50/48 C is
+ * an additional conservative guard for this pilot, not Android's LRP model.
+ */
+static inline int gts8_normal_temperature(int paused, int battery,
+                                         int blanket, int charger)
+{
+	if (paused)
+		return battery >= 170 && battery < 400 &&
+		       blanket < 480 && charger < 770;
+	return battery >= 150 && battery < 420 &&
+	       blanket < 500 && charger < 800;
+}
+#endif
