-	    irq_type >= ARRAY_SIZE(nvt_ts_irq_type) ||
-	    data->buf[NVT_TS_PARAMS_WAKE_TYPE] != chip->wake_type ||
-	    data->buf[NVT_TS_PARAMS_CHIP_ID] != chip->chip_id) {
-		dev_err(dev, "Unsupported touchscreen parameters: %*ph\n",
-			NVT_TS_PARAMS_SIZE, data->buf);
-		return -EIO;
+	if (chip->sec_fw) {
+		dev_info(dev, "touchscreen parameters: %*ph\n",
+			 NVT_TS_PARAMS_SIZE, data->buf);
+
+		/* buf[0] is the firmware version, buf[1] its complement */
+		if ((u8)(data->buf[0] + data->buf[1]) != 0xff ||
+		    !width || width > NVT_TS_MAX_SIZE ||
+		    !height || height >= NVT_TS_MAX_SIZE) {
+			dev_err(dev, "Firmware info is broken\n");
