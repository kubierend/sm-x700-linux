@@ -41,6 +41,13 @@
 #define NVT_TS_TOUCH_UPDATE		2
 #define NVT_TS_TOUCH_RELEASE		3
 
+/* Samsung NT36523 firmware: these mean "down", a lift drops the slot */
+#define NVT_TS_SEC_TOUCH_FINGER		0
+#define NVT_TS_SEC_TOUCH_GLOVE		3
+#define NVT_TS_SEC_TOUCH_PALM		5
+
+#define NVT_TS_SET_PAGE			0xff
+
 static const int nvt_ts_irq_type[4] = {
 	IRQF_TRIGGER_RISING,
 	IRQF_TRIGGER_FALLING,
@@ -51,10 +58,19 @@
 struct nvt_ts_i2c_chip_data {
 	u8 wake_type;
 	u8 chip_id;
+	/* If non-zero, select this memory page before every read */
+	u32 event_buf_addr;
+	/*
+	 * Samsung firmware: wake_type/chip_id are unknown and not checked
+	 * (fw_ver and its complement are checked instead), the IRQ trigger
+	 * comes from the DT and touch states use the NVT_TS_SEC_* values.
+	 */
+	bool sec_fw;
 };
 
 struct nvt_ts_data {
 	struct i2c_client *client;
+	const struct nvt_ts_i2c_chip_data *chip;
 	struct input_dev *input;
 	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data regulators[2];
@@ -89,14 +105,38 @@
 	return 0;
 }
 
+static int nvt_ts_set_page(struct nvt_ts_data *data)
+{
+	u32 addr = data->chip->event_buf_addr;
+	u8 buf[3] = { NVT_TS_SET_PAGE, addr >> 16, addr >> 8 };
+	int ret;
+
+	if (!addr)
+		return 0;
+
+	ret = i2c_master_send(data->client, buf, sizeof(buf));
+	if (ret != sizeof(buf)) {
+		dev_err(&data->client->dev, "Error selecting page 0x%05x: %d\n",
+			addr, ret);
+		return (ret < 0) ? ret : -EIO;
+	}
+
+	return 0;
+}
+
 static irqreturn_t nvt_ts_irq(int irq, void *dev_id)
 {
 	struct nvt_ts_data *data = dev_id;
 	struct device *dev = &data->client->dev;
-	int i, error, slot, x, y;
+	int i, error, slot, type, x, y;
 	bool active;
 	u8 *touch;
 
+	/* The page is lost whenever the panel (and so the TDDI) resets */
+	error = nvt_ts_set_page(data);
+	if (error)
+		return IRQ_HANDLED;
+
 	error = nvt_ts_read_data(data->client, NVT_TS_TOUCH_START, data->buf,
 				 data->max_touches * NVT_TS_TOUCH_SIZE);
 	if (error)
@@ -110,21 +150,31 @@
 
 		slot = touch[0] >> NVT_TS_TOUCH_SLOT_SHIFT;
 		if (slot < 1 || slot > data->max_touches) {
-			dev_warn(dev, "slot %d out of range, ignoring\n", slot);
+			/* Samsung firmware leaves unused entries zeroed */
+			if (!data->chip->sec_fw)
+				dev_warn(dev, "slot %d out of range, ignoring\n", slot);
 			continue;
 		}
 
-		switch (touch[0] & NVT_TS_TOUCH_TYPE_MASK) {
-		case NVT_TS_TOUCH_NEW:
-		case NVT_TS_TOUCH_UPDATE:
-			active = true;
-			break;
-		case NVT_TS_TOUCH_RELEASE:
-			active = false;
-			break;
-		default:
-			dev_warn(dev, "slot %d unknown state %d\n", slot, touch[0] & 7);
-			continue;
+		type = touch[0] & NVT_TS_TOUCH_TYPE_MASK;
+		if (data->chip->sec_fw) {
+			/* A lift is reported by dropping the slot */
+			active = type == NVT_TS_SEC_TOUCH_FINGER ||
+				 type == NVT_TS_SEC_TOUCH_GLOVE ||
+				 type == NVT_TS_SEC_TOUCH_PALM;
+		} else {
+			switch (type) {
+			case NVT_TS_TOUCH_NEW:
+			case NVT_TS_TOUCH_UPDATE:
+				active = true;
+				break;
+			case NVT_TS_TOUCH_RELEASE:
+				active = false;
+				break;
+			default:
+				dev_warn(dev, "slot %d unknown state %d\n", slot, type);
+				continue;
+			}
 		}
 
 		slot--;
@@ -197,7 +247,7 @@
