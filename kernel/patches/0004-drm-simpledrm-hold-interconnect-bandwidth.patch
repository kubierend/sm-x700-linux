 		&format->format, width, height, stride);
 
+	/* Needs sdev->mode and sdev->pitch to size the bandwidth request. */
+	ret = simpledrm_device_init_interconnects(sdev);
+	if (ret)
+		return ERR_PTR(ret);
+
