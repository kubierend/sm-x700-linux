+/*
+ * The model selects the AudioReach topology
+ * qcom/sm8450/Samsung-Galaxy-Tab-S8-tplg.bin: the SM8450-HDK topology with
+ * the I2S data line switched from SD0 to SD1 (gpio128/data1 carries the
+ * speaker data), see boot/tools/mk-tplg.py.
+ */
+&sound {
+	compatible = "qcom,sm8450-sndcard";
+	model = "Samsung-Galaxy-Tab-S8";
+	pinctrl-names = "default";
+	pinctrl-0 = <&pri_mi2s_active>;
+
+	speaker-playback-dai-link {
+		link-name = "CS35L45 Speaker Playback";
