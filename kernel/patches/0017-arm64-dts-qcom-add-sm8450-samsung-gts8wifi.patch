+/* SM5440 direct (charge-pump) charger. */
+&i2c1 {
+	status = "okay";
+
+	sm5440: charger@63 {
+		compatible = "siliconmitus,sm5440";
+		reg = <0x63>;
+	};
+};
+
+/*
+ * Battery, blanket and charger NTCs. Raw codes are exported for Samsung's
+ * NTC tables; the generic processed temperatures are not used.
+ */
+&pmk8350_vadc {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&charger_ntc_default>;
+
+	battery-thermistor@145 {
+		reg = <0x145>;
+		label = "battery_ntc";
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+	};
+
+	blanket-thermistor@146 {
+		reg = <0x146>;
+		label = "blanket_ntc";
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+	};
+
+	charger-thermistor@148 {
+		reg = <0x148>;
+		label = "charger_ntc";
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+	};
+};
+
+&pm8350_gpios {
+	/* Stock key_vol_up_default: input, pull-up, 1.8 V. */
+	key_vol_up_default: key-vol-up-default-state {
+		pins = "gpio6";
+		function = "normal";
+		input-enable;
+		bias-pull-up;
+		power-source = <1>;
+	};
+
+	charger_ntc_default: charger-ntc-state {
+		pins = "gpio1";
+		function = "normal";
+		bias-high-impedance;
+	};
+};
