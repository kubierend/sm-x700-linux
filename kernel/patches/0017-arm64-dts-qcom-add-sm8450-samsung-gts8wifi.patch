+		compatible = "samsung,gts8-csot-nt36523";
+		reg = <0>;
+
+		vddio-supply = <&panel_ldo>;
+		/*
+		 * Samsung drives an active-high "panel_reset" regulator 1/0/1;
+		 * nt36523_reset() makes the same waveform from an active-low
+		 * GPIO.
