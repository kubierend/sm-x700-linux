drm/msm/dsi: don't re-arm the error irq by default

--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -85,6 +85,24 @@
 	}
 }
 
+/*
+ * Bring-up switch. dsi_error() masks the error interrupt and schedules
+ * err_work, and err_work re-arms it; if the error condition is still present
+ * that is a self-sustaining loop. On the SM-X700 an unresolved FIFO error
+ * (DSI_ERR_STATE_FIFO) re-armed at roughly 55k interrupts/second, which
+ * starved the CPU badly enough that UFS reads timed out with DID_ERROR and
+ * the initramfs could not mount the root partition at all -- a display
+ * problem presenting as unbootable storage.
+ *
+ * With this false (the default) the first error is still reported and then
+ * the interrupt stays masked, so a misconfigured link degrades to a bad
+ * picture instead of an unbootable system. Writable at runtime via
+ * /sys/module/msm/parameters/dsi_err_rearm to re-arm while debugging.
+ */
+static bool dsi_err_rearm;
+MODULE_PARM_DESC(dsi_err_rearm, "Re-arm the DSI error interrupt after each error (default false)");
+module_param(dsi_err_rearm, bool, 0600);
+
 #define DSI_ERR_STATE_ACK			0x0000
 #define DSI_ERR_STATE_TIMEOUT			0x0001
 #define DSI_ERR_STATE_DLN0_PHY			0x0002
@@ -1590,7 +1608,8 @@
 	msm_host->err_work_state = 0;
 
 	/* enable dsi error interrupt */
-	dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_ERROR, 1);
+	if (dsi_err_rearm)
+		dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_ERROR, 1);
 }
 
 static void dsi_ack_err_status(struct msm_dsi_host *msm_host)
